# ----------------------------------------------------------------------
# Token Usage & Cost Metrics
# ----------------------------------------------------------------------

metrics_lock = threading.Lock()

def calculate_token_cost(model: str, input_tokens: int, output_tokens: int,
                         cached_tokens: int = 0, thought_tokens: int = 0) -> Tuple[float, float]:
    """Calculate equivalent commercial cost in USD and CNY (with cache discount & thinking tokens)."""
    m = (model or "").lower()
    if "opus" in m:
        in_p, cache_p, out_p = 15.0, 1.5, 75.0
    elif "sonnet" in m:
        in_p, cache_p, out_p = 3.0, 0.3, 15.0
    elif "haiku" in m:
        in_p, cache_p, out_p = 0.8, 0.08, 4.0
    elif "flash-lite" in m or "lite" in m:
        in_p, cache_p, out_p = 0.10, 0.01, 0.40
    elif any(k in m for k in ("gemini-4", "hydrogen", "neon", "pro")):
        in_p, cache_p, out_p = 1.25, 0.125, 10.0
    else:
        # Default Gemini Flash pricing
        in_p, cache_p, out_p = 0.30, 0.03, 2.50

    cached_in = max(0, min(input_tokens, cached_tokens))
    uncached_in = max(0, input_tokens - cached_in)
    billed_out = max(0, output_tokens) + max(0, thought_tokens)
    cost_usd = (uncached_in * in_p + cached_in * cache_p + billed_out * out_p) / 1_000_000.0
    cost_cny = cost_usd * 7.20
    return cost_usd, cost_cny

def load_metrics() -> Dict[str, Any]:
    if not os.path.exists(METRICS_FILE):
        return {
            "version": 1,
            "last_updated": datetime.now(timezone.utc).isoformat(),
            "summary": {"total_requests": 0, "total_input_tokens": 0, "total_output_tokens": 0, "total_tokens": 0, "total_cost_usd": 0.0, "total_cost_cny": 0.0},
            "by_date": {},
            "by_profile": {}
        }
    try:
        with open(METRICS_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {
            "version": 1,
            "last_updated": datetime.now(timezone.utc).isoformat(),
            "summary": {"total_requests": 0, "total_input_tokens": 0, "total_output_tokens": 0, "total_tokens": 0, "total_cost_usd": 0.0, "total_cost_cny": 0.0},
            "by_date": {},
            "by_profile": {}
        }

def _agyp_log(msg: str) -> None:
    """持久化层故障直写 gateway.log + stderr（CLI 路径没有 handler 实例，没 logger 可用）。"""
    line = f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')} - [agyp-io] {msg}\n"
    try:
        _append_line(LOG_FILE, line)
    except Exception:
        pass
    try:
        sys.stderr.write(line)
    except Exception:
        pass


_latency_lock = threading.Lock()


def record_latency(fields: Dict[str, Any]) -> None:
    """每跳上游请求的分段耗时落盘（JSON lines），供 tools/agyp_latency_report.py 归因。

    埋点本身绝不影响转发路径：任何异常吞掉，最坏只是少一行数据。
    """
    try:
        now = datetime.now()
        rec = {"ts": now.strftime("%Y-%m-%d %H:%M:%S.") + f"{now.microsecond // 1000:03d}"}
        rec.update(fields)
        line = json.dumps(rec, ensure_ascii=False, separators=(",", ":")) + "\n"
        with _latency_lock:
            _append_line(LATENCY_FILE, line)
    except Exception:
        pass


# ----------------------------------------------------------------------
# [2026-10-26] 日志轮转
# ----------------------------------------------------------------------

_rotate_lock = threading.Lock()
_write_counter = collections.Counter()
_last_size_check = 0.0        # monotonic 时刻；0 = 本进程还没查过体积（R26）


def _reopen_daemon_stderr() -> None:
    """把常驻进程自己的 fd 1/2 重新指回 LOG_FILE。

    守护进程启动时是 `open(LOG_FILE,"a")` 之后把同一个 fd 交给子进程的 stdout/stderr，
    而轮转只是 `os.replace` **改名**、不动 fd ⇒ 一旦 gateway.log 越过上限，
    之后所有走 stderr 的输出（stdlib 的 handle_error traceback、`print(file=sys.stderr)`
    的容灾提示）会**永远写进被改名的 gateway.log.1**，新文件里只剩 `_append_line` 那部分。
    §P3 特意留下的取证就是这么丢的。实测（fork 子进程 + rename）：第二次写入落在旧 inode。
    """
    if _DAEMON_STARTED_AT is None:
        return                            # CLI 进程绝不能抢自己的 stderr（那是用户的终端）
    try:
        try:
            sys.stdout.flush()
            sys.stderr.flush()
        except Exception:
            pass
        fd = os.open(LOG_FILE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        try:
            os.dup2(fd, 1)
            os.dup2(fd, 2)
        finally:
            if fd > 2:
                os.close(fd)
    except Exception:
        pass


def _rotate_if_oversized(path: str) -> bool:
    """超过 LOG_MAX_BYTES 就右移轮转，保留 LOG_KEEP 份。异常一律吞掉（不影响转发）。"""
    try:
        if os.path.getsize(path) < LOG_MAX_BYTES:
            return False
    except Exception:
        return False
    with _rotate_lock:
        try:
            if os.path.getsize(path) < LOG_MAX_BYTES:
                return False
            for i in range(LOG_KEEP - 1, 0, -1):
                src = f"{path}.{i}"
                if os.path.exists(src):
                    os.replace(src, f"{path}.{i + 1}")
            os.replace(path, path + ".1")
            return True
        except Exception:
            return False


def _append_line(path: str, line: str) -> None:
    """行追加 + 体积检查：每 512 次写入，或距上次检查超过 1h（先到为准）。

    [2026-10-26 R26] 光靠「同进程写满 512 行」是不可靠的：计数是进程内的，重启就归零。
    实测 gateway.log 已经 80MB（LOG_MAX_BYTES=20MB），磁盘上一份 `.1` 都没有 ⇒
    这条路径在真实长跑里根本没兑现过。加一个时间维度兜底，低频写入/反复重启都能轮转。
    """
    global _last_size_check
    _write_counter[path] += 1
    now = time.monotonic()
    if _write_counter[path] % 512 == 0 or now - _last_size_check > 3600:
        _last_size_check = now
        if _rotate_if_oversized(path) and path == LOG_FILE:
            _reopen_daemon_stderr()       # 轮转只改名不改 fd，stderr 得跟过来
    with open(path, "a", encoding="utf-8") as f:
        f.write(line)


# ----------------------------------------------------------------------
# [2026-10-26] 出站 TLS 连接池（keep-alive 复用）
# ----------------------------------------------------------------------

# 全进程共用一份 SSLContext：旧实现在 failover 循环内**每请求每 attempt** 调
# ssl.create_default_context()，每次都重读一遍系统 CA 包。context 本身线程安全。
_SSL_CTX = ssl.create_default_context()


class _UpstreamConn(http.client.HTTPSConnection):
    """到上游（或到代理）的出站连接：连接阶段用短超时，建好之后立刻换回读写超时。

    `http.client` 只有一个 socket timeout，同时管 connect+send+recv。写/读需要 90s
    （实测经代理上行边际速率 ~45 KB/s，3MB 请求体要 ~70s），但 connect 不需要：
    出口不通时让它 6s 就报错，客户端不会被干等 90s 拖住。
    """

    _agyp_io_timeout: float = UPSTREAM_WRITE_TIMEOUT_SEC
    _agyp_proxy: Optional[Tuple[str, int]] = None

    def connect(self):
        self.timeout = UPSTREAM_CONNECT_TIMEOUT_SEC
        super().connect()
        if self.sock is not None:
            self.sock.settimeout(self._agyp_io_timeout)


class _PooledConn:
    __slots__ = ("conn", "last_used")

    def __init__(self, conn):
        self.conn = conn
        self.last_used = time.monotonic()


class UpstreamConnPool:
    """按 profile 复用到 Google 边缘的 HTTPS 连接。

    三条必须记住的设计约束（10-23 changelog 红线 §2/§3）：
    1. **不能按线程缓存** —— ReusableThreadingServer 是 ThreadingHTTPServer，
       每请求新线程，thread-local 池的命中率恒为 0，必须是带锁的 keyed pool。
    2. **key = profile** —— 一条 TLS 会话只承载一个账号身份，与 §九 风控取向一致。
    3. **绝不碰入站 hop-by-hop 剥离（§P1）** —— 复用只加在出站侧。
    """

    def __init__(self, max_per_key: int = UPSTREAM_POOL_MAX_PER_KEY,
                 idle_sec: float = UPSTREAM_CONN_IDLE_SEC):
        self._lock = threading.Lock()
        self._idle = collections.defaultdict(list)
        self.max_per_key = max_per_key
        self.idle_sec = idle_sec
        self.stats = collections.Counter()

    def _create(self, timeout: float, proxy: Optional[Tuple[str, int]] = None):
        # 端口从 UPSTREAM_BASE 派生（生产恒为 443，行为不变）；测试可把整套
        # UPSTREAM_HOST/PORT/_SSL_CTX 指向本地假上游，否则这条链路无法离线验证。
        # ⚠ 本机直连 Google 不通（见 UPSTREAM_CONNECT_TIMEOUT_SEC 上方那段），
        # 有代理时必须连**代理**、再用 CONNECT 隧道把 TLS 打到真实上游：
        # SNI/证书校验/Host 都仍是真实主机（stdlib 用 _tunnel_host 做这些）。
        px = _resolve_upstream_proxy() if proxy is None else proxy
        if px:
            conn = _UpstreamConn(px[0], port=px[1], timeout=timeout, context=_SSL_CTX)
            conn.set_tunnel(UPSTREAM_HOST, port=UPSTREAM_PORT)
        else:
            conn = _UpstreamConn(UPSTREAM_HOST, port=UPSTREAM_PORT,
                                 timeout=timeout, context=_SSL_CTX)
        conn._agyp_io_timeout = timeout
        conn._agyp_proxy = px
        return conn

    def acquire(self, key: str, timeout: float, force_new: bool = False):
        """取一条连接，返回 (conn, 是否命中池)。命中 = 省掉一次 TCP+TLS 握手（实测 1.5~2.6s）。"""
        px = _resolve_upstream_proxy()
        if POOL_DISABLE:
            self.stats["pool_disabled"] += 1
            return self._create(timeout, px), False
        picked = None
        create_new = False
        with self._lock:
            now = time.monotonic()
            bucket = self._idle.get(key)
            if bucket and not force_new:
                while bucket:
                    pc = bucket.pop()          # LIFO：优先用刚热的那条
                    if pc.conn._agyp_proxy != px:
                        # 代理配置变了（换节点/系统代理被关）：这条隧道不再代表当前出路
                        self.stats["proxy_changed"] += 1
                        _safe_close(pc.conn)
                        continue
                    if now - pc.last_used > self.idle_sec:
                        self.stats["aged_out"] += 1
                        _safe_close(pc.conn)
                        continue
                    picked = pc.conn
                    self.stats["hit"] += 1
                    break
            if picked is None:
                if bucket is not None and not bucket:
                    self._idle.pop(key, None)
                self.stats["miss"] += 1
                create_new = True
        # 建连（TCP + CONNECT 隧道 + TLS 握手，实测 1.5–2.6s）**必须在锁外**做：
        # 锁内建连会把不同 profile 的并发冷启动串成一条队，两个会话同时开跑时
        # 第二个要干等第一个的握手。
        if create_new:
            return self._create(timeout, px), False
        return picked, True

    def release(self, key: str, conn, healthy: bool, reusable: bool = True) -> None:
        """归还连接。healthy=False（出过错）或上游声明 will_close 时直接丢弃。

        可重入：转发路径上「成功流已 release、随后又抛异常进 except 再 release」是
        会发生的（例如收尾落账时客户端已断）。若不先把这条连接从空闲桶里摘掉就 close，
        等于往池里留一条已关闭的连接，下一个线程取到它才发现是死的。
        """
        if not healthy or not reusable or POOL_DISABLE:
            self.stats["discarded"] += 1
            with self._lock:
                bucket = self._idle.get(key)
                if bucket:
                    keep = [pc for pc in bucket if id(pc.conn) != id(conn)]
                    if len(keep) != len(bucket):
                        self.stats["deduped"] += 1
                    if keep:
                        self._idle[key] = keep
                    else:
                        self._idle.pop(key, None)
            _safe_close(conn)
            return
        with self._lock:
            bucket = self._idle[key]
            if any(id(pc.conn) == id(conn) for pc in bucket):
                return                          # 已在池里，不重复放
            if len(bucket) >= self.max_per_key:
                self.stats["overflow_closed"] += 1
                _safe_close(conn)
                return
            if getattr(conn, "sock", None) is None:
                self.stats["dead_closed"] += 1
                return
            bucket.append(_PooledConn(conn))
            self.stats["returned"] += 1

    def drop(self, key: Optional[str] = None) -> int:
        """账号切换 / cooldown / 反复失败时丢弃对应空闲连接（10-23 红线 §5 配套项）。"""
        closed = 0
        with self._lock:
            keys = [key] if key else list(self._idle.keys())
            for k in keys:
                for pc in self._idle.pop(k, []):
                    _safe_close(pc.conn)
                    closed += 1
        self.stats["dropped"] += closed
        return closed

    def snapshot(self) -> Dict[str, Any]:
        with self._lock:
            idle = {k: len(v) for k, v in self._idle.items() if v}
        s = {k: 0 for k in ("hit", "miss", "returned", "aged_out", "discarded", "deduped",
                            "dropped", "overflow_closed", "dead_closed", "pool_disabled",
                            "proxy_changed")}
        s.update(self.stats)
        s["idle_by_profile"] = idle
        # 出网靠谁：下次「上游全无响应」时，这一行就能判定是代理没接上还是别的问题
        try:
            px = _resolve_upstream_proxy()
            s["proxy"] = f"{px[0]}:{px[1]}" if px else None
            s["proxy_source"] = ("AGYP_UPSTREAM_PROXY" if (os.environ.get("AGYP_UPSTREAM_PROXY") or "").strip()
                                 else ("disabled" if UPSTREAM_PROXY_DISABLE else "env/system"))
        except Exception:
            s["proxy"] = "unknown"
        total = s["hit"] + s["miss"]
        s["hit_rate"] = round(s["hit"] / total, 4) if total else None
        return s


def _safe_close(conn) -> None:
    try:
        conn.close()
    except Exception:
        pass


_conn_pool = UpstreamConnPool()


# ----------------------------------------------------------------------
# [2026-10-26] 静态元数据响应缓存
#
# 依据：三天窗口里 listExperiments/fetchAvailableModels/loadCodeAssist/fetchUserInfo
# 这类启动期接口共 10521 次 = 全部请求量的 57%，442MB 下行，累计墙钟 5.4h。
# 它们的返回值分钟级不变，本地 TTL 命中即可，不必每次打上游。
# ----------------------------------------------------------------------

def _body_digest(req_body: Optional[bytes]) -> str:
    """缓存键里的请求体指纹：长度 + 首尾各 4KB 的 sha1 前 16 位。

    ⚠ 只按 (path, profile) 缓存是个真隐患，2026-10-26 审查挖出来的：
    `loadCodeAssist` 的 body 是恒长 38B 的 `{"cloudaicompanionProject":"<8 位>"}`
    —— **project 名就在 body 里，而且换 project 时字节数完全一样**，所以旧键会把
    A 项目的快照当成 B 项目的回答回给客户端。指纹取「长度 + 首尾」而不是整包 sha1：
    这条链路上出现过的最大 body 是 6.6MB，整包哈希要把 CPU 花在最热的转发路径上，
    而白名单里五个接口的 body 都是常量（19675 行实测每 path 只有 1–2 种长度），
    首尾足以区分。
    """
    if not req_body:
        return "-"
    h = hashlib.sha1()
    h.update(b"%d|" % len(req_body))
    h.update(req_body[:4096])
    h.update(req_body[-4096:])
    return h.hexdigest()[:16]


# 存快照与重放快照**必须用同一份**剔除清单：
#   · transfer-encoding / connection / content-length —— 逐跳头，且 CL 由我们自己按
#     实到字节重算（chunked 快照重放时靠 CL 成帧）；
#   · date / expires / age —— `send_response()` 会写一条当下的 Date，再把快照里那条
#     发一遍就是同名头两次 + 一条过期时刻的谎（R19）；
#   · set-cookie —— 快照里的 cookie 属于抓取它的那一刻/那一个账号，不能无限重放（R24）。
_CACHE_SKIP_HEADERS = ("transfer-encoding", "connection", "content-length",
                       "date", "expires", "age", "set-cookie")


class _MetaCache:
    def __init__(self):
        self._lock = threading.Lock()
        self._d: Dict[Any, tuple] = {}
        self.stats = collections.Counter()

    @staticmethod
    def _key(method: str, raw_path: str, profile: str, digest: str = "-"):
        # 键用**原始 path**（带 query）+ 方法：`clean_path` 为了查 TTL 表把 ?… 切掉了，
        # 但同一 clean_path 带不同 query 是两个不同请求（agy 在本机确实用 query 串，
        # 例：GET /v1internal/cascadeNuxes?page_size=1000）。窄化键不损命中率（body 是
        # 常量），只减少「拿别人的快照回你」。
        return (method, raw_path, profile, digest)

    def get(self, method: str, raw_path: str, profile: str, digest: str = "-"):
        if CACHE_DISABLE:
            return None
        k = self._key(method, raw_path, profile, digest)
        now = time.time()
        with self._lock:
            ent = self._d.get(k)
            if not ent:
                self.stats["miss"] += 1
                return None
            expires_at, payload = ent
            if now >= expires_at:
                self._d.pop(k, None)
                self.stats["expired"] += 1
                return None
            self.stats["hit"] += 1
            self.stats["bytes_saved"] += len(payload[2])
            return payload

    def put(self, method: str, raw_path: str, profile: str, status: int, headers, body: bytes,
            ttl: int, digest: str = "-") -> None:
        # ⚠ 空体不入缓存：一次「200 但 0 字节」的抖动会被当成成功答案重放整个 TTL，
        # 表现是 agy 拿到一个「没有 experiments / 没有 models」的正常响应（R24）。
        if (CACHE_DISABLE or status != 200 or not body
                or len(body) > META_CACHE_MAX_BYTES):
            return
        with self._lock:
            self._d[self._key(method, raw_path, profile, digest)] = (
                time.time() + ttl, (status, headers, body))
            self.stats["stored"] += 1
            # 粗略上限保护：接口数 × 账号数很小，这里只防 TTL 表被喂爆
            if len(self._d) > 512:
                for k in [k for k, (exp, _) in self._d.items() if exp <= time.time()]:
                    self._d.pop(k, None)

    def clear(self, profile: Optional[str] = None) -> int:
        with self._lock:
            ks = [k for k in self._d if profile is None or k[1] == profile]
            for k in ks:
                self._d.pop(k, None)
            self.stats["cleared"] += len(ks)
            return len(ks)

    def snapshot(self) -> Dict[str, Any]:
        with self._lock:
            entries = len(self._d)
        # 键一律给全：Counter 为空时 dict() 会得到 {}，看板/脚本就得到处 .get()，
        # 反而把「还没命中」和「功能没生效」混成同一种读数。
        s = {"hit": 0, "miss": 0, "expired": 0, "stored": 0, "cleared": 0, "bytes_saved": 0}
        s.update(self.stats)
        s["entries"] = entries
        s["disable"] = CACHE_DISABLE
        return s


_meta_cache = _MetaCache()


# ----------------------------------------------------------------------
# [2026-10-26] 会话粘性绑定
#
# 旧行为：429 容灾走 set_active_profile_name(next_p)，把**全局**活动账号搬走
# ⇒ 其它 agy 窗口的流量被一起带走 ⇒ 那些会话的 prompt cache 全量失效
# （实测 2620/5139 条生成请求 prompt > 120k token，重新 prefill 的代价正好落在
#   head_ms 最大的那一档），而且用户根本没同意。
# 新行为：自动容灾只绑定「出问题的那个会话」；显式 `agyp switch` 仍然全局生效。
# ----------------------------------------------------------------------

_REQUEST_ID_RE = re.compile(rb'"requestId"\s*:\s*"([^/"\\]+/[^/"\\]+)')


def extract_session_key(req_body: Optional[bytes]) -> Optional[str]:
    """从请求体取会话键。requestId 出现在 body 开头，只扫前 4KB。"""
    if not req_body:
        return None
    m = _REQUEST_ID_RE.search(req_body[:4096])
    return m.group(1).decode("ascii", "ignore") if m else None


class _SessionBind:
    def __init__(self):
        self._lock = threading.Lock()
        self._d: Dict[str, tuple] = {}
        self._epoch = 0

    def epoch(self) -> int:
        with self._lock:
            return self._epoch

    def get(self, skey: Optional[str]) -> Optional[str]:
        if not skey:
            return None
        now = time.time()
        with self._lock:
            ent = self._d.get(skey)
            if not ent:
                return None
            exp, profile = ent
            if now >= exp:
                self._d.pop(skey, None)
                return None
            return profile

    def bind(self, skey: Optional[str], profile: str, epoch: Optional[int] = None) -> None:
        if not skey:
            return
        with self._lock:
            # 请求开始时采样的 epoch 与现在不一致 = 中间发生过显式切号。
            # 迟到的容灾 bind 不得把刚清掉的会话写回去。
            if epoch is not None and epoch != self._epoch:
                return
            if len(self._d) >= SESSION_PROFILE_MAX and skey not in self._d:
                # 淘汰最早过期的那半条，够用且不需要真 LRU
                for k in sorted(self._d, key=lambda x: self._d[x][0])[: SESSION_PROFILE_MAX // 2]:
                    self._d.pop(k, None)
            self._d[skey] = (time.time() + SESSION_PROFILE_TTL_SEC, profile)

    def clear(self) -> int:
        with self._lock:
            n = len(self._d)
            self._d.clear()
            self._epoch += 1
            return n

    def drop(self, skey: str) -> None:
        with self._lock:
            self._d.pop(skey, None)

    def drop_profile(self, pname: str) -> int:
        with self._lock:
            keys = [k for k, v in self._d.items() if v[1] == pname]
            for k in keys:
                self._d.pop(k, None)
            self._epoch += 1
            return len(keys)

    def snapshot(self) -> Dict[str, Any]:
        now = time.time()
        with self._lock:
            live = {k: {"profile": v[1], "age_sec": round(now - (v[0] - SESSION_PROFILE_TTL_SEC))}
                    for k, v in self._d.items() if v[0] > now}
        by_profile = collections.Counter(v["profile"] for v in live.values())
        return {"count": len(live), "by_profile": dict(by_profile), "sessions": live}


_session_bind = _SessionBind()


# ----------------------------------------------------------------------
# [2026-10-26] 在途请求计数（供 /_agyp/diag 与 agyp live 看板；restart 前判断有没有活口）
# ----------------------------------------------------------------------

class _Inflight:
    def __init__(self):
        self._lock = threading.Lock()
        self._n = 0
        self._peak = 0

    def inc(self) -> None:
        with self._lock:
            self._n += 1
            if self._n > self._peak:
                self._peak = self._n

    def dec(self) -> None:
        with self._lock:
            if self._n > 0:
                self._n -= 1

    def count(self) -> Dict[str, Any]:
        with self._lock:
            return {"now": self._n, "peak": self._peak}


_inflight = _Inflight()

def _atomic_write_json(path: str, obj: Dict[str, Any], label: str) -> bool:
    """
    [fix-20260920] 原子写 JSON。旧实现 = `path + ".tmp"` **固定名** + open("w") + os.replace，
    在**并发写者**下会被撕裂：

        A: open(tmp, "w")  → O_TRUNC，写入 4748 字节
        B: open(tmp, "w")  → O_TRUNC 同一 inode，也写
        A: 再写 4747 字节  → write() 不截断，B 尾部那 1 个 `}` 成为孤儿
        → 合法 JSON + 多余字节 → json.load 报 `Extra data: line 89 column 2`

    三个修正：
      1. mkstemp 唯一临时名 —— 消灭"多个写者共用同一个 tmp inode"这条路径；
      2. fcntl.flock 跨进程串行化 —— threading.Lock 只在进程内有效，
         管不住 node statusline hook 起的 4~5 个并发 python 进程；
      3. 写前自校验 + fsync —— 落盘内容必须能解析回来，否则放弃本次写入。
    返回 True 表示已落盘。
    """
    directory = os.path.dirname(path) or "."
    try:
        os.makedirs(directory, exist_ok=True)
    except Exception:
        pass

    try:
        payload = json.dumps(obj, indent=2, ensure_ascii=False)
        json.loads(payload)
    except Exception as e:
        _agyp_log(f"{label} 序列化/自校验失败，放弃写入: {type(e).__name__}: {e}")
        return False

    lock_fd = None
    try:
        lock_fd = os.open(path + ".lock", os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
    except Exception as e:
        _agyp_log(f"{label} 取跨进程锁失败（退化为仅唯一临时名写入）: {e}")
        if lock_fd is not None:
            try:
                os.close(lock_fd)
            except Exception:
                pass
            lock_fd = None

    tmp_path = None
    try:
        fd, tmp_path = tempfile.mkstemp(
            dir=directory, prefix="." + os.path.basename(path) + ".", suffix=".tmp"
        )
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(payload)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp_path, 0o600)
        os.replace(tmp_path, path)
        tmp_path = None
        return True
    except Exception as e:
        _agyp_log(f"{label} 写入失败: {type(e).__name__}: {e}")
        return False
    finally:
        if tmp_path:
            try:
                if os.path.exists(tmp_path):
                    os.unlink(tmp_path)
            except Exception:
                pass
        if lock_fd is not None:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
            except Exception:
                pass
            try:
                os.close(lock_fd)
            except Exception:
                pass

def save_metrics(m: Dict[str, Any]) -> None:
    # metrics.json 由多个请求线程并发写（ThreadingHTTPServer），旧写法同款撕裂风险
    _atomic_write_json(METRICS_FILE, m, "metrics.json")

def _bump(d: Dict[str, Any], *, req: int = 0, inp: int = 0, out: int = 0,
          tot: int = 0, cache: int = 0, thought: int = 0, usd: float = 0.0, cny: float = 0.0) -> None:
    """累加一格账。用 `.get(k, 0) + v` 而不是 `d[k] += v`：

    metrics.json 历史上真被并发撕裂过（见 2026-09-20），文件里完全可能出现
    `{"summary": {}}` 这种「键在、子键不在」的半截结构。旧写法在此处直接抛
    KeyError，被上游那层 `except Exception: pass` 吞掉 ⇒ **整条 token 账本静默停更**，
    连 `agyp stats` 都看不出来。回归测试 T8 就是撞出来了。
    """
    if req:
        d["requests"] = d.get("requests", 0) + req
    if inp:
        d["input_tokens"] = d.get("input_tokens", 0) + inp
    if out:
        d["output_tokens"] = d.get("output_tokens", 0) + out
    if tot:
        d["total_tokens"] = d.get("total_tokens", 0) + tot
    if cache:
        d["cached_tokens"] = d.get("cached_tokens", 0) + cache
    if thought:
        d["thought_tokens"] = d.get("thought_tokens", 0) + thought
    if usd:
        d["cost_usd"] = round(d.get("cost_usd", 0.0) + usd, 4)
    if cny:
        d["cost_cny"] = round(d.get("cost_cny", 0.0) + cny, 2)


def record_token_usage(profile: str, model: str, input_tokens: int, output_tokens: int,
                       cached_tokens: int = 0, thought_tokens: int = 0):
    """累计 token 账本。

    cached_tokens = usageMetadata.cachedContentTokenCount（[2026-10-26] 新增）。
    thought_tokens = usageMetadata.thoughtsTokenCount（[2026-11-25] 新增）。
    """
    cost_usd, cost_cny = calculate_token_cost(
        model, input_tokens, output_tokens,
        cached_tokens=cached_tokens, thought_tokens=thought_tokens,
    )
    total_tokens = input_tokens + output_tokens + thought_tokens
    today = datetime.now().strftime("%Y-%m-%d")

    with metrics_lock:
        m = load_metrics()
        s = m.setdefault("summary", {})
        # summary 用的是 total_* 前缀键名，与按天/按账号格的键名不同，不能走 _bump
        s["total_requests"] = s.get("total_requests", 0) + 1
        s["total_input_tokens"] = s.get("total_input_tokens", 0) + input_tokens
        s["total_output_tokens"] = s.get("total_output_tokens", 0) + output_tokens
        s["total_tokens"] = s.get("total_tokens", 0) + total_tokens
        s["total_cached_tokens"] = s.get("total_cached_tokens", 0) + cached_tokens
        s["total_thought_tokens"] = s.get("total_thought_tokens", 0) + thought_tokens
        s["total_cost_usd"] = round(s.get("total_cost_usd", 0.0) + cost_usd, 4)
        s["total_cost_cny"] = round(s.get("total_cost_cny", 0.0) + cost_cny, 2)

        d_dict = m.setdefault("by_date", {}).setdefault(today, {})
        _bump(d_dict, req=1, inp=input_tokens, out=output_tokens, tot=total_tokens,
              cache=cached_tokens, thought=thought_tokens, usd=cost_usd, cny=cost_cny)
        p_in_d = d_dict.setdefault("profiles", {}).setdefault(profile, {})
        _bump(p_in_d, req=1, inp=input_tokens, out=output_tokens, tot=total_tokens,
              cache=cached_tokens, thought=thought_tokens, usd=cost_usd, cny=cost_cny)

        prof_dict = m.setdefault("by_profile", {}).setdefault(profile, {})
        _bump(prof_dict, req=1, inp=input_tokens, out=output_tokens, tot=total_tokens,
              cache=cached_tokens, thought=thought_tokens, usd=cost_usd, cny=cost_cny)

        m["last_updated"] = datetime.now(timezone.utc).isoformat()
        save_metrics(m)

# ----------------------------------------------------------------------
# Config & Token Management
# ----------------------------------------------------------------------

config_lock = threading.Lock()
# 最近一次 load_config 的失败原因（None = 正常）。用于把"配置损坏"显式暴露成 502，
# 而不是让上层拿到空账号池后静默不回包。
config_load_error: Optional[str] = None

def load_config() -> Dict[str, Any]:
    """
    [fix-20260920] 解析失败**绝不静默返回空账号池**。旧行为（裸 except → 返回空 profiles）
    的后果链：refresh_token_for_profile 返回 None → forward_with_failover 全 `continue`
    → 一个字节都不发 → HTTP/1.0 默认 close → 客户端只看到 `EOF`，
    把"配置损坏"误诊成"网络/地区不可用"。
    现在：留痕 + 把坏文件改名隔离（rename 不丢字节，可手工修复）+ 记录原因供请求路径回显。
    """
    global config_load_error
    if not os.path.exists(CONFIG_FILE):
        # 文件缺失（含"刚被隔离"）：保留上一次的失败原因，让调用方/客户端还能看到根因。
        # config_load_error 只在**成功解析**时被清空——空账号池本身就是要报错的状态。
        return {"active_profile": "", "profiles": {}}
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            cfg = json.load(f)
        config_load_error = None
        return cfg
    except Exception as e:
        bad_path = f"{CONFIG_FILE}.bad-{time.strftime('%Y%m%d-%H%M%S')}"
        try:
            os.replace(CONFIG_FILE, bad_path)
        except Exception:
            bad_path = None
        config_load_error = f"{type(e).__name__}: {e}"
        _agyp_log(
            f"load_config 解析失败 -> {config_load_error}；已隔离到 "
            f"{bad_path or '<隔离失败，原文件保留>'}"
        )
        return {"active_profile": "", "profiles": {}}

def save_config(cfg: Dict[str, Any]) -> bool:
    """唯一临时名 + 跨进程 flock + 写后校验（详见 _atomic_write_json）。"""
    return _atomic_write_json(CONFIG_FILE, cfg, "profiles.json")

def refresh_token_for_profile(pname: str, force: bool = False) -> Optional[str]:
    """
    [fix-lostupdate-20260920] 网络调用移出 config_lock。

    旧实现把 OAuth POST（`timeout=10`）放在 `with config_lock:` **内部**：快照从函数开头的
    `load_config()` 起就冻结，最长 10 秒。这段窗口里别的进程（agy statusline hook 起的短命
    python）写进来的字段，会被这里的 `save_config(cfg)` 用旧快照**整体覆盖** —— 即 lost update：
    两个进程并发"读整份 → 改自己那格 → 写回整份"时，后写者胜。

    现在：锁内只做「读 + 判断」，网络在锁外；拿到新 token 后**重新取锁 + load-fresh**，
    只改自己这 3 个字段。附带好处：网关不再被一次 OAuth 往返占住配置锁 10 秒。
    """
    with config_lock:
        cfg = load_config()
        p = cfg.get("profiles", {}).get(pname)
        if not p:
            return None

        expires_at = p.get("expires_at", 0)
        access_token = p.get("access_token")

        if access_token and expires_at > (time.time() + 300) and not force:
            return access_token

        rt = p.get("refresh_token")
        if not rt:
            return None

    # —— 网络调用（锁外，最长 10s，不再阻塞其它配置读写）——
    cid, csec = load_oauth_client()
    if not cid or not csec:
        sys.stderr.write("[agyp] 缺少 OAuth Client 凭据，请运行 agyp auth config\n")
        return access_token if access_token else None

    body = urllib.parse.urlencode({
        "client_id": cid,
        "client_secret": csec,
        "refresh_token": rt,
        "grant_type": "refresh_token"
    }).encode("utf-8")

    req = urllib.request.Request("https://oauth2.googleapis.com/token", data=body, method="POST")
    try:
        with _build_google_opener().open(req, timeout=10) as resp:
            data = json.loads(resp.read().decode())
        new_token = data.get("access_token")
        if not new_token:
            raise ValueError("upstream 未返回 access_token")
        expires_in = int(data.get("expires_in", 3600))
    except Exception as e:
        sys.stderr.write(f"[agyp] Refresh token failed for {pname}: {e}\n")
        return access_token if access_token else None

    # —— 重新取锁 + load-fresh：只提交自己这几个字段，不动别人这期间的写入 ——
    with config_lock:
        cfg = load_config()
        prof = cfg.get("profiles", {}).get(pname)
        if prof is None:
            # 账号在刷新期间被移除：token 仍可用，只是不落盘
            return new_token
        prof["access_token"] = new_token
        prof["expires_at"] = time.time() + expires_in
        prof["updated_at"] = datetime.now(timezone.utc).isoformat()
        save_config(cfg)
    return new_token

def get_active_profile_name() -> str:
    cfg = load_config()
    ap = cfg.get("active_profile") or ""
    if ap:
        return ap
    profs = cfg.get("profiles") or {}
    return next(iter(profs.keys()), "")


def profile_in_cooldown(pname: str) -> bool:
    """该账号是否正处于 429/传输失败后的 cooldown 窗口。"""
    try:
        cfg = load_config()
        return float(cfg.get("profiles", {}).get(pname, {}).get("cooldown_until", 0) or 0) > time.time()
    except Exception:
        return False

def set_active_profile_name(pname: str, unpause: bool = False) -> bool:
    """设置全局默认账号；unpause=True 时若目标处于暂停态则一并恢复。返回是否曾处于暂停态。"""
    was_paused = False
    with config_lock:
        cfg = load_config()
        profs = cfg.get("profiles", {})
        if pname in profs:
            if unpause and profs[pname].get("paused"):
                profs[pname].pop("paused", None)
                was_paused = True
            cfg["active_profile"] = pname
            save_config(cfg)
    return was_paused


def _rank_profiles_from_cfg(cfg: Dict[str, Any], include_paused: bool = False) -> List[Tuple[str, float, Dict[str, Any]]]:
    metrics = load_metrics()
    today = datetime.now().strftime("%Y-%m-%d")
    today_profiles = metrics.get("by_date", {}).get(today, {}).get("profiles", {})
    profs = cfg.get("profiles") or {}
    names = list(profs.keys()) or list(DEFAULT_PROFILES)

    ranked = []
    for p in names:
        info = profs.get(p, {})
        paused = bool(info.get("paused", False))
        if paused and not include_paused:
            continue
        quota = info.get("last_quota")
        cooldown = info.get("cooldown_until", 0)
        today_tok = today_profiles.get(p, {}).get("total_tokens", 0)
        score = 0.0 if paused else calculate_priority_score(quota, cooldown, today_tokens=today_tok)
        ranked.append((p, score, info))
    ranked.sort(key=lambda x: (0 if not x[2].get("paused") else 1, -x[1]))
    return ranked


def _pause_snapshot_from_cfg(cfg: Dict[str, Any]) -> Dict[str, Any]:
    return {
        "active_profile": cfg.get("active_profile") or "",
        "paused_profiles": paused_profiles(cfg),
        "enabled_profiles": enabled_profiles(cfg),
    }


def set_profile_paused(pname: str, paused: bool) -> Tuple[bool, str, Dict[str, Any]]:
    """暂停或恢复指定账号。至少保留 1 个启用账号；若暂停了当前 active_profile 则自动切换到最佳可用账号。"""
    with config_lock:
        cfg = load_config()
        profs = cfg.get("profiles") or {}
        if pname not in profs:
            return False, f"未知 Profile '{pname}'", {}
        enabled = [p for p in profs.keys() if not bool((profs.get(p) or {}).get("paused", False))]
        prev_active = cfg.get("active_profile")
        if paused:
            remaining = [p for p in enabled if p != pname]
            if not remaining:
                return False, "不能暂停最后一个可用账号，至少需保留 1 个启用账号", {}
            profs[pname]["paused"] = True
            if prev_active == pname:
                ranked = _rank_profiles_from_cfg(cfg, include_paused=False)
                cfg["active_profile"] = ranked[0][0] if ranked else remaining[0]
        else:
            profs[pname].pop("paused", None)
            if not prev_active or prev_active not in profs or bool((profs.get(prev_active) or {}).get("paused", False)):
                cfg["active_profile"] = pname
        save_config(cfg)
        snap = _pause_snapshot_from_cfg(cfg)
        snap["profile"] = pname
        snap["paused"] = paused
        snap["active_changed"] = (snap["active_profile"] != prev_active)
        return True, "", snap


def set_only_profile(pname: str) -> Tuple[bool, str, Dict[str, Any]]:
    """单账号独占模式：只启用 pname，暂停其余全部账号，并切换 active_profile 至 pname。"""
    with config_lock:
        cfg = load_config()
        profs = cfg.get("profiles") or {}
        if pname not in profs:
            return False, f"未知 Profile '{pname}'", {}
        prev_active = cfg.get("active_profile")
        for p, info in profs.items():
            if p == pname:
                info.pop("paused", None)
            else:
                info["paused"] = True
        cfg["active_profile"] = pname
        save_config(cfg)
        snap = _pause_snapshot_from_cfg(cfg)
        snap["only"] = pname
        snap["active_changed"] = (snap["active_profile"] != prev_active)
        return True, "", snap


def resume_all_profiles() -> Tuple[bool, str, Dict[str, Any]]:
    """恢复全部已暂停的账号。"""
    with config_lock:
        cfg = load_config()
        profs = cfg.get("profiles") or {}
        resumed = []
        for p, info in profs.items():
            if info.pop("paused", None):
                resumed.append(p)
        if (not cfg.get("active_profile") or cfg.get("active_profile") not in profs) and profs:
            cfg["active_profile"] = next(iter(profs.keys()))
        save_config(cfg)
        snap = _pause_snapshot_from_cfg(cfg)
        snap["resumed"] = resumed
        snap["active_changed"] = False
        return True, "", snap


# ----------------------------------------------------------------------
# Account Lifecycle Management (Add / OAuth / Keychain / Rename / Remove)
# ----------------------------------------------------------------------

RESERVED_PROFILE_NAMES = {
    "add", "login", "reauth", "remove", "rm", "delete", "rename", "mv", "auth",
    "switch", "use", "pause", "resume", "unpause", "only", "quota", "q",
    "stats", "cost", "usage", "gui", "dashboard", "app", "list", "ls",
    "status", "check", "test", "daemon", "direct", "live", "top", "diag",
    "cache", "pool", "help", "all", "__daemon",
}
_PROFILE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$")


def validate_profile_name(name: str) -> Tuple[bool, str]:
    """校验账号别名是否合法且不与保留子命令冲突。"""
    n = (name or "").strip()
    if not n:
        return False, "账号名称不能为空"
    if not _PROFILE_NAME_RE.match(n):
        return False, "账号名称仅支持字母/数字开头，包含字母、数字、._-，长度 1~32"
    if n.lower() in RESERVED_PROFILE_NAMES:
        return False, f"账号名称 '{n}' 为系统保留命令名，请换一个名称"
    return True, ""


def _build_google_opener() -> urllib.request.OpenerDirector:
    """构造访问 Google OAuth/UserInfo 的 HTTP Opener，代理优先复用 _resolve_upstream_proxy。"""
    proxy = _resolve_upstream_proxy()
    if proxy:
        ph = f"http://{proxy[0]}:{proxy[1]}"
        return urllib.request.build_opener(urllib.request.ProxyHandler({"http": ph, "https": ph}))
    return urllib.request.build_opener()


def exchange_refresh_token(rt: str) -> Tuple[Optional[str], int, Optional[str]]:
    """使用 refresh_token 换取 access_token，返回 (access_token, expires_in, err_msg)。"""
    cid, csec = load_oauth_client()
    if not cid or not csec:
        return None, 0, "缺少 OAuth Client 凭据，请先执行 agyp auth config --client-id ... --client-secret ..."
    body = urllib.parse.urlencode({
        "client_id": cid,
        "client_secret": csec,
        "refresh_token": rt,
        "grant_type": "refresh_token",
    }).encode("utf-8")
    req = urllib.request.Request("https://oauth2.googleapis.com/token", data=body, method="POST")
    try:
        with _build_google_opener().open(req, timeout=15) as resp:
            data = json.loads(resp.read().decode())
        tok = data.get("access_token")
        if not tok:
            return None, 0, f"OAuth 响应缺少 access_token: {data}"
        return tok, int(data.get("expires_in", 3600)), None
    except urllib.error.HTTPError as he:
        detail = ""
        try:
            detail = he.read().decode("utf-8", errors="replace")[:300]
        except Exception:
            pass
        return None, 0, f"OAuth 校验失败 (HTTP {he.code}): {detail or he}"
    except Exception as e:
        return None, 0, f"OAuth 请求失败: {e}"


def fetch_google_userinfo(access_token: str) -> Dict[str, Any]:
    """获取当前 access_token 对应的 Google 用户信息（如 email）。"""
    if not access_token:
        return {}
    req = urllib.request.Request(
        "https://www.googleapis.com/oauth2/v2/userinfo",
        headers={"Authorization": f"Bearer {access_token}"},
        method="GET",
    )
    try:
        with _build_google_opener().open(req, timeout=10) as resp:
            return json.loads(resp.read().decode()) or {}
    except Exception:
        return {}


def _decode_id_token_email(id_token: str) -> str:
    """从 OIDC id_token JWT payload 解析 email（无需验签，仅作 fallback 展示）。"""
    try:
        parts = (id_token or "").split(".")
        if len(parts) < 2:
            return ""
        b64 = parts[1] + "=" * (-len(parts[1]) % 4)
        payload = json.loads(base64.urlsafe_b64decode(b64).decode("utf-8"))
        return str(payload.get("email") or "").strip()
    except Exception:
        return ""


def read_keychain_credentials() -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
    """从 macOS 钥匙串读取官方 agy 登录的 OAuth 凭据。"""
    if sys.platform != "darwin":
        return None, "钥匙串导入仅支持 macOS"
    try:
        out = subprocess.check_output(
            ["security", "find-generic-password", "-s", "gemini", "-a", "antigravity", "-w"],
            stderr=subprocess.PIPE,
            text=True,
        ).strip()
    except subprocess.CalledProcessError:
        return None, "未在 macOS 钥匙串中找到 Antigravity 凭据（请先运行一次 agy 完成登录，或使用浏览器 OAuth 登录）"
    except Exception as e:
        return None, f"读取钥匙串失败: {e}"

    if not out.startswith("go-keyring-base64:"):
        return None, "钥匙串凭据格式非 go-keyring-base64"
    try:
        payload = json.loads(base64.b64decode(out[len("go-keyring-base64:"):]))
        tok = payload.get("token") or {}
        rt = str(tok.get("refresh_token") or "").strip()
        if not rt:
            return None, "钥匙串凭据中缺少 refresh_token"
        at = str(tok.get("access_token") or "").strip()
        exp_ts = 0.0
        exp_str = str(tok.get("expiry") or "").strip()
        if exp_str:
            try:
                exp_ts = datetime.fromisoformat(exp_str.replace("Z", "+00:00")).timestamp()
            except Exception:
                exp_ts = 0.0
        return {"refresh_token": rt, "access_token": at, "expires_at": exp_ts}, None
    except Exception as e:
        return None, f"解析钥匙串凭据失败: {e}"


def oauth_browser_login(timeout_sec: int = 180, open_browser: bool = True) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
    """发起 Google OAuth PKCE 浏览器授权流程并返回 {refresh_token, access_token, expires_at, email}。"""
    cid, csec = load_oauth_client()
    if not cid or not csec:
        return None, "未配置 OAuth Client 凭据。请运行 agyp auth config --client-id <ID> --client-secret <SECRET>，或改用 --from-keychain 导入"

    verifier = secrets.token_urlsafe(48)
    challenge = base64.urlsafe_b64encode(
        hashlib.sha256(verifier.encode("ascii")).digest()
    ).rstrip(b"=").decode("ascii")
    state = secrets.token_urlsafe(24)

    result_box: Dict[str, Any] = {}
    done_ev = threading.Event()

    class _OAuthCallbackHandler(http.server.BaseHTTPRequestHandler):
        def log_message(self, format, *args):
            pass

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path != "/oauth2callback":
                self.send_response(404)
                self.end_headers()
                return
            qs = urllib.parse.parse_qs(parsed.query)
            if qs.get("error"):
                result_box["error"] = qs.get("error", ["unknown"])[0]
                html = "<html><body><h3>Authorization failed</h3><p>You can close this tab.</p></body></html>"
                self.send_response(400)
            elif qs.get("state", [""])[0] != state:
                result_box["error"] = "state_mismatch"
                html = "<html><body><h3>Invalid state</h3><p>Please retry from terminal.</p></body></html>"
                self.send_response(400)
            else:
                result_box["code"] = qs.get("code", [""])[0]
                html = "<html><body style='font-family:system-ui;padding:32px'><h2>&#10004; agyp Authorization Successful</h2><p>You may close this browser window and return to agyp.</p></body></html>"
                self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(html.encode("utf-8"))
            done_ev.set()

    server = http.server.HTTPServer(("127.0.0.1", 0), _OAuthCallbackHandler)
    port = server.server_address[1]
    redirect_uri = f"http://127.0.0.1:{port}/oauth2callback"
    srv_thread = threading.Thread(target=server.serve_forever, daemon=True)
    srv_thread.start()

    try:
        auth_url = "https://accounts.google.com/o/oauth2/v2/auth?" + urllib.parse.urlencode({
            "client_id": cid,
            "redirect_uri": redirect_uri,
            "response_type": "code",
            "scope": " ".join([
                "https://www.googleapis.com/auth/cloud-platform",
                "https://www.googleapis.com/auth/userinfo.email",
                "https://www.googleapis.com/auth/userinfo.profile",
                "openid",
            ]),
            "access_type": "offline",
            "prompt": "consent",
            "code_challenge": challenge,
            "code_challenge_method": "S256",
            "state": state,
        })
        sys.stderr.write(f"\n请点击下方链接完成 Google 授权（{timeout_sec}s 内有效）:\n{auth_url}\n\n")
        sys.stderr.flush()
        if open_browser:
            try:
                webbrowser.open(auth_url)
            except Exception:
                pass

        if not done_ev.wait(timeout=max(10, int(timeout_sec))):
            return None, f"OAuth 授权等待超时 ({timeout_sec}s)"
        if result_box.get("error"):
            return None, f"Google OAuth 返回错误: {result_box['error']}"
        code = result_box.get("code") or ""
        if not code:
            return None, "未收到 OAuth authorization code"

        tok_body = urllib.parse.urlencode({
            "client_id": cid,
            "client_secret": csec,
            "code": code,
            "code_verifier": verifier,
            "redirect_uri": redirect_uri,
            "grant_type": "authorization_code",
        }).encode("utf-8")
        req = urllib.request.Request("https://oauth2.googleapis.com/token", data=tok_body, method="POST")
        try:
            with _build_google_opener().open(req, timeout=20) as resp:
                tok_data = json.loads(resp.read().decode())
        except urllib.error.HTTPError as he:
            detail = he.read().decode("utf-8", errors="replace")[:300]
            return None, f"换取 Token 失败 (HTTP {he.code}): {detail}"
        except Exception as e:
            return None, f"换取 Token 失败: {e}"

        rt = str(tok_data.get("refresh_token") or "").strip()
        at = str(tok_data.get("access_token") or "").strip()
        if not rt:
            return None, "Google 未返回 refresh_token（请确保同意授权）"
        exp_at = time.time() + int(tok_data.get("expires_in", 3600))
        email = ""
        if at:
            email = str(fetch_google_userinfo(at).get("email") or "").strip()
        if not email and tok_data.get("id_token"):
            email = _decode_id_token_email(str(tok_data.get("id_token") or ""))
        return {"refresh_token": rt, "access_token": at, "expires_at": exp_at, "email": email}, None
    finally:
        try:
            server.shutdown()
            server.server_close()
        except Exception:
            pass


def upsert_profile(name: str, refresh_token: str, access_token: str = "", expires_at: float = 0.0,
                   email: str = "", overwrite: bool = False, verify: bool = True) -> Tuple[bool, str, Dict[str, Any]]:
    """校验并原子写入/更新指定账号配置。"""
    ok_name, err_name = validate_profile_name(name)
    if not ok_name:
        return False, err_name, {}
    name = name.strip()
    rt = (refresh_token or "").strip()
    if not rt:
        return False, "refresh_token 不能为空", {}

    with config_lock:
        cfg = load_config()
        profs = cfg.get("profiles") or {}
        if name in profs and not overwrite:
            return False, f"账号 '{name}' 已存在（如需覆盖请使用 reauth 或 --force）", {}
        for k, v in profs.items():
            if k != name and isinstance(v, dict) and v.get("refresh_token") == rt and not overwrite:
                return False, f"该 Refresh Token 已绑定到账号 '{k}'（加 --force 可强制写入）", {}

    at = (access_token or "").strip()
    exp = float(expires_at or 0.0)
    resolved_email = (email or "").strip()

    if verify:
        if not at or exp <= time.time() + 120:
            new_at, exp_in, err = exchange_refresh_token(rt)
            if not new_at:
                return False, err or "Refresh Token 校验失败", {}
            at = new_at
            exp = time.time() + exp_in
        if not resolved_email and at:
            ui = fetch_google_userinfo(at)
            resolved_email = str(ui.get("email") or "").strip()

    now_iso = datetime.now(timezone.utc).isoformat()
    with config_lock:
        cfg = load_config()
        profs = cfg.setdefault("profiles", {})
        if name in profs and not overwrite:
            return False, f"账号 '{name}' 已存在", {}
        existing = dict(profs.get(name) or {}) if isinstance(profs.get(name), dict) else {}
        existing["refresh_token"] = rt
        if at:
            existing["access_token"] = at
        if exp:
            existing["expires_at"] = exp
        if resolved_email:
            existing["email"] = resolved_email
        existing.setdefault("created_at", now_iso)
        existing["updated_at"] = now_iso
        existing.pop("cooldown_until", None)
        profs[name] = existing
        cur_active = cfg.get("active_profile") or ""
        if not cur_active or cur_active not in profs:
            cfg["active_profile"] = name
        if not save_config(cfg):
            return False, "写入 profiles.json 失败", {}
        snap = _pause_snapshot_from_cfg(cfg)

    if verify:
        try:
            fetch_quota_summary(name, refresh_tier=True)
        except Exception:
            pass
    snap["profile"] = name
    snap["email"] = resolved_email or existing.get("email", "")
    return True, "", snap


def remove_profile(name: str, force: bool = False) -> Tuple[bool, str, Dict[str, Any]]:
    """安全删除账号：默认禁止删除最后一个账号（force=True 例外），必要时自动切换 active_profile。"""
    name = (name or "").strip()
    if not name:
        return False, "账号名称不能为空", {}
    with config_lock:
        cfg = load_config()
        profs = cfg.get("profiles") or {}
        if name not in profs:
            return False, f"未知 Profile '{name}'", {}
        if len(profs) <= 1 and not force:
            return False, "不能删除最后一个账号（如确需清空请传 --force）", {}

        prev_active = cfg.get("active_profile") or ""
        del profs[name]
        if prev_active == name or prev_active not in profs:
            ranked = _rank_profiles_from_cfg(cfg, include_paused=False)
            if ranked:
                cfg["active_profile"] = ranked[0][0]
            elif profs:
                first_p = next(iter(profs.keys()))
                if isinstance(profs[first_p], dict):
                    profs[first_p].pop("paused", None)
                cfg["active_profile"] = first_p
            else:
                cfg["active_profile"] = ""
        if not save_config(cfg):
            return False, "写入 profiles.json 失败", {}
        snap = _pause_snapshot_from_cfg(cfg)
        snap["removed"] = name
        snap["active_changed"] = (snap["active_profile"] != prev_active)
        return True, "", snap


def rename_profile(old_name: str, new_name: str) -> Tuple[bool, str, Dict[str, Any]]:
    """原子重命名账号，保留在 profiles.json 中的顺序。"""
    old_name = (old_name or "").strip()
    new_name = (new_name or "").strip()
    ok_new, err_new = validate_profile_name(new_name)
    if not ok_new:
        return False, err_new, {}
    with config_lock:
        cfg = load_config()
        profs = cfg.get("profiles") or {}
        if old_name not in profs:
            return False, f"未知 Profile '{old_name}'", {}
        if new_name in profs:
            return False, f"目标名称 '{new_name}' 已存在", {}
        rebuilt: Dict[str, Any] = {}
        for k, v in profs.items():
            rebuilt[new_name if k == old_name else k] = v
        cfg["profiles"] = rebuilt
        prev_active = cfg.get("active_profile") or ""
        if prev_active == old_name:
            cfg["active_profile"] = new_name
        if not save_config(cfg):
            return False, "写入 profiles.json 失败", {}
        snap = _pause_snapshot_from_cfg(cfg)
        snap["old_name"] = old_name
        snap["new_name"] = new_name
        snap["active_changed"] = (snap["active_profile"] != prev_active)
        return True, "", snap

# ----------------------------------------------------------------------
# Live Quota Retrieval (Direct Cloud Endpoints)
# ----------------------------------------------------------------------

def parse_tier_label(tier_id: str, tier_name: str = "") -> str:
    """将 Google Code Assist paidTier/currentTier 归类为简短等级标签。"""
    tid = (tier_id or "").lower()
    tname = (tier_name or "").lower()
    if "ultra" in tid or "ultra" in tname:
        return "Ultra"
    if "pro" in tid or "pro" in tname:
        return "Pro"
    if "plus" in tid or "plus" in tname:
        return "Plus"
    if "free" in tid or "starter" in tname:
        return "Free"
    return tier_name or tier_id or ""


def format_tier_badge(tier: Optional[Dict[str, Any]], width: int = 5) -> str:
    """CLI 表格用彩色会员等级徽标（保持固定可视宽度）。"""
    label = (tier or {}).get("label") or parse_tier_label((tier or {}).get("id", ""), (tier or {}).get("name", ""))
    if not label:
        return f"{DIM}{'--':<{width}}{RESET}"
    txt = f"{label:<{width}}"
    if label == "Ultra":
        return f"{BOLD}{MAGENTA}{txt}{RESET}"
    if label == "Pro":
        return f"{BOLD}{CYAN}{txt}{RESET}"
    if label == "Plus":
        return f"{GREEN}{txt}{RESET}"
    return f"{DIM}{txt}{RESET}"


def fetch_tier_summary(pname: str, tok: Optional[str] = None) -> Optional[Dict[str, Any]]:
    """查询账号的订阅等级（paidTier: Ultra / Pro / Free）并缓存到 profiles.json。"""
    tok = tok or refresh_token_for_profile(pname)
    if not tok:
        cfg = load_config()
        return cfg.get("profiles", {}).get(pname, {}).get("tier")

    url = f"{UPSTREAM_BASE}/v1internal:loadCodeAssist"
    headers = {
        "Authorization": f"Bearer {tok}",
        "Content-Type": "application/json",
        "User-Agent": "antigravity/cli/1.2.1",
    }
    req = urllib.request.Request(url, headers=headers, data=b"{}", method="POST")
    ctx = ssl.create_default_context()
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=8) as resp:
            data = json.loads(resp.read().decode())
        tier_obj = data.get("paidTier") or data.get("currentTier") or {}
        tier_id = str(tier_obj.get("id") or "")
        tier_name = str(tier_obj.get("name") or "")
        tier_info = {
            "id": tier_id,
            "name": tier_name,
            "label": parse_tier_label(tier_id, tier_name),
            "updated_at": datetime.now(timezone.utc).isoformat(),
        }
        with config_lock:
            cfg = load_config()
            if pname in cfg.get("profiles", {}):
                cfg["profiles"][pname]["tier"] = tier_info
                save_config(cfg)
        return tier_info
    except Exception:
        cfg = load_config()
        return cfg.get("profiles", {}).get(pname, {}).get("tier")


def _tier_needs_refresh(info: Dict[str, Any], max_age_sec: float = 21600.0) -> bool:
    tier = info.get("tier")
    if not isinstance(tier, dict) or not tier.get("label"):
        return True
    upd = tier.get("updated_at")
    if not upd:
        return True
    try:
        dt = datetime.fromisoformat(str(upd).replace("Z", "+00:00"))
        return (datetime.now(timezone.utc) - dt).total_seconds() > max_age_sec
    except Exception:
        return True


def fetch_quota_summary(pname: str, refresh_tier: bool = False) -> Optional[Dict[str, Any]]:
    tok = refresh_token_for_profile(pname)
    if not tok:
        return None

    cfg_pre = load_config()
    p_info = cfg_pre.get("profiles", {}).get(pname, {})
    if refresh_tier or _tier_needs_refresh(p_info):
        fetch_tier_summary(pname, tok=tok)

    url = f"{UPSTREAM_BASE}/v1internal:retrieveUserQuotaSummary"
    headers = {
        "Authorization": f"Bearer {tok}",
        "Content-Type": "application/json",
        "User-Agent": "antigravity/cli/1.2.1"
    }
    req = urllib.request.Request(url, headers=headers, data=b"{}", method="POST")
    ctx = ssl.create_default_context()
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=8) as resp:
            data = json.loads(resp.read().decode())
            parsed: Dict[str, Any] = {"updated_at": datetime.now(timezone.utc).isoformat()}
            for g in data.get("groups", []):
                dname = g.get("displayName", "")
                if "Gemini" in dname:
                    for b in g.get("buckets", []):
                        bid = b.get("bucketId", "")
                        if "5h" in bid:
                            parsed["gemini_5h"] = float(b.get("remainingFraction", 0.0))
                            parsed["reset_5h"] = b.get("resetTime")
                        elif "weekly" in bid:
                            parsed["gemini_weekly"] = float(b.get("remainingFraction", 0.0))
                            parsed["reset_weekly"] = b.get("resetTime")
                elif "Claude" in dname or "3p" in dname:
                    for b in g.get("buckets", []):
                        if "weekly" in b.get("bucketId", ""):
                            parsed["claude_weekly"] = float(b.get("remainingFraction", 1.0))
            # Cache into profiles.json
            with config_lock:
                cfg = load_config()
                if pname in cfg.get("profiles", {}):
                    cfg["profiles"][pname]["last_quota"] = parsed
                    save_config(cfg)
            return parsed
    except Exception as e:
        # Return cached if network failed
        cfg = load_config()
        return cfg.get("profiles", {}).get(pname, {}).get("last_quota")

# ---- 双层流水线调度目标函数 (2026-09-28 架构重构) ----
WINDOW_5H_H   = 5.0     # 5h 池窗口长度（小时）
WINDOW_WEEK_H = 168.0   # 周池窗口长度（小时）
MIN_USABLE    = 0.02    # 余量 <= 此值视为不可用

def calculate_priority_score(quota: Optional[Dict[str, Any]], cooldown_until: float = 0, today_tokens: int = 0) -> float:
    """
    账号调度评分 (0.0 ~ 100.0)。

    [2026-09-28 双层流水线重构] 目标：**兼顾即时吞吐能力、临期冲刺与防饥饿错峰**。
    解决 2026-09-23 单向「作废压力」导致的冷号饥饿死锁、5h限流倒挂与429颠簸问题。

    评分维度：
      1. 5h 即时吞吐能力 (0 ~ 40分): 满血40分。5h<20%时扣分防429。5h是滑动回血池，非作废资产。
      2. 周额度日均充裕度 (0 ~ 40分): 周余量 / 剩余周天数。闲置越久充裕度越高，自然激活冷号。
      3. 临期强力冲刺 (Burn Bonus):
         - <=24h 且 gweek>=MIN_USABLE(0.02): +35分（抢救即将作废的残余额度，稳坐第一名打空）
         - <=48h 且 gweek>=0.10: +15分（临期优先加速消耗）
         - >3.5天 且 gweek<0.15: -20分（远期透支保护，留作后几天应急）
      4. 单日负载均衡与防风控衰减:
         - 今日Token > 1亿: -15分；> 5000万: -8分。
         促使流量平摊、让重度使用的账号静置享受 5h 滑动回血，避免单号高频风控。
    """
    if not quota:
        return 0.0
    if cooldown_until > time.time():
        return 0.0
    g5h = quota.get("gemini_5h", 0.0)
    gweek = quota.get("gemini_weekly", 0.0)
    if gweek <= MIN_USABLE or g5h <= 0.0:
        return 0.0

    # 1. 5h 即时吞吐能力 (0 ~ 40分)
    score_5h = float(g5h) * 40.0
    if g5h < 0.20:
        # 低于 20% 时处于 429 易崩区，额外扣减
        score_5h = max(0.0, score_5h - 15.0)

    # 2. 周额度日均充裕度 (0 ~ 40分)
    now = datetime.now(timezone.utc)
    reset_weekly = quota.get("reset_weekly")
    hours_to_reset = WINDOW_WEEK_H
    if reset_weekly:
        try:
            target = datetime.fromisoformat(reset_weekly.replace("Z", "+00:00"))
            diff = (target - now).total_seconds() / 3600.0
            if diff > 0:
                hours_to_reset = diff
            else:
                hours_to_reset = 0.1
        except Exception:
            pass

    days_to_reset = max(0.05, hours_to_reset / 24.0)
    week_fraction_left = max(0.005, min(1.0, hours_to_reset / WINDOW_WEEK_H))
    allowance_rate = float(gweek) / week_fraction_left
    score_week = min(2.0, allowance_rate) * 20.0  # 0 ~ 40分

    # 3. 临期冲刺红利 (Burn Bonus) vs 远期透支保护
    adjustment = 0.0
    if hours_to_reset <= 24.0 and gweek >= MIN_USABLE:
        # 不足 24 小时即将重置，不烧即废，最高级别优先抢跑打空
        adjustment += 35.0
    elif hours_to_reset <= 48.0 and gweek >= 0.10:
        # 不足 48 小时且余量充足，适度优先冲刺
        adjustment += 15.0
    elif days_to_reset > 3.5 and gweek < 0.15:
        # 还有大半周但周额度严重透支，降权保护留作应急
        adjustment -= 20.0

    # 4. 单日负载均衡与防风控衰减
    if today_tokens > 100_000_000:
        adjustment -= 15.0
    elif today_tokens > 50_000_000:
        adjustment -= 8.0

    total = max(0.0, min(100.0, score_5h + score_week + adjustment))
    return round(total, 1)

def get_ranked_profiles(include_paused: bool = False) -> List[Tuple[str, float, Dict[str, Any]]]:
    cfg = load_config()
    return _rank_profiles_from_cfg(cfg, include_paused=include_paused)

# ----------------------------------------------------------------------
# Local Reverse Proxy Gateway (Daemon)
# ----------------------------------------------------------------------

class _UpstreamBodyIncomplete(Exception):
    """声明了长度或 chunked 的响应体没有读全，且还没写给客户端。"""


class _ClientBodyTruncated(Exception):
    """[2026-10-26 R23] 客户端的请求体没收全（EOF / socket 超时 / 畸形 chunk）。

    ⚠ 绝不能「收到多少算多少」往下转发：我们会给半截体补一个**合法**的
    Content-Length 发给上游，Google 回 400，而 agy 看到的是自己没写坏的请求被
    网关弄坏了 —— 这种形态排障时根本想不到是这里。抛出后由外层给显式 502。
    """


def _response_framing(resp):
    """响应头到达时记下帧。返回 (Content-Length 或 None, 是否 chunked)。"""
    expected = None
    for k, v in resp.getheaders():
        if k.lower() != "content-length":
            continue
        try:
            n = int(v)
        except (TypeError, ValueError):
            n = None
        if n is not None and n >= 0:
            expected = n
        break
    return expected, bool(getattr(resp, "chunked", False))


def _body_complete(expected, is_chunked, resp, resp_bytes, read_error) -> bool:
    """自己核对声明长度。不能靠收尾 read() 会不会抛 IncompleteRead。

    Python 3.9：read1() 在 Content-Length 没读完就遇到 EOF 时把 fp 置 None、
    不抛异常，resp.length 仍 > 0；随后 read() 见 fp 已空，返回 b'' 也不抛。
    chunked 也不能看 `not resp.chunked`：3.9 在 begin() 把 chunked 置 True 后
    永不清除。终止块（size 0）会把 chunk_left 置 None 并关掉 fp；中途截断则
    read1 抛 IncompleteRead。
    """
    if read_error:
        return False
    if expected is not None and resp_bytes == expected:
        return True
    if (is_chunked
            and getattr(resp, "fp", "missing") is None
            and getattr(resp, "chunk_left", "missing") is None):
        return True
    return False


class GatewayProxyHandler(http.server.BaseHTTPRequestHandler):
    # [2026-10-26 R20] 对 agy 一侧的 socket 时限，见 CLIENT_SOCKET_TIMEOUT_SEC。
    # 3.9 的 handle_one_request 捕获 socket.timeout 后只记一行并关连接，
    # 不会补发错误页；我们自己的 try/except 在它之前先兜住，`_inflight` 因此在
    # finally 里必然减回去。
    timeout = CLIENT_SOCKET_TIMEOUT_SEC

    def do_GET(self):
        self.handle_gateway_request()

    def do_POST(self):
        self.handle_gateway_request()

    def do_PUT(self):
        self.handle_gateway_request()

    def do_DELETE(self):
        self.handle_gateway_request()

    def handle_gateway_request(self):
        # 1. Internal Management API
        if self.path.startswith("/_agyp/"):
            # [2026-10-26 R15] 管理面也纳入同一道闸。原来在 try 之前 return，
            # 参数解析/序列化一抛出就穿过 BaseHTTPRequestHandler 直接关连接 ——
            # 客户端（脚本、看门狗）看到的是 RemoteDisconnected 而不是一条 502。
            # 它不改账号状态、不走上游，所以只包闸、不进在途计数。
            try:
                self.handle_management_api()
            except Exception as e:
                self._fatal_guard(e)
            return
        # [2026-10-26] 在途计数：restart 前判断有没有活口，看板也要用
        _inflight.inc()
        try:
            self._proxy_request()
        except Exception as e:
            # C7：转发之前的任何意外异常都不得让客户端只看到裸 EOF。
            # 这一段是无保护的输入解析（`int(Content-Length)`、chunked 解码、
            # 会话键正则、缓存取值），任意一处抛出都会穿过 BaseHTTPRequestHandler
            # 直接关连接 —— 而那正是 §P3 / 2026-09-20 花力气消灭掉的读数形态。
            self._fatal_guard(e)
        finally:
            _inflight.dec()

    def send_response_only(self, code, message=None):
        # 状态行进入 _headers_buffer —— 此刻**还没有一个字节落到 socket**
        self._agyp_buffered = True
        return super().send_response_only(code, message)

    def end_headers(self):
        # 这里才是「客户端已经收到东西」的真界限（3.9 的 end_headers 把缓冲区一次性 flush）
        self._agyp_responded = True
        return super().end_headers()

    def _fatal_guard(self, exc: BaseException) -> None:
        """未预期异常的收口：没发过响应就补一条显式 502 + JSON；已经发过则只记账。"""
        responded = bool(getattr(self, "_agyp_responded", False))
        buffered = bool(getattr(self, "_agyp_buffered", False))
        try:
            import traceback as _tb
            tb = "".join(_tb.format_exception(type(exc), exc, exc.__traceback__))
        except Exception:
            tb = ""
        try:
            self.log_message(
                "FATAL-EXCEPT %s responded=%s buffered=%s err=%s",
                self.path, responded, buffered, f"{type(exc).__name__}: {exc}")
            if tb:
                self.log_message("FATAL-TRACEBACK %s", tb.strip()[:4000])
        except Exception:
            pass
        if responded:
            # 字节已经出去了，再写 502 只会把响应污染成两段状态行
            return
        if isinstance(exc, (BrokenPipeError, ConnectionResetError)):
            return                        # 客户端已经走了，补包没有意义
        if buffered:
            # 只写了缓冲区：丢掉那条半成品状态行，客户端看到的仍是一条干净的 502
            try:
                self._headers_buffer = []
            except Exception:
                return
        try:
            self.send_json_response(502, {
                "error": "agyp_gateway_internal_error",
                "message": "网关在处理该请求时抛出未预期异常，请求未送达上游。"
                           "详情见 ~/.agyp/gateway.log 的 FATAL-TRACEBACK。",
                "path": self.path,
                "last_error": f"{type(exc).__name__}: {exc}",
                "hint": "agyp daemon restart 重启网关；回滚见 README § 文件架构映射的备份清单。",
            })
        except Exception:
            pass                          # 连 502 都写不出去 = 客户端已断，只能留在日志

    def _proxy_request(self):
        # 2. Proxy request to upstream Google Backend
        # [fix-20260912] 支持 chunked 请求体：agy(Go) 对大请求用 TE:chunked 流式发送，
        # 此时没有 Content-Length，之前直接 req_body=None → 转发空 body → Google 400
        te = (self.headers.get("Transfer-Encoding") or "").lower()
        t_enter = time.monotonic()
        if "chunked" in te:
            req_body = self._read_chunked_body()
        else:
            length = int(self.headers.get("Content-Length", 0))
            req_body = self.rfile.read(length) if length > 0 else None
            # `BufferedReader.read(n)` 只在 EOF 时短还 ⇒ 短还 = 客户端提前断了。
            # 半截体当完整体转发 = 我们替它补一个合法 CL，上游 400，客户端一头雾水。
            if req_body is not None and len(req_body) != length:
                raise _ClientBodyTruncated(
                    f"客户端只送了 {len(req_body)}/{length}B（Content-Length 未读满）")
        t_body = time.monotonic()

        clean_path = self.path.split("?")[0]

        # [2026-10-26] 可选：丢弃 agy 的轨迹遥测上传（三天 181 次 / 251MB 上行）。
        # 默认关闭 —— 上游是否要求该写回成功没验证过，不在生产链路上默认赌。
        if DROP_TELEMETRY and clean_path in TELEMETRY_PATHS:
            self.send_json_response(200, {})
            record_latency({"path": clean_path, "method": self.command,
                            "req_bytes": len(req_body) if req_body else 0,
                            "chunked": "chunked" in te, "profile": "-",
                            "attempt": 1, "status": 200, "err": None,
                            "head_ms": 0.0, "first_ms": 0.0, "stream_ms": 0.0,
                            "total_ms": round((time.monotonic() - t_enter) * 1000, 1),
                            "resp_bytes": 2, "dropped": True})
            return

        # [2026-10-26] 会话粘性：该会话若被自动容灾绑定过账号就沿用，保住它的 prompt cache。
        # 绑定是机器决策（不是用户决策），所以它一旦落在 cooldown 账号上就作废、回落到全局默认；
        # 全局默认本身仍按原语义使用（含用户显式 switch 到一个刚 429 的账号），由容灾循环兜底。
        cfg_now = load_config()
        session_key = extract_session_key(req_body)
        # 显式 /_agyp/switch 或暂停操作会递增 epoch。本请求之后的 bind 必须带上这个采样，
        # 否则切号清表之后，迟到的容灾 bind 会把会话写回去。
        bind_epoch = _session_bind.epoch()
        sticky_p = _session_bind.get(session_key)
        if sticky_p and (profile_in_cooldown(sticky_p) or is_profile_paused(sticky_p, cfg_now)):
            _session_bind.drop(session_key)
            sticky_p = None
        active_p = sticky_p or cfg_now.get("active_profile") or ""
        if is_profile_paused(active_p, cfg_now) or not active_p:
            ranked = _rank_profiles_from_cfg(cfg_now, include_paused=False)
            enabled = [p for p, _s, _i in ranked] or enabled_profiles(cfg_now)
            if enabled:
                active_p = enabled[0]
                if not sticky_p:
                    set_active_profile_name(active_p)

        # [2026-10-26] 静态元数据缓存命中 = 本地回包，连 token 刷新都不用做。
        ttl = None if CACHE_DISABLE else META_CACHE_TTL.get(clean_path)
        if ttl is not None and not is_profile_paused(active_p, cfg_now):
            body_dg = _body_digest(req_body)
            hit = _meta_cache.get(self.command, self.path, active_p, body_dg)
            if hit is not None:
                self.send_cached_response(*hit)
                record_latency({
                    "path": clean_path, "method": self.command,
                    "req_bytes": len(req_body) if req_body else 0,
                    "chunked": "chunked" in te, "profile": active_p,
                    "attempt": 1, "status": hit[0], "err": None,
                    "head_ms": 0.0, "first_ms": 0.0, "stream_ms": 0.0,
                    "total_ms": round((time.monotonic() - t_enter) * 1000, 1),
                    "resp_bytes": len(hit[2]), "cache": "HIT",
                    "session": session_key, "sticky": bool(sticky_p),
                })
                return

        token = None if is_profile_paused(active_p, cfg_now) else refresh_token_for_profile(active_p)
        if not token:
            # Fallback to any healthy enabled profile (never a paused profile)
            ranked = _rank_profiles_from_cfg(cfg_now, include_paused=False)
            cand = ranked[0][0] if (ranked and ranked[0][1] > 0) else None
            if not cand:
                en = enabled_profiles(cfg_now)
                cand = en[0] if en else None
            if cand and not is_profile_paused(cand, cfg_now):
                active_p = cand
                _session_bind.bind(session_key, active_p, epoch=bind_epoch)
                if not sticky_p:
                    set_active_profile_name(active_p)
                token = refresh_token_for_profile(active_p)
        t_token = time.monotonic()

        # body_ms = 收完 agy 上传的请求体；token_ms = 取/刷新 access token（含 OAuth 往返）
        self._lat = {
            "path": clean_path,
            "method": self.command,
            "req_bytes": len(req_body) if req_body else 0,
            "chunked": "chunked" in te,
            "body_ms": round((t_body - t_enter) * 1000, 1),
            "token_ms": round((t_token - t_body) * 1000, 1),
            "profile": active_p,
            "session": session_key,
            "sticky": bool(sticky_p),
        }
        self.forward_with_failover(active_p, token, req_body, session_key=session_key,
                                   bind_epoch=bind_epoch)

    def _read_chunked_body(self) -> Optional[bytes]:
        """按 RFC 7230 解码 chunked 请求体（含 trailer 段）。

        ⚠ [2026-10-26 R23] 只有「读到终止 chunk」才返回。旧写法三处会把半截体当完整体
        交出去：EOF 时 `if not part: return 已收部分`、任何异常 `except Exception: pass`
        后 `return 已收部分`、畸形长度行 `break` 后 `return 已收部分`。R20 给客户端一侧
        加了 socket 时限之后，第三条路径（超时被 pass 掉）从「理论」变成「日常」，
        所以这条必须一起收口：一律抛 _ClientBodyTruncated，由外层显式 502。
        顺带修掉 `if not size_line: continue` 的死循环：`readline()` 在客户端 EOF 后
        **立刻**返回 b''（没有 syscall，socket 时限管不到），于是空转把 handler 线程
        和 `_inflight` 计数永久钉死。EOF 就是 EOF，直接判截断。
        """
        chunks = []
        try:
            while True:
                raw = self.rfile.readline(65536)
                if not raw:
                    raise _ClientBodyTruncated(
                        f"客户端在终止 chunk 之前断了（已收 {sum(map(len, chunks))}B）")
                size_line = raw.strip()
                if not size_line:
                    continue                # chunk 之间的空行（含 trailer 段前的 CRLF）
                try:
                    size = int(size_line.split(b";")[0], 16)
                except ValueError:
                    raise _ClientBodyTruncated(
                        f"畸形 chunk 长度行 {size_line[:24]!r}") from None
                if size == 0:
                    while True:             # 消费 trailer 直到空行/EOF
                        line = self.rfile.readline(65536)
                        if line in (b"\r\n", b"\n", b""):
                            break
                    return b"".join(chunks) or None      # 正常收尾，体是完整的
                data = b""
                while len(data) < size:
                    part = self.rfile.read(size - len(data))
                    if not part:
                        raise _ClientBodyTruncated(
                            f"chunk 内 EOF：{len(data)}/{size}B")
                    data += part
                chunks.append(data)
                self.rfile.read(2)          # chunk 后的 CRLF
        except OSError as e:                # 含 socket.timeout / ConnectionReset / EPIPE
            raise _ClientBodyTruncated(
                f"读客户端请求体失败：{type(e).__name__}: {e}") from e

    def _check_mgmt_security(self, mutating: bool = False) -> bool:
        """校验管理面 Origin 与可选 AGYP_ADMIN_TOKEN，防网页跨站 CSRF。"""
        origin = (self.headers.get("Origin") or "").strip()
        if origin and origin != "null":
            allowed = (
                "http://127.0.0.1", "http://localhost", "https://localhost",
                "mygo://", "wails://",
            )
            if not any(origin.startswith(p) for p in allowed):
                self.send_json_response(403, {"status": "error", "message": "Forbidden cross-origin request"})
                return False
        if mutating:
            admin_tok = (os.environ.get("AGYP_ADMIN_TOKEN") or "").strip()
            if admin_tok:
                parsed = urllib.parse.urlparse(self.path)
                qs = urllib.parse.parse_qs(parsed.query)
                req_tok = (self.headers.get("X-Agyp-Token") or qs.get("token", [""])[0] or "").strip()
                if req_tok != admin_tok:
                    self.send_json_response(403, {"status": "error", "message": "Invalid or missing admin token"})
                    return False
        return True

    def _read_json_body(self, max_bytes: int = 1048576) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
        try:
            cl = int(self.headers.get("Content-Length") or "0")
        except Exception:
            return None, "Invalid Content-Length"
        if cl < 0 or cl > max_bytes:
            return None, "Request body too large"
        raw = self.rfile.read(cl) if cl > 0 else b"{}"
        if not raw.strip():
            return {}, None
        try:
            obj = json.loads(raw.decode("utf-8"))
            if not isinstance(obj, dict):
                return None, "JSON body must be an object"
            return obj, None
        except Exception as e:
            return None, f"Invalid JSON: {e}"

    def handle_management_api(self):
        parsed = urllib.parse.urlparse(self.path)
        qs = urllib.parse.parse_qs(parsed.query)

        mutating = (
            parsed.path in (
                "/_agyp/switch", "/_agyp/pause", "/_agyp/resume", "/_agyp/only",
                "/_agyp/profile/add", "/_agyp/profile/remove",
                "/_agyp/profile/rename", "/_agyp/profile/reload",
            )
            or (parsed.path == "/_agyp/cache" and qs.get("clear", [None])[0] == "1")
            or (parsed.path == "/_agyp/pool" and qs.get("drop", [None])[0] == "1")
        )
        if not self._check_mgmt_security(mutating=mutating):
            return

        if parsed.path == "/_agyp/status":
            active_p = get_active_profile_name()
            cfg = load_config()
            resp_data = {
                "status": "online",
                "active_profile": active_p,
                "email": cfg.get("profiles", {}).get(active_p, {}).get("email"),
                "paused_profiles": paused_profiles(cfg),
                "enabled_profiles": enabled_profiles(cfg),
                "timestamp": datetime.now(timezone.utc).isoformat(),
                # [2026-09-23] 自报代码版本：调用方拿 code_mtime 与磁盘当前 mtime 比对，
                # 即可判断这个常驻进程是否还在跑旧代码（不依赖 ps）。
                "pid": os.getpid(),
                "started_at": _DAEMON_STARTED_AT,
                "code_mtime": _DAEMON_CODE_MTIME,
                # [2026-10-26] 会话粘性下「全局默认」不再等于「谁在服务」，一并暴露实况
                "sessions_bound": _session_bind.snapshot().get("count", 0),
            }
            self.send_json_response(200, resp_data)
        elif parsed.path == "/_agyp/switch":
            target = qs.get("profile", [None])[0]
            if target and target in all_profiles():
                auto_resumed = set_active_profile_name(target, unpause=True)
                # 显式切号 = 用户意志，优先于任何自动容灾留下的会话绑定：
                # 清掉全部会话绑定，让所有窗口下一次请求都落到目标账号。
                cleared = _session_bind.clear()
                self.send_json_response(200, {
                    "status": "ok",
                    "switched_to": target,
                    "auto_resumed": auto_resumed,
                    "sessions_rebound": cleared,
                })
            else:
                self.send_json_response(400, {"status": "error", "message": "Invalid profile"})
        elif parsed.path in ("/_agyp/pause", "/_agyp/resume"):
            all_flag = qs.get("all", [None])[0]
            target = qs.get("profile", [None])[0]
            if parsed.path == "/_agyp/resume" and (all_flag == "1" or target == "all"):
                ok, err_msg, snap = resume_all_profiles()
                self.send_json_response(200, {"status": "ok", **snap})
                return
            if parsed.path == "/_agyp/pause" and all_flag == "0":
                ok, err_msg, snap = resume_all_profiles()
                self.send_json_response(200, {"status": "ok", **snap})
                return
            want_paused = (parsed.path == "/_agyp/pause") and (qs.get("paused", ["1"])[0] not in ("0", "false", "False", "no"))
            if parsed.path == "/_agyp/resume":
                want_paused = False
            if not target:
                self.send_json_response(400, {"status": "error", "message": "Missing profile"})
                return
            ok, err_msg, snap = set_profile_paused(target, want_paused)
            if not ok:
                self.send_json_response(400, {"status": "error", "message": err_msg})
                return
            if want_paused:
                _conn_pool.drop(target)
                _meta_cache.clear(target)
                if snap.get("active_changed"):
                    _session_bind.clear()
                else:
                    _session_bind.drop_profile(target)
            self.send_json_response(200, {"status": "ok", **snap})
        elif parsed.path == "/_agyp/only":
            target = qs.get("profile", [None])[0]
            if not target:
                self.send_json_response(400, {"status": "error", "message": "Missing profile"})
                return
            ok, err_msg, snap = set_only_profile(target)
            if not ok:
                self.send_json_response(400, {"status": "error", "message": err_msg})
                return
            _session_bind.clear()
            for p in snap.get("paused_profiles") or []:
                _conn_pool.drop(p)
                _meta_cache.clear(p)
            self.send_json_response(200, {"status": "ok", **snap})
        elif parsed.path == "/_agyp/profile/add":
            body, berr = self._read_json_body()
            if berr:
                self.send_json_response(400, {"status": "error", "message": berr})
                return
            mode = str(body.get("mode") or "refresh_token").strip().lower()
            name = str(body.get("name") or "").strip()
            email = str(body.get("email") or "").strip()
            overwrite = bool(body.get("overwrite", False))
            verify = bool(body.get("verify", True))
            if mode == "keychain":
                creds, kerr = read_keychain_credentials()
                if not creds:
                    self.send_json_response(400, {"status": "error", "message": kerr or "读取钥匙串失败"})
                    return
                ok, err_msg, snap = upsert_profile(
                    name,
                    refresh_token=creds["refresh_token"],
                    access_token=creds.get("access_token", ""),
                    expires_at=creds.get("expires_at", 0.0),
                    email=email,
                    overwrite=overwrite,
                    verify=verify,
                )
            else:
                rt = str(body.get("refresh_token") or "").strip()
                ok, err_msg, snap = upsert_profile(
                    name,
                    refresh_token=rt,
                    access_token=str(body.get("access_token") or ""),
                    expires_at=float(body.get("expires_at") or 0.0),
                    email=email,
                    overwrite=overwrite,
                    verify=verify,
                )
            if not ok:
                self.send_json_response(400, {"status": "error", "message": err_msg})
                return
            _conn_pool.drop(name)
            _meta_cache.clear(name)
            self.send_json_response(200, {"status": "ok", **snap})
        elif parsed.path == "/_agyp/profile/remove":
            body, berr = self._read_json_body()
            if berr:
                self.send_json_response(400, {"status": "error", "message": berr})
                return
            name = str(body.get("name") or qs.get("name", [""])[0] or "").strip()
            force = bool(body.get("force", False))
            ok, err_msg, snap = remove_profile(name, force=force)
            if not ok:
                self.send_json_response(400, {"status": "error", "message": err_msg})
                return
            _conn_pool.drop(name)
            _meta_cache.clear(name)
            if snap.get("active_changed"):
                _session_bind.clear()
            else:
                _session_bind.drop_profile(name)
            self.send_json_response(200, {"status": "ok", **snap})
        elif parsed.path == "/_agyp/profile/rename":
            body, berr = self._read_json_body()
            if berr:
                self.send_json_response(400, {"status": "error", "message": berr})
                return
            old_name = str(body.get("old_name") or "").strip()
            new_name = str(body.get("new_name") or "").strip()
            ok, err_msg, snap = rename_profile(old_name, new_name)
            if not ok:
                self.send_json_response(400, {"status": "error", "message": err_msg})
                return
            _conn_pool.drop(old_name)
            _meta_cache.clear(old_name)
            _session_bind.drop_profile(old_name)
            self.send_json_response(200, {"status": "ok", **snap})
        elif parsed.path == "/_agyp/profile/reload":
            body, _ = self._read_json_body()
            prof = str((body or {}).get("profile") or qs.get("profile", [""])[0] or "").strip() or None
            _conn_pool.drop(prof)
            _meta_cache.clear(prof)
            if prof:
                _session_bind.drop_profile(prof)
            else:
                _session_bind.clear()
            snap = _pause_snapshot_from_cfg(load_config())
            self.send_json_response(200, {"status": "ok", **snap})
        elif parsed.path == "/_agyp/quota":
            cfg = load_config()
            quotas = {p: cfg.get("profiles", {}).get(p, {}).get("last_quota") for p in all_profiles()}
            tiers = {p: cfg.get("profiles", {}).get(p, {}).get("tier") for p in all_profiles()}
            self.send_json_response(200, {
                "active_profile": get_active_profile_name(),
                "paused_profiles": paused_profiles(cfg),
                "enabled_profiles": enabled_profiles(cfg),
                "quotas": quotas,
                "tiers": tiers,
            })
        elif parsed.path == "/_agyp/diag":
            cfg = load_config()
            # 实时看板（agyp live）与排查用：连接池 / 缓存 / 会话 / 在途请求
            self.send_json_response(200, {
                "pid": os.getpid(),
                "code_mtime": _DAEMON_CODE_MTIME,
                "started_at": _DAEMON_STARTED_AT,
                "active_profile": cfg.get("active_profile") or "",
                "paused_profiles": paused_profiles(cfg),
                "enabled_profiles": enabled_profiles(cfg),
                "pool": _conn_pool.snapshot(),
                "cache": _meta_cache.snapshot(),
                "sessions": _session_bind.snapshot(),
                "inflight": _inflight.count(),
                "config_load_error": config_load_error,
            })
        elif parsed.path == "/_agyp/cache":
            if qs.get("clear", [None])[0] == "1":
                prof = qs.get("profile", [None])[0]
                self.send_json_response(200, {"status": "ok", "cleared": _meta_cache.clear(prof)})
            else:
                self.send_json_response(200, _meta_cache.snapshot())
        elif parsed.path == "/_agyp/pool":
            if qs.get("drop", [None])[0] == "1":
                prof = qs.get("profile", [None])[0]
                self.send_json_response(200, {"status": "ok", "dropped": _conn_pool.drop(prof)})
            else:
                self.send_json_response(200, _conn_pool.snapshot())
        elif parsed.path == "/_agyp/sessions":
            self.send_json_response(200, _session_bind.snapshot())
        else:
            self.send_json_response(404, {"error": "not found"})

    def record_upstream_latency(self, profile: str, attempt: int, status: Optional[int],
                                t0: float, t_head: Optional[float], t_first: Optional[float],
                                t_end: float, resp_bytes: int, model: Optional[str] = None,
                                p_tok: Optional[int] = None, c_tok: Optional[int] = None,
                                t_tok: Optional[int] = None, cache_tok: Optional[int] = None,
                                err: Optional[str] = None, pool: Optional[str] = None,
                                retry: Optional[int] = None, retrying: bool = False) -> None:
        """一次上游跳转的分段耗时。

        [2026-10-26] 换掉 urllib 后 **head_ms 终于拆得开了**：10-23 那条
        「urllib 不暴露请求体写完的时刻，写上游/上游 prefill/首响应三段不可分」的限制
        随 http.client 一起消失 —— conn.request() 返回 = 请求体已交给出站 socket，
        记为 up_ms，剩下的 head_ms-up_ms 就是「上游 prefill + 首响应往返」。
        """
        base = getattr(self, "_lat", None) or {}
        rec = dict(base)
        t_sent = getattr(self, "_t_sent", None)
        stream_start = t_first if t_first is not None else t_head
        rec.update({
            "profile": profile,
            "attempt": attempt,
            "status": status,
            "err": err,
            "up_ms": round((t_sent - t0) * 1000, 1) if t_sent is not None else None,
            "head_ms": round((t_head - t0) * 1000, 1) if t_head is not None else None,
            "first_ms": round((t_first - t0) * 1000, 1) if t_first is not None else None,
            "stream_ms": round((t_end - stream_start) * 1000, 1) if stream_start is not None else None,
            "total_ms": round((t_end - t0) * 1000, 1),
            "resp_bytes": resp_bytes,
            "model": model,
            "p_tok": p_tok,
            "c_tok": c_tok,
            "t_tok": t_tok,
            "cache_tok": cache_tok,
            "pool": pool,
            "retry": retry,
        })
        if retrying:
            rec["retrying"] = True
        record_latency(rec)

    # 入站 hop-by-hop / 帧控头剥离表（§P1 修 502 的那份，**本次改造一个字都不碰**）。
    # agy(Go) 用 Transfer-Encoding: chunked 流式发大 body，原样转发会让 Google 收到
    # TE+CL 冲突帧直接 502；出站由 http.client 按 body 自己设 Content-Length。
    HOP_HEADERS = ["host", "authorization", "proxy-connection", "accept-encoding",
                   "transfer-encoding", "content-length", "connection", "keep-alive",
                   "expect", "te", "trailer", "upgrade"]

    def build_outbound_headers(self, token: str) -> Dict[str, str]:
        headers = {}
        for k, v in self.headers.items():
            if k.lower() not in self.HOP_HEADERS:
                headers[k] = v
        # Authorization 逐请求注入：同一次客户端请求今天就在跨账号跑，隧道本身不携带身份
        headers["Authorization"] = f"Bearer {token}"
        headers["Host"] = UPSTREAM_HOST
        return headers

    def _send_request_body(self, conn, headers: Dict[str, str],
                           req_body: Optional[bytes]) -> None:
        """发请求头，然后按**真实进度**判死活着把请求体写完。

        ⚠ 出站帧与 `conn.request(body=bytes)` 逐字节等价：Content-Length 由这里写死，
        绝不与 Transfer-Encoding 混写（§P1 那个 502 的形态就是两者同时出现在上游）。
        HOP_HEADERS 已把入站的 content-length / accept-encoding 剥掉，所以这里加上的
        就是唯一的一条 CL；Accept-Encoding 两条路径都是 `identity`（3.9 的
        `send_extra` 对 http/https 都发 identity，旧 urllib 路径也是 identity），
        不存在「改造后变成 gzip 上行」这种事。

        [2026-10-26 R22] 为什么不是「每块 sendall + 45s 时限」：`socket.settimeout(T)`
        对 `sendall()` 是**这一块的累计时限**，不是「无进展 T」（§P7 实测钉过）。
        于是 45s 一块在争抢的上行管道上等于「这条管道 45s 内送不完 256KB 就判死」，
        而 17:00–17:10 的 5 条终端 502 全是这个形态：
            17:01:01 ms=45013 已送出 70%   17:05:14 ms=47951 已送出 92%
            17:00:09 ms=49225 已送出 93%   17:10:16 ms=48892 已送出 91%
        差 7%–30% 没送完就被判死；换成整段重发会把同一条堵死的管道再烧一遍（R18 的
        进度闸因此不放行）⇒ 客户端拿到 502，而 10-23 那版「整段 90s 绝对上限」反而
        能让它磨完。**这就是 10-26 生成侧变负向的直接原因。**
        改成 `sock.send()` 循环 + 2s 轮询：只要内核还在收字节就算有进展，
        「进展间隔」超过 UPSTREAM_SEND_STALL_SEC（= 真的一个字节都没进去）才判死。
        活但慢 ⇒ 一直传；隧道真死 ⇒ 还是 45s 内暴露。

        ⚠ 但**必须按 TLS 记录大小切着喂**（`UPSTREAM_SEND_RECORD_BYTES`），不能一次
        `send(整段 6.6MB)`：`SSLSocket.send()` 不是 plain socket 的语义 —— 它在底层
        socket 写不动时抛 `SSLWantWriteError`，**不返回已写计数**。整段一喂，前面几十
        个 16KB 记录其实已经进内核了，可这次调用一个计数都不给我 ⇒ 进展判定退化成
        「45s 内有没有一次 send() 完整成功」，又是一次「把累计语义当进展」的同款错误。
        17:43–17:44 上线后头两条 502 就是这个读数：`no byte accepted for 45s at
        0/6606754B`（0 字节 ≠ 真的 0 字节）。按 ≤16KB 一片送，每次成功就是一片，
        计数与真实排空对齐；卡在一片上 = 45s 连 16KB（≈0.4KB/s）都送不进去，那才是真死。
        """
        if not req_body:
            conn.request(self.command, self.path, body=None, headers=headers)
            return
        h = dict(headers)
        h["Content-Length"] = str(len(req_body))
        conn.request(self.command, self.path, body=None, headers=h)
        if conn.sock is None:
            raise ConnectionError("upstream socket disappeared before body send")
        mv = memoryview(req_body)
        total = len(mv)
        sent = 0
        self._send_progress = (0, total)
        t_start = time.monotonic()
        t_progress = t_start
        while sent < total:
            now = time.monotonic()
            if now - t_start > UPSTREAM_SEND_TOTAL_SEC:
                raise socket.timeout(
                    f"send cap {UPSTREAM_SEND_TOTAL_SEC:.0f}s after {sent}/{total}B")
            if now - t_progress > UPSTREAM_SEND_STALL_SEC:
                raise socket.timeout(
                    f"no byte accepted for {UPSTREAM_SEND_STALL_SEC:.0f}s "
                    f"at {sent}/{total}B")
            conn.sock.settimeout(UPSTREAM_SEND_POLL_SEC)
            try:
                n = conn.sock.send(mv[sent:sent + UPSTREAM_SEND_RECORD_BYTES])
            except (socket.timeout, ssl.SSLWantWriteError, BlockingIOError):
                continue                    # 这一次轮询没写进去，看进展间隔再决定
            except OSError as e:            # 底层 EAGAIN 被 _ssl 包成 SSLError 的情形
                if getattr(e, "errno", None) in (errno.EAGAIN, errno.EWOULDBLOCK,
                                                 errno.EINPROGRESS):
                    continue
                raise
            if n > 0:
                sent += n
                t_progress = time.monotonic()
                self._send_progress = (sent, total)

    def _is_generation_request(self) -> bool:
        p = (getattr(self, "_lat", None) or {}).get("path", "")
        return "enerateContent" in p

    def build_attempt_order(self, active_p: str) -> List[str]:
        # [2026-09-23] 兜底顺序按调度评分排序（旧实现走 profiles.json 键顺序，与评分无关）。
        # [2026-11-25] 严格过滤 paused 账号；若仅 1 个账号启用，仅尝试该账号，绝不触发跨号容灾。
        cfg = load_config()
        enabled = enabled_profiles(cfg)
        enabled_set = set(enabled)
        try:
            ranked = [p for p, _s, _i in _rank_profiles_from_cfg(cfg, include_paused=False) if p in enabled_set]
        except Exception:
            ranked = []
        order: List[str] = []
        if active_p in enabled_set:
            order.append(active_p)
        for p in ranked:
            if p not in order:
                order.append(p)
        for p in enabled:
            if p not in order:
                order.append(p)
        return order

    def forward_with_failover(self, active_p: str, token: str, req_body: Optional[bytes],
                              session_key: Optional[str] = None,
                              bind_epoch: Optional[int] = None):
        """转发 + 容灾主循环。

        内层 `continue` = 同账号换连接重试；`break` = 换下一个账号；`return` = 已应答客户端。

        [2026-10-26] 这次改造要解决的是：旧版 transport 异常分支直接回 502 且**零重试**
        （三天 2953 条失败全部 attempt=1，占全部流量 16%；同期 429 只有 2 条，
        即原有容灾覆盖的是 0.01% 的流量）。现在传输层错误也走「换连接重试 → 换账号 → 
        最后才 502」，且 502 带 JSON 诊断而不是裸文本。
        """
        attempt_profiles = self.build_attempt_order(active_p)
        path = (getattr(self, "_lat", None) or {}).get("path", "")
        is_gen = "enerateContent" in path
        # 只有这份只读名单可以短超时 + 失败重发。生成和写接口不在其中。
        idempotent = (not is_gen) and path in IDEMPOTENT_META_PATHS
        max_retry = TRANSPORT_RETRY_LIMIT_META if idempotent else TRANSPORT_RETRY_LIMIT_GEN
        t_budget_start = time.monotonic()
        last_exc: Optional[str] = None
        last_exc_obj: Optional[BaseException] = None
        attempts_log: List[Dict[str, Any]] = []
        status_failovers: Dict[int, int] = collections.defaultdict(int)
        total_failovers = 0

        for p_idx, current_p in enumerate(attempt_profiles):
            cur_token = token if current_p == active_p else refresh_token_for_profile(current_p)
            if not cur_token:
                continue
            headers = self.build_outbound_headers(cur_token)

            for try_i in range(max_retry + 1):
                # 出错的那条连接已被丢弃，重试一定新建：SSLEOFError 的本质是
                # 单条 TLS 会话被切，换一条连接即可恢复，这正是旧版最缺的一步。
                conn, from_pool = _conn_pool.acquire(
                    current_p, UPSTREAM_WRITE_TIMEOUT_SEC, force_new=(try_i > 0))
                t0 = time.monotonic()
                t_head = None
                self._t_sent = None
                self._send_progress = None
                try:
                    self._send_request_body(conn, headers, req_body)
                    # 整段请求体已交给出站 socket。生成/写入从此刻起绝不重发。
                    self._t_sent = time.monotonic()
                    head_to = (UPSTREAM_HEAD_TIMEOUT_META_SEC if idempotent
                               else UPSTREAM_HEAD_TIMEOUT_GEN_SEC)
                    if conn.sock is not None:
                        conn.sock.settimeout(head_to)
                    resp = conn.getresponse()
                    t_head = time.monotonic()
                    # ⚠ will_close 必须在这一刻取走：HTTPResponse 在 body 读尽时会把
                    # 内部 will_close 改写成 True（表示"这条响应结束了"），拿它当
                    # "连接还能不能用"的判据会把每一条好连接都误杀成丢弃。
                    will_close_at_head = bool(getattr(resp, "will_close", True))
                    # 响应头到手，后面是流式读：恢复到宽限的 socket 超时
                    if conn.sock is not None:
                        conn.sock.settimeout(UPSTREAM_WRITE_TIMEOUT_SEC)

                    # ---- 配额耗尽 / 资源限流 / 后端无容量：换候补账号 ----
                    # [2026-11-05] 503 也走这条。Google 的 "No capacity available for
                    # model X on the server" 是按账号返回的（同一分钟、同一份 body 换号
                    # 即 200），旧版把它原样透传给 agy ⇒ 调度榜 #1 的坏号每个请求都撞墙，
                    # CLI 自己重试 8 次全打在同一号上（11-05 13:31→13:56 一次操作烧 25 分钟）。
                    # 503 语义是「服务端没接活」，换号重试是安全的。
                    if resp.status in (429, 403, 503):
                        err_body = self._drain_body(resp)
                        _conn_pool.release(current_p, conn, healthy=False)
                        err_detail = None
                        if err_body:
                            try:
                                ej = json.loads(err_body.decode("utf-8", "ignore"))
                                e_obj = ej.get("error", {})
                                msg = e_obj.get("message", "")
                                reason = ""
                                for det in e_obj.get("details", []):
                                    if isinstance(det, dict) and "reason" in det:
                                        reason = det["reason"]
                                        break
                                if reason and msg:
                                    err_detail = f"{reason}: {msg}"
                                elif reason:
                                    err_detail = reason
                                elif msg:
                                    err_detail = msg
                            except Exception:
                                pass
                        if not err_detail:
                            if resp.status == 503:
                                err_detail = "MODEL_CAPACITY_EXHAUSTED: No capacity available on server"
                            elif resp.status == 429:
                                err_detail = "RESOURCE_EXHAUSTED: Quota exceeded"
                            elif resp.status == 403:
                                err_detail = "PERMISSION_DENIED"

                        self.record_upstream_latency(
                            current_p, p_idx + 1, resp.status, t0, t_head, None, t_head,
                            len(err_body), err=err_detail, pool="pool" if from_pool else "new",
                            retry=try_i)
                        if p_idx < len(attempt_profiles) - 1:
                            # [2026-11-14] 毒丸熔断保护：防连环 429 假限流诱饵与号池连环击穿
                            max_fo = MAX_FAILOVER_CAPACITY if resp.status == 503 else MAX_FAILOVER_QUOTA
                            if status_failovers[resp.status] >= max_fo or total_failovers >= MAX_FAILOVER_TOTAL:
                                sys.stderr.write(
                                    f"\n[agyp-gateway] 🛑 账号 [{current_p}] 同样触发 HTTP {resp.status} "
                                    f"（单请求累计换号达熔断上限：{resp.status} 达 {status_failovers[resp.status] + 1} 次）！"
                                    f"判定为请求体特征或策略级阻断（毒丸熔断），终止号池轮换以保护剩余账号。\n")
                                self.forward_raw_response(resp.status, resp.getheaders(), err_body)
                                return

                            status_failovers[resp.status] += 1
                            total_failovers += 1
                            next_p = self.note_profile_exhausted(current_p, session_key,
                                                                 attempt_profiles[p_idx + 1],
                                                                 resp.status, bind_epoch)
                            reason = "上游无容量" if resp.status == 503 else "配额耗尽"
                            sys.stderr.write(
                                f"\n[agyp-gateway] ⚠️ 账号 [{current_p}] {reason} (HTTP {resp.status})，"
                                f"{'会话 ' + session_key[:18] + ' 已改绑' if session_key else '正在'}"
                                f"至候补账号 [{next_p}]（其余会话不受影响）\n")
                            break          # 换下一个账号
                        self.forward_raw_response(resp.status, resp.getheaders(), err_body)
                        return

                    # ---- 其它状态码（含 2xx 与 4xx/5xx）：原样流式转给客户端 ----
                    if resp.status >= 400:
                        # [diag-20260912] 上游 4xx/5xx 也记日志，避免无迹可查
                        self.log_message("UPSTREAM-ERR %s %s", resp.status, self.path)
                    self.stream_upstream_to_client(resp, conn, current_p, p_idx + 1, t0, t_head,
                                                   from_pool, try_i, req_body, will_close_at_head)
                    return

                except Exception as e:
                    # 无论什么异常，这条连接都不可信，直接丢回池外销毁
                    _conn_pool.release(current_p, conn, healthy=False)
                    last_exc = f"{type(e).__name__}: {e}"
                    last_exc_obj = e
                    elapsed = time.monotonic() - t0

                    # 已经拿到响应头并且字节可能已经写给客户端：不能再重试，也不能补一条 502。
                    # 幂等元数据的截断是在写客户端之前抛出的，允许丢掉重试。
                    client_started = t_head is not None and not isinstance(e, _UpstreamBodyIncomplete)
                    if client_started:
                        self.record_upstream_latency(
                            current_p, p_idx + 1, None, t0, t_head, None, time.monotonic(),
                            0, err=type(e).__name__, pool="pool" if from_pool else "new",
                            retry=try_i)
                        return

                    retryable = isinstance(e, (OSError, http.client.HTTPException,
                                               _UpstreamBodyIncomplete))
                    # 身体已送出的生成/写入：超时、RST、EOF、截断都不重发、不换账号。
                    if self._t_sent is not None and not idempotent:
                        retryable = False
                    # [2026-10-26 R18] 已送出相当比例的请求体 ⇒ 同样不许 from-zero 重发。
                    # 重发的代价是「把同一条已经堵死的上行管道再烧一遍」，而管道饱和正是它
                    # 没送完的原因：16:22–16:35 三条会话各推 6.3MB，13 次重发 0 次送完，
                    # 大家一起活锁。只有几乎没送出（隧道开局即死）时换一条隧道才是净收益。
                    prog = getattr(self, "_send_progress", None)
                    if (retryable and not idempotent and prog and prog[1]
                            and prog[0] / prog[1] > SEND_RETRY_MAX_PROGRESS):
                        retryable = False
                        last_exc = (f"{last_exc} · 已送出 {prog[0] * 100 // prog[1]}%/{prog[1]}B，"
                                    f"超过 {SEND_RETRY_MAX_PROGRESS * 100:.0f}% 不整段重发")
                    over_budget = (time.monotonic() - t_budget_start) > TRANSPORT_BUDGET_SEC
                    attempts_log.append({"profile": current_p, "try": try_i, "err": last_exc,
                                         "ms": round(elapsed * 1000)})

                    if retryable and try_i + 1 <= max_retry and not over_budget:
                        backoff = TRANSPORT_RETRY_BACKOFF_SEC[min(try_i, len(TRANSPORT_RETRY_BACKOFF_SEC) - 1)]
                        self.record_upstream_latency(
                            current_p, p_idx + 1, None, t0, None, None, time.monotonic(), 0,
                            err=type(e).__name__, pool="pool" if from_pool else "new", retry=try_i,
                            retrying=True)
                        self.log_message("TRANSPORT-RETRY %s profile=%s try=%d/%d backoff=%.2fs err=%s",
                                         self.path, current_p, try_i + 1, max_retry, backoff, last_exc)
                        time.sleep(backoff)
                        continue                     # 同账号，换一条新连接再来

                    if (TRANSPORT_FAILOVER_ENABLED and retryable
                            and p_idx < len(attempt_profiles) - 1 and not over_budget):
                        # 同账号重试也没救回来：仅在显式开启容灾开关时换下一个账号（受 MAX_FAILOVER_TOTAL 约束）
                        if total_failovers >= MAX_FAILOVER_TOTAL:
                            self.record_upstream_latency(
                                current_p, p_idx + 1, 502, t0, None, None, time.monotonic(), 0,
                                err=type(e).__name__, pool="pool" if from_pool else "new", retry=try_i)
                            self.give_up_502(req_body, last_exc, attempts_log, exc_obj=e)
                            return
                        total_failovers += 1
                        self.record_upstream_latency(
                            current_p, p_idx + 1, 502, t0, None, None, time.monotonic(), 0,
                            err=type(e).__name__, pool="pool" if from_pool else "new", retry=try_i)
                        _conn_pool.drop(current_p)
                        next_p = attempt_profiles[p_idx + 1]
                        if session_key:
                            _session_bind.bind(session_key, next_p, epoch=bind_epoch)
                        sys.stderr.write(
                            f"[agyp-gateway] ⚠️ 账号 [{current_p}] 出口传输失败 ({type(e).__name__})，"
                            f"已容灾至 [{next_p}]，客户端未感知错误\n")
                        break                        # 换下一个账号

                    # [2026-11-22 优化] 默认行为（TRANSPORT_FAILOVER_ENABLED 为 False）：
                    # 网络传输层异常只在当前账号下重试；重试耗尽后显式返回 502，不顺延换号、不改绑会话，
                    # 彻底保护当前账号的 Prompt Cache 与会话粘性，防止号池连环击穿。
                    self.record_upstream_latency(
                        current_p, p_idx + 1, 502, t0, None, None, time.monotonic(), 0,
                        err=type(e).__name__, pool="pool" if from_pool else "new", retry=try_i)
                    self.give_up_502(req_body, last_exc, attempts_log, exc_obj=e)
                    return

        # 所有账号都试完仍未成功应答。有传输异常 → 显式 502 + JSON 诊断；
        # 否则 = 一个 token 都取不到（[fix-20260920] 的语义：绝不静默 FIN，否则客户端只看到 EOF）。
        if last_exc:
            self.give_up_502(req_body, last_exc, attempts_log, exc_obj=last_exc_obj)
        else:
            self.report_no_usable_token()

    def note_profile_exhausted(self, current_p: str, session_key: Optional[str],
                               next_p: str, status: int,
                               bind_epoch: Optional[int] = None) -> str:
        """配额耗尽 / 上游无容量后的状态收敛：cooldown + 丢弃连接 + 会话改绑 +
        （仅无会话键时）全局默认跟随。"""
        # [2026-11-05] 503 与 429/403 分开计时：前者是后端容量（会自己恢复），
        # 后者是配额窗口。共用 600s 会让一次全局 503 把整池按十分钟。
        cooldown_sec = COOLDOWN_SEC_CAPACITY if status == 503 else COOLDOWN_SEC_QUOTA
        try:
            with config_lock:
                cfg = load_config()
                if current_p in cfg.get("profiles", {}):
                    cfg["profiles"][current_p]["cooldown_until"] = time.time() + cooldown_sec
                    save_config(cfg)
        except Exception:
            pass
        _conn_pool.drop(current_p)
        if is_profile_paused(next_p):
            return current_p
        # [2026-10-26] 会话粘性：只搬走出问题的那个会话，不再把其它窗口的流量一起带走。
        # 元数据请求没有会话键，保持旧语义（改全局默认）。
        if session_key:
            _session_bind.bind(session_key, next_p, epoch=bind_epoch)
        else:
            set_active_profile_name(next_p)
        return next_p

    def _drain_body(self, resp, cap: int = 1024 * 1024) -> bytes:
        """读全上游的错误体（429/403/503 的 detail 就在里面）。

        ⚠ 旧实现 `resp.read(65536)` 只读 64KB 就返回，而 `forward_raw_response` 原样
        转发了上游的 Content-Length ⇒ 客户端拿到「声明 200KB、实到 64KB」的响应，
        Go 报的是 content-length/EOF 传输错误，真正的 quota 原因反而看不见
        （10-23 那版用的就是整读 `e.read()`）。给一个上限是为了不喂无界内存：
        超出部分直接丢弃并显式改写 CL。
        """
        buf = bytearray()
        try:
            while len(buf) < cap:
                part = resp.read(min(65536, cap - len(buf)))
                if not part:
                    break
                buf += part
        except Exception:
            pass
        return bytes(buf)

    def stream_upstream_to_client(self, resp, conn, profile: str, attempt: int, t0: float,
                                  t_head: float, from_pool: bool, retry: int,
                                  req_body: Optional[bytes], will_close: bool) -> None:
        """把上游响应写回 agy，并就地嗅探 usageMetadata。

        可缓存的只读元数据先整段缓冲，核对声明长度之后才一次性写给客户端。
        截断时客户端还没看到半截体，外层可以丢掉重试。
        生成请求保持即时流式：成功路径的响应头和字节与改造前一致。
        """
        path = (getattr(self, "_lat", None) or {}).get("path", "")
        is_gen = "enerateContent" in path
        cache_ttl = None if CACHE_DISABLE else META_CACHE_TTL.get(path)
        expected, is_chunked = _response_framing(resp)
        # ⚠ 缓冲要**自带体积闸**，但不能要求「声明了 Content-Length 才缓冲」。
        #   - 只靠 put() 卡 2MB 的话，整包已经先进内存才被拒绝缓存 ⇒ 一条自称很大的 200
        #     就能把网关顶成无界缓冲（并发数 × 体积），客户端还得等整包下完才拿到首字节。
        #   - 反过来，Google 这些 JSON 元数据响应实际是 **`Transfer-Encoding: chunked`、
        #     没有 CL**。10-26 第一版把缓冲限定成「有 CL 且 ≤2MB」，结果元数据缓存
        #     在生产里 `stored=0 / hit=0`，57% 流量的收益整体丢失（上线实测才发现）。
        #   ⇒ 有长度线索（CL 或 chunked）就缓冲；攒过上限就当场转即时流式（内存有界，
        #     该响应不再缓存，也不再承诺「截断可重发」—— 字节已经给出去了）。
        known_framing = expected is not None or is_chunked
        buffer_first = ((not is_gen) and path in META_CACHE_TTL and known_framing
                        and (expected is None or 0 <= expected <= META_CACHE_MAX_BYTES))
        streamed = not buffer_first          # 是否已经开始向客户端写字节
        chunk_out = False                    # 提前放行时，我们自己要不要做 chunked 帧

        if not buffer_first:
            self.send_response(resp.status)
            for k, v in resp.getheaders():
                if k.lower() not in ("transfer-encoding", "connection"):
                    self.send_header(k, v)
            self.end_headers()

        def _release_buffer(data: bytes) -> None:
            """缓冲超上限：把已攒的字节交出去，之后转即时流式。"""
            nonlocal held, cache_ttl, streamed, chunk_out
            self.send_response(resp.status)
            for k, v in resp.getheaders():
                if k.lower() not in ("transfer-encoding", "connection", "content-length"):
                    self.send_header(k, v)
            if expected is not None:
                self.send_header("Content-Length", str(expected))   # 上游自己声明过，照抄
                chunk_out = False
            else:
                # 长度未知时**不能**发 `Transfer-Encoding: chunked`：本 handler 全文没有
                # 设置 protocol_version，用的是默认 HTTP/1.0，而 RFC 7230 §3.3.1 规定
                # 1.0 响应里非 identity 的 TE 一律非法，Go 的 readTransfer 直接报错
                # ⇒ 客户端拿到传输错误而不是那份 2MB+ 的体（10-26 审查 R25）。
                # HTTP/1.0 的定长方式本来就有：关连接即结束。所以不发 TE，靠 EOF。
                # 潜伏条件：实测最大元数据响应 133KB < META_CACHE_MAX_BYTES 2MB，够不到这里。
                self.close_connection = True
                chunk_out = False
            self.end_headers()
            _write_to_client(data)
            held = None
            cache_ttl = None
            streamed = True

        def _write_to_client(data: bytes) -> None:
            if not data:
                return
            if chunk_out:
                self.wfile.write(b"%x\r\n" % len(data))
                self.wfile.write(data)
                self.wfile.write(b"\r\n")
            else:
                self.wfile.write(data)
            self.wfile.flush()

        last_tail = b""
        t_first = None
        resp_bytes = 0
        read_error = False
        held = bytearray() if buffer_first else None
        while True:
            try:
                if hasattr(resp, "read1"):
                    chunk = resp.read1(4096)
                else:
                    chunk = resp.read(1024)
            except Exception:
                read_error = True
                break
            if not chunk:
                break
            if t_first is None:
                t_first = time.monotonic()
            resp_bytes += len(chunk)
            last_tail = (last_tail + chunk)[-16384:]
            if held is not None:
                held.extend(chunk)
                if len(held) > META_CACHE_MAX_BYTES:
                    _release_buffer(bytes(held))
                    continue
            else:
                _write_to_client(chunk)      # 提前放行后要走同一出口：chunk_out 时得成帧

        # 完整的 Content-Length 响应要再 read() 一次才会关掉 fp，否则下一次
        # request 抛 ResponseNotReady。3.9 在 read1 已遇 EOF 时这次 read() 返回
        # b'' 且不抛，所以完整性只看上面记下的声明长度，不看这里的异常。
        if not read_error:
            try:
                rest = resp.read()
            except Exception:
                read_error = True
                rest = b""
            if rest:
                if t_first is None:
                    t_first = time.monotonic()
                resp_bytes += len(rest)
                last_tail = (last_tail + rest)[-16384:]
                if held is not None:
                    held.extend(rest)
                    if len(held) > META_CACHE_MAX_BYTES:
                        _release_buffer(bytes(held))
                else:
                    _write_to_client(rest)   # 同上：提前放行后要成帧

        t_end = time.monotonic()
        complete = _body_complete(expected, is_chunked, resp, resp_bytes, read_error)
        # 既无 Content-Length 又非 chunked：干净收完可以交给客户端，但证明不了长度。
        eof_delimited_clean = expected is None and not is_chunked and not read_error
        # ⚠ 只有「一个字节都还没给客户端」才能抛出去重发；提前放行过就不再承诺原子性。
        if buffer_first and not streamed and not complete and not eof_delimited_clean:
            raise _UpstreamBodyIncomplete(
                f"declared={expected} chunked={is_chunked} got={resp_bytes}")

        if buffer_first and not streamed:
            body = bytes(held or b"")
            self.send_response(resp.status)
            for k, v in resp.getheaders():
                if k.lower() not in ("transfer-encoding", "connection", "content-length"):
                    self.send_header(k, v)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            if body:
                if t_first is None:
                    t_first = time.monotonic()
                self.wfile.write(body)
                self.wfile.flush()
        elif streamed and chunk_out:
            try:
                self.wfile.write(b"0\r\n\r\n")
                self.wfile.flush()
            except Exception:
                pass

        # 只有「核对过声明长度 + 响应头那一刻没说要关连接」才回池。
        reusable = bool(complete and not will_close)
        _conn_pool.release(profile, conn, healthy=bool(complete), reusable=reusable)

        if buffer_first and not streamed and complete and cache_ttl and resp.status == 200:
            try:
                _meta_cache.put(
                    self.command, self.path, profile, resp.status,
                    [(k, v) for k, v in resp.getheaders()
                     if k.lower() not in _CACHE_SKIP_HEADERS],
                    bytes(held or b""), cache_ttl, _body_digest(req_body))
            except Exception:
                pass

        _usage = {"model": None, "p_tok": None, "c_tok": None, "t_tok": None, "cache_tok": None}
        try:
            if b"usageMetadata" in last_tail:
                text_tail = last_tail.decode("utf-8", "ignore")
                u_idx = text_tail.rfind('"usageMetadata"')
                tail_slice = text_tail[u_idx:] if u_idx != -1 else text_tail
                prompt_m = re.search(r'"promptTokenCount"\s*:\s*(\d+)', tail_slice)
                cand_m = re.search(r'"candidatesTokenCount"\s*:\s*(\d+)', tail_slice)
                thought_m = re.search(r'"thoughtsTokenCount"\s*:\s*(\d+)', tail_slice)
                # [2026-10-26] 新增 cachedContentTokenCount：prompt >120k token 时
                # 缓存命中率是 head_ms 的第一解释变量，旧埋点完全看不到它。
                cache_m = re.search(r'"cachedContentTokenCount"\s*:\s*(\d+)', tail_slice)
                if prompt_m:
                    p_tok = int(prompt_m.group(1))
                    c_tok = int(cand_m.group(1)) if cand_m else 0
                    t_tok = int(thought_m.group(1)) if thought_m else 0
                    cache_tok = int(cache_m.group(1)) if cache_m else 0
                    model_name = "gemini-flash"
                    mod_m = re.search(r'"modelVersion"\s*:\s*"([^"]+)"', text_tail)
                    if mod_m:
                        model_name = mod_m.group(1).split("/")[-1]
                    elif req_body:
                        try:
                            m_m = re.search(r'"model"\s*:\s*"([^"]+)"',
                                            req_body[:1000].decode("utf-8", "ignore"))
                            if m_m:
                                model_name = m_m.group(1).split("/")[-1]
                        except Exception:
                            pass
                    record_token_usage(
                        profile, model_name, p_tok, c_tok,
                        cached_tokens=cache_tok, thought_tokens=t_tok,
                    )
                    _usage = {"model": model_name, "p_tok": p_tok, "c_tok": c_tok,
                              "t_tok": t_tok, "cache_tok": cache_tok}
        except Exception:
            pass

        self.record_upstream_latency(
            profile, attempt, resp.status, t0, t_head, t_first, t_end, resp_bytes,
            pool="pool" if from_pool else "new", retry=retry, **_usage)

    def forward_raw_response(self, status: int, headers, body: bytes) -> None:
        """把上游错误响应转给客户端，**按实际写出的字节数**成帧。

        ⚠ [2026-10-26 R24] content-length 一律自己算。旧写法原样转发上游那条，配上
        被截断的体（`_drain_body` 老版本只读 64KB）就是「声明 200KB、实到 64KB」，
        Go 报 content-length/EOF 传输错误 ⇒ 429 里那段 quota 原因永远看不见。
        """
        try:
            self.send_response(status)
            for k, v in headers:
                if k.lower() not in ("transfer-encoding", "connection", "content-length"):
                    self.send_header(k, v)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            self.wfile.flush()
        except Exception:
            pass

    def send_cached_response(self, status: int, headers, body: bytes) -> None:
        """[2026-10-26] 元数据缓存命中：本地直接回包，一次上游都不打。

        ⚠ 必须丢掉快照里的 `date`/`expires`/`age`：`send_response()` 自己会写一条当下的
        `Date`，把存下来的旧 `Date` 再发一遍 = 同名头出现两次，且那条还是过期时刻的谎。
        上游的 `Cache-Control: private, max-age=…` 配合**旧** Date 会让任何中间层把
        这份快照判成已过期（或还没过期，取决于 TTL）——两种都是错。
        """
        stale = _CACHE_SKIP_HEADERS
        self.send_response(status)
        for k, v in headers:
            if k.lower() not in stale:
                self.send_header(k, v)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Agyp-Cache", "HIT")
        self.end_headers()
        self.wfile.write(body)
        self.wfile.flush()

    def give_up_502(self, req_body: Optional[bytes], last_exc: Optional[str],
                    attempts: List[Dict[str, Any]],
                    exc_obj: Optional[BaseException] = None) -> None:
        """所有账号/重试都失败后的显式 502 —— 带 JSON 诊断，不再是裸 `Bad Gateway: {e}`。"""
        tb = ""
        if exc_obj is not None:
            try:
                import traceback as _tb
                tb = "".join(_tb.format_exception(type(exc_obj), exc_obj, exc_obj.__traceback__))
            except Exception:
                tb = ""
        try:
            self.log_message(
                "502-EXCEPT path=%s body_len=%s attempts=%s err=%s headers=%s",
                self.path,
                len(req_body) if req_body else 0,
                attempts,
                last_exc,
                dict(list(self.headers.items())[:20]),
            )
            if tb:
                self.log_message("502-TRACEBACK %s", tb.strip()[:2000])
        except Exception:
            pass
        px = None
        try:
            px = _resolve_upstream_proxy()
        except Exception:
            pass
        connecty = any(k in str(last_exc) for k in
                       ("timed out", "Connection refused", "Unable to connect",
                        "ECONNREFUSED", "getaddrinfo", "Network is unreachable"))
        hint = "agyp diag 看池/缓存/在途；tools/agyp_latency_report.py 看分段耗时归因。"
        if connecty:
            hint = ("上游 TCP 就没连上（不是 Google 拒绝请求）。本机直连 daily-cloudcode-pa.googleapis.com "
                    f"不通，出网必须经代理；当前解析到的代理 = {f'{px[0]}:{px[1]}' if px else '无（直连）'}。"
                    "先确认代理客户端在跑：`python3 -c \"import urllib.request as u;print(u.getproxies())\"`；"
                    "可用 AGYP_UPSTREAM_PROXY 显式指定，或设为 none 强制直连排查。")
        self.send_json_response(502, {
            "error": "agyp_upstream_transport_failed",
            "message": "网关向 Google 上游传输数据失败（通常为本地网络波动、代理未连通或连接中断）；为保护会话粘性与服务端上下文缓存（Prompt Cache），未跨账号顺延。",
            "last_error": last_exc,
            "attempts": attempts,
            "upstream": f"https://{UPSTREAM_HOST}:{UPSTREAM_PORT}",
            "via_proxy": f"{px[0]}:{px[1]}" if px else None,
            "hint": hint,
        })

    def report_no_usable_token(self):
        """没有任何可用账号 token 时的显式失败响应（不再静默 FIN）。"""
        try:
            self.log_message(
                "NO-USABLE-TOKEN %s (config_load_error=%s)",
                self.path,
                config_load_error,
            )
        except Exception:
            pass
        self.send_json_response(502, {
            "error": "agyp_gateway_no_usable_token",
            "message": "网关没有任何可用账号 token，请求未转发到上游。",
            "config_file": CONFIG_FILE,
            "config_load_error": config_load_error,
            "hint": "config_load_error 非空表示 profiles.json 已损坏并被改名隔离为 "
                    "profiles.json.bad-<ts>（字节完整，可修复）；"
                    "修复配方见技能 agyp-account-pool-management § Failure mode。",
        })

    def send_json_response(self, code: int, data: Any):
        body = json.dumps(data, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format, *args):
        try:
            _append_line(LOG_FILE,
                         f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')} - {format % args}\n")
        except Exception:
            pass

class ReusableThreadingServer(http.server.ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True

def daemon_child_env() -> Dict[str, str]:
    """给网关子进程用的环境：剥掉所有代理变量，保证直连/走系统代理而非死代理。

    不显式传 env 时 Popen 会整套继承调用者的环境。从带代理的 shell（尤其 agent
    沙箱）里启动网关，网关就会把上游请求发给那个死代理 → 全部 502。
    """
    env = {k: v for k, v in os.environ.items() if k not in PROXY_ENV_KEYS}
    env.setdefault("PATH", "/usr/bin:/bin:/usr/sbin:/sbin")
    return env


def port_is_listening(port: int = DEFAULT_PORT, timeout: float = 0.3) -> bool:
    """纯 socket 探端口。不碰 urllib，因此不受 http_proxy 环境影响。"""
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=timeout):
            return True
    except Exception:
        return False


def last_request_age() -> Optional[float]:
    """距上次「有一跳上游」多少秒。latency.jsonl 读不出返回 None，调用方必须按「忙」处理。

    ⚠ [2026-10-26 R21] 这里**只读 latency.jsonl，绝不掺 gateway.log 的 mtime**。
    上一版把这行注释写成「gateway.log 只在错误/诊断时写行」——那是错的：
    `BaseHTTPRequestHandler` 每个请求都走 log_request → log_message → 同一份 gateway.log，
    管理面的 `/_agyp/status`、`/_agyp/diag` 也一样落行。于是掺进来有两个致命后果：
      · 空闲闸**自己毒死自己**：判据的第一步 `inflight_requests()` 就是一次 diag GET
        ⇒ 它把 log 的 mtime 刷成 0 ⇒ 第二步读到的 age 永远 ≈0 ⇒ 「没活口也不许重启」，
        比旧版更糟（旧版只是 180s 阈值难满足，这版是 100% 拒绝）。实测：一次 diag
        GET 之后 log 年龄 9.59s → 0.000s。
      · 看门狗 410 次「本次不重启」：它在 `gateway_idle()` 之前先 `probe()` 了一次
        `/_agyp/status`，同样把自己刷成忙，连 latency.jsonl 一行都没有的凌晨也重启不了
        （它存在的意义就是那种场合）。
    latency.jsonl 是「每一跳上游一行」的埋点，正好是想要的信号；管理面探针不落账，
    缓存命中的本地回包会落账 —— 那用 `inflight_requests()` 兜，不靠 mtime。
    """
    try:
        return time.time() - os.path.getmtime(LATENCY_FILE)
    except Exception:
        return None


def inflight_requests() -> int:
    """当前在途请求数。拿不到返回 -1。端口仍在听时，-1 必须挡住重启。"""
    try:
        d = _http_diag("/_agyp/diag", timeout=0.8)
        return int(((d or {}).get("inflight") or {}).get("now", -1))
    except Exception:
        return -1


def proc_start_epoch(pid: int) -> Optional[float]:
    """进程启动的 unix 时刻。用 `ps -o etimes=`（纯秒数）而非 lstart=，避免 locale 格式差异。"""
    try:
        out = subprocess.run(["ps", "-o", "etimes=", "-p", str(pid)],
                             capture_output=True, text=True, timeout=3).stdout.strip()
        return time.time() - float(out)
    except Exception:
        return None


def is_daemon_running(port: int = DEFAULT_PORT) -> bool:
    # [2026-09-23] 显式禁用代理：回环地址绝不该走代理。旧写法用裸 urlopen，
    # 带 http_proxy 的 shell 里会把 127.0.0.1 交给代理 → 误判网关离线。
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        url = f"http://127.0.0.1:{port}/_agyp/status"
        req = urllib.request.Request(url, method="GET")
        with opener.open(req, timeout=0.5) as resp:
            data = json.loads(resp.read().decode())
            return data.get("status") == "online"
    except Exception:
        return False


def daemon_status(port: int = DEFAULT_PORT) -> Optional[Dict[str, Any]]:
    """取 /_agyp/status 的完整 JSON（含守护进程自报的 pid / started_at / code_mtime）。"""
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(f"http://127.0.0.1:{port}/_agyp/status", timeout=1.0) as resp:
            return json.loads(resp.read().decode())
    except Exception:
        return None


def code_version_verdict(st: Dict[str, Any]) -> Tuple[Optional[bool], str]:
    """判断"守护进程当前跑的代码 == 磁盘上的代码"。返回 (结论, 判据来源)。

    优先用守护进程自报的 code_mtime（不依赖 ps）；旧版守护进程没这个字段时，
    退回 `ps` 进程启动时间；两条路都拿不到就返回 (None, ...) —— **明确表示无法验证**，
    不能当成通过（假阳性比没结论更危险）。
    """
    script_mtime = os.path.getmtime(os.path.abspath(__file__))
    loaded = st.get("code_mtime")
    if loaded is not None:
        return abs(float(loaded) - script_mtime) < 1e-6, "守护进程自报 code_mtime"
    pid = st.get("pid")
    if pid:
        started = proc_start_epoch(int(pid))
        if started is not None:
            return started > script_mtime, "ps 进程启动时间"
    return None, "无可用判据（守护进程为旧版本且 ps 不可用）"

def start_daemon_background(port: int = DEFAULT_PORT) -> bool:
    if is_daemon_running(port):
        return True
    
    os.makedirs(AGYP_DIR, exist_ok=True)
    with open(LOG_FILE, "a", encoding="utf-8") as log_f:
        proc = subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "__daemon", "--port", str(port)],
            stdout=log_f,
            stderr=log_f,
            start_new_session=True,
            # [2026-09-23] 显式清代理：不传 env 会继承 agent 沙箱的死代理 → 上游全 502
            env=daemon_child_env(),
        )
        with open(PID_FILE, "w") as f:
            f.write(str(proc.pid))

    for _ in range(25):
        time.sleep(0.1)
        if is_daemon_running(port):
            return True
    return False

def stop_daemon(wait_sec: float = 5.0) -> bool:
    """停止网关，并**等到端口真的释放**才返回（返回是否已释放）。

    旧实现发完 SIGTERM 就删 PID 文件、立即返回。调用方（restart）紧接着 start 时，
    端口可能还被 dying 进程占着 → 新进程绑不上；而 start_daemon_background 首行
    `if is_daemon_running(port): return True` 会直接报成功 →
    打印"✓ 已重启"但旧 PID 其实还活着。这是必须堵掉的静默失败。
    """
    pid = None
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
        except Exception:
            pid = None

    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
            print(f"{GREEN}✓ 已停止 agyp 网关守护进程 (PID: {pid}){RESET}")
        except ProcessLookupError:
            print(f"{DIM}PID {pid} 已不存在，无需停止{RESET}")
        except Exception as e:
            print(f"{YELLOW}停止守护进程提示: {e}{RESET}")
    else:
        print(f"{DIM}网关守护进程当前未运行{RESET}")

    deadline = time.time() + wait_sec
    while time.time() < deadline:
        if not port_is_listening():
            try:
                os.remove(PID_FILE)
            except Exception:
                pass
            return True
        time.sleep(0.1)
    return False


def launchd_agent_loaded() -> bool:
    """LaunchAgent 是否已加载（`agyp daemon restart` 优先走这条路）。"""
    return resolve_launchd_label() is not None


def gateway_idle_for_restart() -> Tuple[bool, str]:
    """(能否安全重启, 不能的理由)。

    [2026-10-26 R19] 判据从「最近 180s 有没有流量」换成「此刻有没有活口」。
    理由很实在：三个会话每几秒轮询一次元数据，**缓存命中也会往 latency.jsonl 落账**，
    于是 mtime 永远是新的 ⇒ 只要你在用 agy，`agyp daemon restart` 就永远过不了旧闸
    （今天我自己撞了两次，只能 --force）。而 diag 的 `inflight.now` 直接回答
    「现在有没有请求在处理」，这才是「会不会打断 SSE」的真正判据。
    fail-closed 不变：diag 读不出（旧版网关/没在听）时一律按忙处理。
    """
    live = inflight_requests()
    if live > 0:
        return False, f"有 {live} 个请求正在处理"
    if live < 0:
        age = last_request_age()
        if age is None:
            return False, "读不出 latency.jsonl 的活动时间，也读不出 diag"
        if port_is_listening():
            return False, "端口在听但 diag 读不出（多半是旧版网关没有 /_agyp/diag）"
        return True, ""
    # 走到这里 diag 已经明确说「没有在途」；mtime 只当去抖，读不出来不额外拒死。
    age = last_request_age()
    if age is not None and age < IDLE_QUIET_SEC:
        return False, f"最后一个请求 {age:.0f}s 前刚结束（去抖 {IDLE_QUIET_SEC}s，等 diag 计数追上）"
    return True, ""


def restart_daemon(force: bool = False) -> bool:
    """重启网关，并**验证**真的换了进程、且加载的是当前代码。

    优先交给 launchd：plist 的环境里只有 PATH（无代理），且看门狗不继承本 shell 的
    任何变量 —— 这是唯一"环境保证干净"的启动路径。launchd 不可用时退化为直接
    Popen（daemon_child_env() 同样剥掉了代理）。
    """
    if not force:
        # [R19] 判据换成「此刻有没有活口」。旧版用「最近 180s 有没有流量」，而缓存命中的
        # 元数据轮询也会落账 ⇒ 只要你在用 agy，这个条件永远不满足（今天我自己撞了两次）。
        # mtime 单独也不可靠：跑了 5 分钟的流式生成在 mtime 上表现为空闲。
        # ⚠ 不要退回「diag 读不出就看 mtime」——那正是本次修掉的坑；fail-closed 保持。
        ok, why = gateway_idle_for_restart()
        if not ok:
            print(f"{YELLOW}⚠ {why} —— 重启会打断在途请求，本次不重启。{RESET}")
            print(f"{DIM}  等会话结束再看：agyp live；确认无活口后加 --force：agyp daemon restart --force{RESET}")
            return False

    try:
        old_pid = int(open(PID_FILE).read().strip())
    except Exception:
        old_pid = None

    if not stop_daemon():
        print(f"{RED}✗ 端口 {DEFAULT_PORT} 未在超时内释放 → 已中止，未启动新进程{RESET}")
        print(f"{DIM}  排查：lsof -nP -iTCP:{DEFAULT_PORT} -sTCP:LISTEN{RESET}")
        return False

    launchd_label = resolve_launchd_label()
    if launchd_label:
        via = f"launchd ({launchd_label})"
        r = subprocess.run(["launchctl", "kickstart", "-k", f"gui/{os.getuid()}/{launchd_label}"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            via = "popen"
            start_daemon_background()
    else:
        via = "popen（LaunchAgent 未加载）"
        start_daemon_background()

    new_pid, deadline = None, time.time() + 20
    while time.time() < deadline:
        try:
            new_pid = int(open(PID_FILE).read().strip())
        except Exception:
            new_pid = None
        if new_pid and new_pid != old_pid and port_is_listening() and is_daemon_running():
            break
        time.sleep(0.2)
    else:
        print(f"{RED}✗ 重启后网关未在 20s 内就绪（PID: {old_pid} → {new_pid}）{RESET}")
        print(f"{DIM}  查看日志：tail -20 {LOG_FILE}{RESET}")
        print(f"{DIM}  补救：agyp daemon start{RESET}")
        return False

    st = daemon_status() or {}
    code_ok, basis = code_version_verdict(st)
    script_mtime = os.path.getmtime(os.path.abspath(__file__))

    def _fmt(t):
        try:
            return datetime.fromtimestamp(float(t)).strftime("%Y-%m-%d %H:%M:%S")
        except Exception:
            return "n/a"

    listening = port_is_listening()
    print(f"{GREEN}✓ agyp 网关已重启{RESET} {DIM}（经 {via}）{RESET}")
    print(f"  PID          : {old_pid or '无'} → {BOLD}{new_pid}{RESET}")
    print(f"  进程启动时间 : {_fmt(st.get('started_at'))}")   # 守护进程自报
    print(f"  脚本 mtime   : {_fmt(script_mtime)}")
    if code_ok is True:
        print(f"  代码已加载   : {GREEN}✓ 是{RESET} {DIM}({basis}){RESET}")
    elif code_ok is False:
        print(f"  代码已加载   : {RED}✗ 否 —— 跑的仍是旧代码{RESET} {DIM}({basis}){RESET}")
    else:
        print(f"  代码已加载   : {YELLOW}? 无法验证{RESET} {DIM}({basis}){RESET}")
    print(f"  监听         : {GREEN if listening else RED}{'127.0.0.1:%d 在线' % DEFAULT_PORT if listening else '未监听'}{RESET}")
    return True

def run_daemon_loop(port: int = DEFAULT_PORT) -> None:
    global _DAEMON_STARTED_AT, _DAEMON_CODE_MTIME
    _DAEMON_STARTED_AT = time.time()
    try:
        _DAEMON_CODE_MTIME = os.path.getmtime(os.path.abspath(__file__))
    except Exception:
        _DAEMON_CODE_MTIME = None
    # [2026-10-26 R26] 开机先强制查一次体积：轮转的常态触发点是「同一个进程写满 512 行」，
    # 反复重启/低频写入的实例可能永远轮不到（实测 gateway.log 80MB > 20MB 上限、
    # 磁盘上一份 .1 都没有）。启动即纠偏，并把 stderr 跟到新文件上。
    if _rotate_if_oversized(LOG_FILE):
        _reopen_daemon_stderr()
    _rotate_if_oversized(LATENCY_FILE)
    server = ReusableThreadingServer(("127.0.0.1", port), GatewayProxyHandler)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))
    
    def quota_refresher():
        while True:
            try:
                for p in enabled_profiles():
                    fetch_quota_summary(p)
                    time.sleep(1)
            except Exception:
                pass
            time.sleep(600)

    t = threading.Thread(target=quota_refresher, daemon=True)
    t.start()

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        server.server_close()

# ----------------------------------------------------------------------
# CLI Commands & Presentation
# ----------------------------------------------------------------------

def format_countdown(iso_str: Optional[str]) -> str:
    if not iso_str:
        return "--"
    try:
        clean_iso = iso_str.replace("Z", "+00:00")
        target = datetime.fromisoformat(clean_iso)
        now = datetime.now(timezone.utc)
        diff = target - now
        if diff.total_seconds() <= 0:
            return "即将回满"
        days = diff.days
        hours = int(diff.seconds // 3600)
        minutes = int((diff.seconds % 3600) // 60)
        if days > 0:
            return f"{days}天{hours}时"
        elif hours > 0:
            return f"{hours}时{minutes}分"
        else:
            return f"{minutes}分钟"
    except Exception:
        return "--"

def progress_bar(fraction: Optional[float], width: int = 8) -> str:
    if fraction is None:
        return f"{DIM}[--------]{RESET} --%"
    f = max(0.0, min(1.0, float(fraction)))
    filled = int(round(f * width))
    empty = width - filled
    pct = int(round(f * 100))

    if f > 0.5:
        color = GREEN
    elif f > 0.15:
        color = YELLOW
    else:
        color = RED

    bar = "█" * filled + "░" * empty
    return f"{color}[{bar}]{RESET} {color}{pct:>3}%{RESET}"

def show_quota_dashboard(as_json: bool = False):
    cfg = load_config()
    active_profile = get_active_profile_name()
    enabled = enabled_profiles(cfg)
    paused_set = set(paused_profiles(cfg))

    if enabled:
        print(f"\n{DIM}正在直连 Google Cloud 查询 {len(enabled)} 个启用账号最新实时额度"
              f"{f'（已跳过 {len(paused_set)} 个暂停账号）' if paused_set else ''}...{RESET}", file=sys.stderr)
    live_quotas: Dict[str, Any] = {}
    for p in all_profiles():
        if p in paused_set:
            live_quotas[p] = cfg.get("profiles", {}).get(p, {}).get("last_quota")
        else:
            live_quotas[p] = fetch_quota_summary(p, refresh_tier=True)

    cfg = load_config()
    if as_json:
        output = {
            "active_profile": active_profile,
            "paused_profiles": list(paused_set),
            "enabled_profiles": enabled,
            "tiers": {p: cfg.get("profiles", {}).get(p, {}).get("tier") for p in all_profiles()},
            "profiles": live_quotas
        }
        print(json.dumps(output, indent=2, ensure_ascii=False))
        return

    print()
    print(f"{BOLD}{CYAN}⚡ agyp: {len(all_profiles())} 账号额度监控看板{RESET}  {DIM}(直连官方端点 · 0 钥匙串交互 · 免关窗口){RESET}")
    lock_note = f"  |  {YELLOW}单账号锁定模式{RESET}" if len(enabled) == 1 and paused_set else ""
    print(f"{DIM}当前会话活动账号: {BOLD}{GREEN}{active_profile}{RESET}{DIM}  |  启用 {len(enabled)}/{len(all_profiles())}{lock_note}  |  网关状态: {GREEN if is_daemon_running() else YELLOW}{'在线 (127.0.0.1:8783)' if is_daemon_running() else '离线 (敲 agyp 自动拉起)'}{RESET}")
    print("=" * 98)
    print(f"{BOLD}{'Profile':<11} | {'会员':<5} | {'账号邮箱':<24} | {'Gemini 5h 限额':<18} | {'Gemini 周限额':<18} | {'Claude/GPT'}{RESET}")
    print("-" * 98)

    for prof in all_profiles():
        p_info = cfg.get("profiles", {}).get(prof, {})
        email = p_info.get("email", "unknown")
        is_paused = prof in paused_set
        q = live_quotas.get(prof) or {}
        tier_col = format_tier_badge(p_info.get("tier"), width=5)

        g5h = q.get("gemini_5h")
        gweek = q.get("gemini_weekly")
        cweek = q.get("claude_weekly", 1.0)
        r5h = q.get("reset_5h")
        rweek = q.get("reset_weekly")

        if is_paused:
            name_display = f"{YELLOW}⏸ {prof:<8}{RESET}"
        elif prof == active_profile:
            name_display = f"{BOLD}{GREEN}● {prof:<8}{RESET}"
        else:
            name_display = f"  {prof:<8}"
        col_5h = progress_bar(g5h, width=8)
        col_week = progress_bar(gweek, width=8)
        col_c = progress_bar(cweek, width=6)

        print(f"{name_display} | {tier_col} | {email:<24} | {col_5h} | {col_week} | {col_c}")

        hints = []
        if is_paused:
            hints.append(f"{YELLOW}已暂停（跳过调度/容灾/后台刷新）{RESET}")
        if r5h and g5h is not None and g5h < 0.99:
            hints.append(f"5h回满: {format_countdown(r5h)}")
        if rweek and gweek is not None and gweek < 0.99:
            hints.append(f"周回满: {format_countdown(rweek)}")
        if hints:
            print(f"{DIM}       └─ {' · '.join(hints)}{RESET}")

    print("=" * 98)


def _model_usage_breakdown(cutoff: str, end: str) -> List[Dict[str, Any]]:
    """按统计窗口聚合 latency.jsonl（含轮转 .1/.2/.3）中各模型的请求数与 Token 量。
    只读，不写任何数据；模型名来自每次请求落账的 model 字段。"""
    files = [LATENCY_FILE]
    for i in (1, 2, 3):
        cand = f"{LATENCY_FILE}.{i}"
        if os.path.exists(cand):
            files.append(cand)
    agg: Dict[str, Dict[str, int]] = {}
    for path in files:
        try:
            with open(path, "r", encoding="utf-8", errors="ignore") as fh:
                for ln in fh:
                    ln = ln.strip()
                    if not ln:
                        continue
                    try:
                        d = json.loads(ln)
                    except Exception:
                        continue
                    ts = d.get("ts") or ""
                    day = ts[:10]
                    if not day or not (cutoff <= day <= end):
                        continue
                    model = d.get("model")
                    if not model:
                        continue
                    e = agg.setdefault(model, {"requests": 0, "tokens": 0})
                    e["requests"] += 1
                    try:
                        e["tokens"] += int(d.get("p_tok") or 0) + int(d.get("c_tok") or 0) + int(d.get("t_tok") or 0)
                    except Exception:
                        pass
        except Exception:
            continue
    out = [{"model": k, **v} for k, v in agg.items()]
    out.sort(key=lambda x: x["requests"], reverse=True)
    return out


def show_stats_dashboard(days: Optional[int] = 1, as_json: bool = False):
    m = load_metrics()
    cfg = load_config()

    today_dt = datetime.now()
    today_str = today_dt.strftime("%Y-%m-%d")

    if days == 1:
        cutoff = today_str
        period_title = f"今日 ({today_str})"
    elif days:
        cutoff = (today_dt - timedelta(days=days - 1)).strftime("%Y-%m-%d")
        period_title = f"近 {days} 天 ({cutoff} ~ {today_str})"
    else:
        cutoff = "0000-00-00"
        period_title = "全部历史"

    all_dates = m.get("by_date", {})
    filtered_dates = sorted([d for d in all_dates.keys() if cutoff <= d <= today_str])

    # 模型用量：从 latency.jsonl（含轮转）按窗口只读聚合（不依赖 metrics.json 的聚合）
    model_rows = _model_usage_breakdown(cutoff, today_str)

    # Range Aggregates
    range_req = sum(all_dates[d].get("requests", 0) for d in filtered_dates)
    range_inp = sum(all_dates[d].get("input_tokens", 0) for d in filtered_dates)
    range_out = sum(all_dates[d].get("output_tokens", 0) for d in filtered_dates)
    range_thought = sum(all_dates[d].get("thought_tokens", 0) for d in filtered_dates)
    range_all = sum(all_dates[d].get("total_tokens", 0) for d in filtered_dates)
    # [2026-10-26] cachedContentTokenCount 首次入账；仅对含该字段的日期计入分母，避免历史天数拉低长周期命中率
    range_cache = sum(all_dates[d].get("cached_tokens", 0) for d in filtered_dates)
    cache_eligible_inp = sum(
        all_dates[d].get("input_tokens", 0)
        for d in filtered_dates
        if "cached_tokens" in all_dates[d]
    )
    cache_rate = (100.0 * range_cache / cache_eligible_inp) if cache_eligible_inp else 0.0
    range_usd = sum(all_dates[d].get("cost_usd", 0.0) for d in filtered_dates)
    range_cny = sum(all_dates[d].get("cost_cny", 0.0) for d in filtered_dates)

    num_days = days if (days and days > 1) else max(1, len(filtered_dates))
    avg_tokens = range_all // num_days if num_days > 0 else 0
    avg_cny = range_cny / num_days if num_days > 0 else 0.0
    avg_req = range_req / num_days if num_days > 0 else 0.0

    # Profile stats within this specific range
    range_profiles: Dict[str, Dict[str, Any]] = {}
    for p in all_profiles():
        p_req = 0
        p_inp = 0
        p_out = 0
        p_all = 0
        p_usd = 0.0
        p_cny = 0.0
        for d in filtered_dates:
            p_data = all_dates[d].get("profiles", {}).get(p, {})
            p_req += p_data.get("requests", 0)
            p_inp += p_data.get("input_tokens", 0)
            p_out += p_data.get("output_tokens", 0)
            p_all += p_data.get("total_tokens", 0)
            p_usd += p_data.get("cost_usd", 0.0)
            p_cny += p_data.get("cost_cny", 0.0)
        range_profiles[p] = {
            "requests": p_req,
            "input_tokens": p_inp,
            "output_tokens": p_out,
            "total_tokens": p_all,
            "cost_usd": round(p_usd, 4),
            "cost_cny": round(p_cny, 2)
        }

    if as_json:
        out_json = {
            "period": period_title,
            "days_limit": days,
            "summary": {
                "requests": range_req,
                "input_tokens": range_inp,
                "cached_input_tokens": range_cache,
                "cache_eligible_input_tokens": cache_eligible_inp,
                "cache_hit_rate": round(cache_rate, 2),
                "output_tokens": range_out,
                "thought_tokens": range_thought,
                "total_tokens": range_all,
                "cost_usd": round(range_usd, 4),
                "cost_cny": round(range_cny, 2),
                "daily_avg_tokens": avg_tokens,
                "daily_avg_cny": round(avg_cny, 2)
            },
            "by_date": {d: all_dates[d] for d in filtered_dates},
            "by_profile": range_profiles,
            "by_model": model_rows
        }
        print(json.dumps(out_json, indent=2, ensure_ascii=False))
        return

    print()
    print(f"{BOLD}{CYAN}⚡ agyp: Token 消耗量与等效商业价值统计看板{RESET}  {DIM}【统计周期: {period_title}】{RESET}")
    print("=" * 96)

    cache_line = (f"  • 输入缓存命中: {BOLD}{CYAN}{range_cache:,}{RESET} / {range_inp:,} Tokens"
                  f"  {DIM}(命中率 {cache_rate:.1f}%，直接决定 prefill 时长){RESET}"
                  if range_cache else
                  f"  • 输入缓存命中: {DIM}本窗口无 cachedContentTokenCount 数据{RESET}")
    # 1. Overview Card
    if days == 1:
        print(f"{BOLD}【今日概览】{RESET}")
        print(f"  • 今日调用请求:   {BOLD}{range_req:,}{RESET} 次")
        print(f"  • 今日消耗 Token: {BOLD}{CYAN}{range_all:,}{RESET} Tokens  {DIM}(输入: {range_inp:,} | 输出: {range_out:,}){RESET}")
        print(cache_line)
        print(f"  • 官方等效省下:   {BOLD}{GREEN}${range_usd:.4f} USD{RESET} {DIM}(约折合人民币 {RESET}{BOLD}{GREEN}￥{range_cny:.2f} 元{RESET}{DIM}){RESET}")
    else:
        print(f"{BOLD}【周期聚合概览】{RESET}")
        print(f"  • 周期调用请求:   {BOLD}{range_req:,}{RESET} 次  {DIM}(日均 {avg_req:.1f} 次){RESET}")
        print(f"  • 周期消耗 Token: {BOLD}{CYAN}{range_all:,}{RESET} Tokens  {DIM}(日均: {avg_tokens:,} | 输入: {range_inp:,} | 输出: {range_out:,}){RESET}")
        print(cache_line)
        print(f"  • 官方等效省下:   {BOLD}{GREEN}${range_usd:.4f} USD{RESET} {DIM}(约折合人民币 {RESET}{BOLD}{GREEN}￥{range_cny:.2f} 元{RESET}{DIM}，日均 {GREEN}￥{avg_cny:.2f}{RESET}{DIM}){RESET}")
    print("-" * 96)

    # 2. Daily breakdown (only show if multi-day or all)
    if days != 1:
        print(f"{BOLD}【按天趋势分布 (Daily Breakdown)】{RESET}")
        print(f"{BOLD}{'日期':<12} | {'请求次数':<8} | {'输入 Tokens':<14} | {'输出 Tokens':<12} | {'总计 Tokens':<14} | {'等效价值 (节省)'}{RESET}")
        print("-" * 96)
        if not filtered_dates:
            print(f"  {DIM}(该周期内暂无调用数据){RESET}")
        else:
            for d in filtered_dates:
                info = all_dates[d]
                d_req = info.get("requests", 0)
                d_inp = info.get("input_tokens", 0)
                d_out = info.get("output_tokens", 0)
                d_all = info.get("total_tokens", 0)
                d_usd = info.get("cost_usd", 0.0)
                d_cny = info.get("cost_cny", 0.0)
                print(f"{d:<12} | {d_req:>6} 次 | {d_inp:>12,} | {d_out:>10,} | {BOLD}{d_all:>12,}{RESET} | {GREEN}${d_usd:.4f}{RESET} {DIM}(￥{d_cny:.2f}){RESET}")
        print("-" * 96)

    # 3. Account Breakdown for this period
    period_tag = "今日" if days == 1 else "周期内"
    print(f"{BOLD}【{period_tag}账号分配明细 (Account Breakdown)】{RESET}")
    print(f"{BOLD}{'Profile':<8} | {'账号邮箱':<25} | {'请求次数':<8} | {'总计 Tokens':<14} | {'消耗占比':<8} | {'等效商业价值'}{RESET}")
    print("-" * 96)

    for p in all_profiles():
        p_info = cfg.get("profiles", {}).get(p, {})
        email = p_info.get("email", "unknown")
        p_stat = range_profiles.get(p, {})
        p_req = p_stat.get("requests", 0)
        p_all = p_stat.get("total_tokens", 0)
        p_usd = p_stat.get("cost_usd", 0.0)
        p_cny = p_stat.get("cost_cny", 0.0)
        pct = (p_all / range_all * 100.0) if range_all > 0 else 0.0

        p_display = f"{BOLD}{p:<8}{RESET}"
        pct_display = f"{pct:>5.1f}%" if range_all > 0 else "  0.0%"
        print(f"{p_display} | {email:<25} | {p_req:>6} 次 | {BOLD}{p_all:>12,}{RESET} | {pct_display}   | {GREEN}${p_usd:.4f}{RESET} {DIM}(￥{p_cny:.2f}){RESET}")

    # 4. Model Breakdown for this period (模型用量量级)
    print(f"{BOLD}【{period_tag}模型用量明细 (Model Breakdown)】{RESET}  {DIM}(来源: latency.jsonl 每次请求落账的 model 字段){RESET}")
    if not model_rows:
        print(f"  {DIM}(该周期内 latency.jsonl 无模型数据){RESET}")
    else:
        m_total_req = sum(r["requests"] for r in model_rows)
        m_total_tok = sum(r["tokens"] for r in model_rows)
        print(f"{BOLD}{'Model':<26} | {'请求次数':<8} | {'Tokens 总量':<16} | {'请求占比':<7} | {'Token 占比'}{RESET}")
        print("-" * 96)
        for r in model_rows:
            req_pct = (r["requests"] / m_total_req * 100.0) if m_total_req else 0.0
            tok_pct = (r["tokens"] / m_total_tok * 100.0) if m_total_tok else 0.0
            print(f"{r['model']:<26} | {r['requests']:>6} 次 | {r['tokens']:>14,} | {req_pct:>5.1f}%  | {tok_pct:>5.1f}%")
        print(f"{BOLD}{'合计':<24}{RESET} | {m_total_req:>6} 次 | {BOLD}{m_total_tok:>14,}{RESET} | {'100.0%':>7} | {'100.0%':>7}")
    print("-" * 96)

    print("=" * 96)
    if days == 1:
        print(f"{DIM}💡 切换统计周期: agyp stats 7 (近7天) | agyp stats 15 (近15天) | agyp stats 30 (近30天) | agyp stats all (全部历史){RESET}\n")
    else:
        print(f"{DIM}💡 切换统计周期: agyp stats (今日) | agyp stats 7 (近7天) | agyp stats 15 (近15天) | agyp stats 30 (近30天) | agyp stats all (全部历史){RESET}\n")

