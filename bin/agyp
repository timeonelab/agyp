            p_tag = f"{YELLOW}暂停调度{RESET}"
        elif score >= 85:
            score_str = f"{YELLOW}{score:>5.1f} 分{RESET}"
            p_tag = f"{YELLOW}临期冲刺{RESET}"
        elif score >= 70:
            score_str = f"{GREEN}{score:>5.1f} 分{RESET}"
            p_tag = f"{GREEN}优先调度{RESET}"
        elif score >= 50:
            score_str = f"{CYAN}{score:>5.1f} 分{RESET}"
            p_tag = f"{CYAN}健康待命{RESET}"
        else:
            score_str = f"{DIM}{score:>5.1f} 分{RESET}"
            p_tag = f"{DIM}储备应急{RESET}"

        cur_mark = f"{YELLOW}[已暂停]{RESET}" if is_paused else (f"{CYAN}[活跃]{RESET}" if p == active_p else "      ")
        rank_label = "--" if is_paused else f"#{idx}"
        print(f"{rank_label:<2} {p_tag:<8} | {p:<8} | {tier_col} | {score_str:<16} | {int(g5h*100):>3}%     | {int(gweek*100):>3}%    | {rweek_str:<12} | {email} {cur_mark}")

    print("=" * 104)
    enabled_ranked = [x for x in ranked if not x[2].get("paused")]
    if enabled_ranked:
        top_p, top_score, _ = enabled_ranked[0]
        if top_score > 0:
            print(f"  ▶ 当前推荐首选: {BOLD}{GREEN}{top_p}{RESET} (直接输入 {CYAN}agyp{RESET} 即可进入终端)")
    print()


def _gateway_api_get(path_and_query: str, timeout: float = 1.5) -> Tuple[int, Dict[str, Any]]:
    """回环管理接口请求（绕过 http_proxy），返回 (status_code, json_dict)。"""
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    url = f"http://127.0.0.1:{DEFAULT_PORT}{path_and_query}"
    req = urllib.request.Request(url, method="GET")
    try:
        with opener.open(req, timeout=timeout) as resp:
            return resp.getcode(), json.loads(resp.read().decode())
    except urllib.error.HTTPError as he:
        try:
            body = json.loads(he.read().decode())
        except Exception:
            body = {"status": "error", "message": str(he)}
        return he.code, body
    except Exception as e:
        return 0, {"status": "error", "message": str(e)}


def _gateway_api_post(path: str, payload: Dict[str, Any], timeout: float = 15.0) -> Tuple[int, Dict[str, Any]]:
    """回环管理 POST 接口请求（绕过 http_proxy），返回 (status_code, json_dict)。"""
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    url = f"http://127.0.0.1:{DEFAULT_PORT}{path}"
    data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"}, method="POST")
    try:
        with opener.open(req, timeout=timeout) as resp:
            return resp.getcode(), json.loads(resp.read().decode())
    except urllib.error.HTTPError as he:
        try:
            body = json.loads(he.read().decode())
        except Exception:
            body = {"status": "error", "message": str(he)}
        return he.code, body
    except Exception as e:
        return 0, {"status": "error", "message": str(e)}


def _reload_gateway_profile(profile: Optional[str] = None) -> None:
    if is_daemon_running():
        _gateway_api_post("/_agyp/profile/reload", {"profile": profile or ""}, timeout=2.0)


def _emit_cli_result(as_json: bool, ok: bool, payload: Dict[str, Any], err_msg: str = "") -> None:
    if as_json:
        out = dict(payload)
        out["status"] = "ok" if ok else "error"
        if err_msg:
            out["message"] = err_msg
        print(json.dumps(out, ensure_ascii=False))
    elif not ok:
        print(f"{RED}✗ {err_msg}{RESET}", file=sys.stderr)


def cmd_add_profile(args: List[str], reauth: bool = False) -> None:
    """agyp add / login / reauth 子命令实现。"""
    as_json = "--json" in args
    from_keychain = "--from-keychain" in args
    no_browser = "--no-browser" in args
    force = reauth or ("--force" in args)
    verify = "--no-verify" not in args
    rt = ""
    email = ""
    timeout_sec = 180
    positional: List[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--json", "--from-keychain", "--no-browser", "--force", "--no-verify"):
            i += 1
        elif a == "--refresh-token" and i + 1 < len(args):
            rt = args[i + 1]
            i += 2
        elif a == "--email" and i + 1 < len(args):
            email = args[i + 1]
            i += 2
        elif a == "--timeout" and i + 1 < len(args):
            try:
                timeout_sec = max(10, int(args[i + 1]))
            except Exception:
                pass
            i += 2
        elif a.startswith("-"):
            _emit_cli_result(as_json, False, {}, f"未知参数 '{a}'")
            sys.exit(2)
        else:
            positional.append(a)
            i += 1

    if not positional:
        cmd_name = "reauth" if reauth else "add"
        _emit_cli_result(
            as_json, False, {},
            f"用法: agyp {cmd_name} <name> [--from-keychain | --refresh-token <rt>] [--email <email>] [--timeout 180] [--no-browser] [--force] [--json]",
        )
        sys.exit(2)

    name = positional[0].strip()
    ok_n, err_n = validate_profile_name(name)
    if not ok_n:
        _emit_cli_result(as_json, False, {"profile": name}, err_n)
        sys.exit(1)

    if reauth and name not in all_profiles():
        _emit_cli_result(as_json, False, {"profile": name}, f"未知 Profile '{name}'，请先使用 agyp add {name}")
        sys.exit(1)

    creds: Dict[str, Any] = {}
    if from_keychain:
        kc, kerr = read_keychain_credentials()
        if not kc:
            _emit_cli_result(as_json, False, {"profile": name}, kerr or "读取钥匙串失败")
            sys.exit(1)
        creds = kc
    elif rt:
        creds = {"refresh_token": rt}
    else:
        oc, oerr = oauth_browser_login(timeout_sec=timeout_sec, open_browser=not no_browser)
        if not oc:
            _emit_cli_result(as_json, False, {"profile": name}, oerr or "Google OAuth 授权失败")
            sys.exit(1)
        creds = oc

    ok, err_msg, snap = upsert_profile(
        name,
        refresh_token=str(creds.get("refresh_token") or ""),
        access_token=str(creds.get("access_token") or ""),
        expires_at=float(creds.get("expires_at") or 0.0),
        email=email or str(creds.get("email") or ""),
        overwrite=force,
        verify=verify,
    )
    if not ok:
        _emit_cli_result(as_json, False, {"profile": name}, err_msg)
        sys.exit(1)

    _reload_gateway_profile(name)
    if as_json:
        _emit_cli_result(as_json, True, snap)
    else:
        em = snap.get("email") or "已验证"
        print(f"{GREEN}✓ 已{'更新认证' if reauth else '添加'}账号 {BOLD}{name}{RESET} ({em})，当前默认: {snap.get('active_profile')}{RESET}")


def cmd_remove_profile(args: List[str]) -> None:
    """agyp remove / rm / delete 子命令实现。"""
    as_json = "--json" in args
    force = "--force" in args
    yes = ("-y" in args) or ("--yes" in args) or as_json
    positional = [a for a in args if not a.startswith("-")]
    if not positional:
        _emit_cli_result(as_json, False, {}, "用法: agyp remove <name> [-y|--yes] [--force] [--json]")
        sys.exit(2)
    name = positional[0].strip()
    if not yes and sys.stdin.isatty():
        ans = input(f"确认移除账号 '{name}'? [y/N]: ").strip().lower()
        if ans not in ("y", "yes"):
            print("已取消")
            return
    ok, err_msg, snap = remove_profile(name, force=force)
    if not ok:
        _emit_cli_result(as_json, False, {"profile": name}, err_msg)
        sys.exit(1)
    _reload_gateway_profile(name)
    if as_json:
        _emit_cli_result(as_json, True, snap)
    else:
        print(f"{GREEN}✓ 已移除账号 {BOLD}{name}{RESET}；当前活跃账号: {snap.get('active_profile') or '无'}{RESET}")


def cmd_rename_profile(args: List[str]) -> None:
    """agyp rename / mv 子命令实现。"""
    as_json = "--json" in args
    positional = [a for a in args if not a.startswith("-")]
    if len(positional) < 2:
        _emit_cli_result(as_json, False, {}, "用法: agyp rename <old> <new> [--json]")
        sys.exit(2)
    old_name, new_name = positional[0].strip(), positional[1].strip()
    ok, err_msg, snap = rename_profile(old_name, new_name)
    if not ok:
        _emit_cli_result(as_json, False, {"old_name": old_name, "new_name": new_name}, err_msg)
        sys.exit(1)
    _reload_gateway_profile(old_name)
    if as_json:
        _emit_cli_result(as_json, True, snap)
    else:
        print(f"{GREEN}✓ 已将账号 {BOLD}{old_name}{RESET} 重命名为 {BOLD}{new_name}{RESET}")


def cmd_auth(args: List[str]) -> None:
    """agyp auth config | status 子命令。"""
    sub = args[0] if args else "status"
    rest = args[1:]
    if sub == "config":
        cid = ""
        csec = ""
        i = 0
        while i < len(rest):
            if rest[i] == "--client-id" and i + 1 < len(rest):
                cid = rest[i + 1]
                i += 2
            elif rest[i] == "--client-secret" and i + 1 < len(rest):
                csec = rest[i + 1]
                i += 2
            else:
                i += 1
        if not cid and not csec and sys.stdin.isatty():
            cid = input("Google OAuth Client ID: ").strip()
            csec = input("Google OAuth Client Secret: ").strip()
        if not cid or not csec:
            print(f"{RED}用法: agyp auth config --client-id <ID> --client-secret <SECRET>{RESET}", file=sys.stderr)
            sys.exit(2)
        if save_oauth_client(cid, csec):
            print(f"{GREEN}✓ OAuth Client 凭据已安全保存至 {oauth_file_path()} (0600){RESET}")
        else:
            print(f"{RED}✗ 保存 OAuth Client 凭据失败{RESET}", file=sys.stderr)
            sys.exit(1)
        return
    if sub == "status":
        cid, csec = load_oauth_client()
        if cid and csec:
            masked = cid[:12] + "..." + cid[-8:] if len(cid) > 24 else cid
            print(f"{GREEN}✓ OAuth Client 已配置{RESET} ({masked})  配置文件: {oauth_file_path()}")
        else:
            print(f"{YELLOW}⚠ 尚未配置 OAuth Client{RESET}。可通过 `agyp auth config` 或环境变量设置。")
        return
    print(f"{RED}用法: agyp auth [status | config --client-id <ID> --client-secret <SECRET>]{RESET}", file=sys.stderr)
    sys.exit(2)


def switch_active(pname: str):
    if pname not in all_profiles():
        print(f"{RED}错误: 未知 Profile '{pname}'。可选账号: {', '.join(all_profiles())}{RESET}")
        return
    was_paused = set_active_profile_name(pname, unpause=True)
    if not is_daemon_running():
        note = "（已自动恢复暂停状态）" if was_paused else ""
        print(f"{YELLOW}⚠ 活动账号已写入配置为 {BOLD}{pname}{RESET}{YELLOW}{note}，但网关当前没在运行，会话绑定未确认清除。{RESET}")
        return
    q = urllib.parse.quote(pname, safe="")
    code, data = _gateway_api_get(f"/_agyp/switch?profile={q}", timeout=1.0)
    pushed = (code == 200 and data.get("status") == "ok")
    if not pushed:
        print(f"{YELLOW}⚠ 活动账号已写入配置为 {BOLD}{pname}{RESET}{YELLOW}，但网关没有确认切号。会话绑定可能仍指向旧账号。{RESET}")
        print(f"{DIM}  请再执行一次：agyp switch {pname}{RESET}")
        return
    if was_paused or data.get("auto_resumed"):
        print(f"{GREEN}✓ 已自动恢复并热切换当前活动账号为: {BOLD}{pname}{RESET} (网关已同步更新 Token 注入策略)")
    else:
        print(f"{GREEN}✓ 当前活动账号已热切换为: {BOLD}{pname}{RESET} (网关已同步更新 Token 注入策略)")


def pause_or_resume_profiles(targets: List[str], paused: bool) -> None:
    if not targets:
        verb = "pause" if paused else "resume"
        hint = f"{'|'.join(all_profiles())}" if paused else f"{'|'.join(all_profiles())}|all"
        print(f"{RED}用法: agyp {verb} <{hint}>{RESET}")
        return

    daemon_up = is_daemon_running()
    if not paused and len(targets) == 1 and targets[0].lower() in ("all", "--all"):
        if daemon_up:
            code, data = _gateway_api_get("/_agyp/pause?all=0", timeout=1.5)
            ok = (code == 200 and data.get("status") == "ok")
            msg = data.get("message", "")
        else:
            ok, msg, data = resume_all_profiles()
        if ok:
            resumed = data.get("resumed") or []
            desc = f"（已恢复: {', '.join(resumed)}）" if resumed else "（当前没有处于暂停状态的账号）"
            print(f"{GREEN}✓ 已恢复全部账号参与调度与容灾{RESET} {DIM}{desc}{RESET}")
        else:
            print(f"{RED}✗ 全部恢复失败: {msg}{RESET}", file=sys.stderr)
            sys.exit(1)
        return

    for pname in targets:
        if pname not in all_profiles():
            print(f"{RED}错误: 未知 Profile '{pname}'。可选账号: {', '.join(all_profiles())}{RESET}", file=sys.stderr)
            sys.exit(1)
        if daemon_up:
            q = urllib.parse.quote(pname, safe="")
            flag = "1" if paused else "0"
            code, data = _gateway_api_get(f"/_agyp/pause?profile={q}&paused={flag}", timeout=1.5)
            ok = (code == 200 and data.get("status") == "ok")
            msg = data.get("message", "")
        else:
            ok, msg, data = set_profile_paused(pname, paused)
        if not ok:
            print(f"{RED}✗ 操作账号 [{pname}] 失败: {msg}{RESET}", file=sys.stderr)
            sys.exit(1)
        enabled = data.get("enabled_profiles") or []
        active_now = data.get("active_profile")
        if paused:
            extra = f" · 全局默认已切至 {BOLD}{active_now}{RESET}" if data.get("active_changed") else ""
            sync_note = "网关已热生效" if daemon_up else "已写入配置（网关离线）"
            print(f"{YELLOW}⏸ 已暂停账号: {BOLD}{pname}{RESET} ({sync_note} · 剩余启用 {len(enabled)} 个: {', '.join(enabled)}{extra})")
        else:
            sync_note = "网关已热生效" if daemon_up else "已写入配置（网关离线）"
            print(f"{GREEN}▶ 已恢复账号: {BOLD}{pname}{RESET} ({sync_note} · 当前启用 {len(enabled)} 个: {', '.join(enabled)})")


def only_profile_cmd(pname: str) -> None:
    if pname not in all_profiles():
        print(f"{RED}错误: 未知 Profile '{pname}'。可选账号: {', '.join(all_profiles())}{RESET}", file=sys.stderr)
        sys.exit(1)
    daemon_up = is_daemon_running()
    if daemon_up:
        q = urllib.parse.quote(pname, safe="")
        code, data = _gateway_api_get(f"/_agyp/only?profile={q}", timeout=1.5)
        ok = (code == 200 and data.get("status") == "ok")
        msg = data.get("message", "")
    else:
        ok, msg, data = set_only_profile(pname)
    if not ok:
        print(f"{RED}✗ 锁定单账号失败: {msg}{RESET}", file=sys.stderr)
        sys.exit(1)
    paused_list = data.get("paused_profiles") or []
    sync_note = "网关已热生效" if daemon_up else "已写入配置（网关离线）"
    print(f"{GREEN}🔒 已锁定单账号模式: 只使用 {BOLD}{pname}{RESET} ({sync_note})")
    if paused_list:
        print(f"{DIM}   已暂停其余 {len(paused_list)} 个账号: {', '.join(paused_list)}（恢复可用: agyp resume all）{RESET}")

def _run_startup_hooks():
    """在真正启动 agy 之前，后台触发 ~/.agyp/hooks/startup.d/*.sh（按文件名排序）。

    设计约束（都很关键，改这里前先读一遍）：
    - 绝不阻塞 agyp：只 fork 不等待，父进程立刻返回去 execvpe。
    - 绝不干扰 agy：子进程必须 start_new_session=True 脱离会话。调用方随后
      os.execvpe 成 agy，留在同一会话里的子进程会被 SIGHUP 带走（表现为
      "跑一半消失" + 残留锁文件）。
    - 绝不改变 agyp 的退出码：hook 缺失/不可执行/启动失败都只记日志。
    - 职责边界：agyp 不认识任何具体项目，只按序执行钩子；"刷什么、多久刷一次"
      由 hook 脚本自己决定。
    """
    hook_dir = os.path.join(AGYP_DIR, "hooks", "startup.d")
    if not os.path.isdir(hook_dir):
        return
    try:
        names = sorted(n for n in os.listdir(hook_dir) if n.endswith(".sh"))
    except OSError:
        return
    log_dir = os.path.join(AGYP_DIR, "hooks", "logs")
    for name in names:
        path = os.path.join(hook_dir, name)
        if not (os.path.isfile(path) and os.access(path, os.X_OK)):
            continue
        try:
            os.makedirs(log_dir, exist_ok=True)
            log = open(os.path.join(log_dir, name + ".log"), "a", encoding="utf-8")
            subprocess.Popen(
                ["/bin/bash", path],
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                close_fds=True,
                cwd="/",
            )
            log.close()
        except Exception as e:
            _agyp_log(f"startup hook {name} 启动失败: {e}")


def _auto_restart_if_stale() -> bool:
    """[2026-10-26] 版本漂移自动生效。

    判据早就建好了（守护进程自报 code_mtime），缺的是「发现漂移后安全生效」这一步：
    10-23 那次埋点落地时线上仍在跑 9-28 的代码，intelligence-check 上线 11 天从未被加载。
    只在**没有活口**时动手（gateway_idle_for_restart：diag inflight == 0 + 2s 去抖），
    绝不打断在途 SSE。
    """
    st = daemon_status()
    if not st:
        return False
    ok, _basis = code_version_verdict(st)
    if ok is not False:
        return False          # 已是当前代码，或无法验证（不赌）
    ok, why = gateway_idle_for_restart()
    if not ok:
        print(f"{DIM}[agyp] 检测到网关在跑旧代码，但空闲判据不成立（{why}）"
              f"—— 本次不重启，避免打断 SSE。稍后执行：agyp daemon restart{RESET}",
              file=sys.stderr)
        return False
    print(f"{YELLOW}[agyp] 检测到常驻网关在跑旧代码，空闲中 —— 自动重启以生效当前版本{RESET}",
          file=sys.stderr)
    return restart_daemon(force=False)


def launch_agy_through_gateway(target_profile: Optional[str], extra_args: List[str]):
    # 1. 确保网关守护进程处于运行状态
    if not is_daemon_running(DEFAULT_PORT):
        print(f"{DIM}[agyp] 启动轻量反向代理网关 (127.0.0.1:{DEFAULT_PORT})...{RESET}", file=sys.stderr)
        if not start_daemon_background(DEFAULT_PORT):
            print(f"{RED}错误: 启动 agyp 本地网关失败，请检查端口 {DEFAULT_PORT} 是否被占用{RESET}", file=sys.stderr)
            sys.exit(1)
    else:
        # 1.5 [2026-10-26] 跑的是旧代码且此刻空闲 → 自动生效
        _auto_restart_if_stale()

    # 2. 调度确定运行 Profile
    if target_profile:
        if target_profile not in all_profiles():
            print(f"{RED}错误: 未知 Profile '{target_profile}'。可选: {', '.join(all_profiles())}{RESET}", file=sys.stderr)
            sys.exit(1)
        switch_active(target_profile)
        use_profile = target_profile
    else:
        # 智能自动调度最高优先级启用账号
        ranked = get_ranked_profiles()
        if not ranked:
            enabled = enabled_profiles()
            if not enabled:
                print(f"{RED}错误: 所有账号均处于暂停状态，请先执行 agyp resume all{RESET}", file=sys.stderr)
                sys.exit(1)
            use_profile = enabled[0]
            score = 0.0
        else:
            use_profile = ranked[0][0]
            score = ranked[0][1]
        switch_active(use_profile)
        print(f"{GREEN}⚡ [agyp] 自动调度最优账号: {BOLD}{use_profile}{RESET} {DIM}(健康评分: {score}分){RESET}", file=sys.stderr)

    # 3. 注入网关端点并启动真实 agy
    # 关键架构保证: HOME 保持为真实用户主目录，0 钥匙串弹窗、0 路径丢失
    env = os.environ.copy()
    env["HOME"] = os.path.expanduser("~")
    env["CLOUD_CODE_URL"] = f"http://127.0.0.1:{DEFAULT_PORT}"

    real_agy_bin = (
        os.environ.get("AGYP_REAL_AGY_BIN")
        or shutil.which("agy")
        or os.path.expanduser("~/.local/bin/agy")
    )

    try:
        os.execvpe(real_agy_bin, [real_agy_bin] + extra_args, env)
    except FileNotFoundError:
        print(f"{RED}错误: 未在系统中找到真实 agy 可执行文件{RESET}", file=sys.stderr)
        sys.exit(1)

def get_keychain_active_profile() -> Tuple[Optional[str], Optional[str]]:
    """Returns (profile_name, email) currently matching the macOS Keychain token."""
    try:
        out = subprocess.check_output(
            ["security", "find-generic-password", "-s", "gemini", "-a", "antigravity", "-w"],
            stderr=subprocess.DEVNULL
        ).decode().strip()
        if out.startswith("go-keyring-base64:"):
            payload = json.loads(base64.b64decode(out[len("go-keyring-base64:"):]))
            rt = payload.get("token", {}).get("refresh_token", "")
            cfg = load_config()
            for name, p in cfg.get("profiles", {}).items():
                if p.get("refresh_token") == rt:
                    return name, p.get("email")
    except Exception:
        pass
    return None, None

def write_keychain_token_for_profile(pname: str) -> bool:
    """Refreshes and writes profile credentials to the macOS login Keychain for direct mode."""
    cfg = load_config()
    p = cfg.get("profiles", {}).get(pname)
    if not p:
        print(f"{RED}错误: 未找到账号 '{pname}' 的配置信息{RESET}", file=sys.stderr)
        return False

    # Ensure token is refreshed if needed
    access_token = refresh_token_for_profile(pname)
    if not access_token:
        print(f"{RED}错误: 无法刷新账号 '{pname}' 的 OAuth Token{RESET}", file=sys.stderr)
        return False

    cfg = load_config()
    p = cfg.get("profiles", {}).get(pname)
    rt = p.get("refresh_token")
    expires_at = p.get("expires_at", time.time() + 3600)

    payload = {
        "token": {
            "access_token": access_token,
            "token_type": "Bearer",
            "refresh_token": rt,
            "expiry": datetime.fromtimestamp(expires_at, timezone.utc).isoformat()
        },
        "auth_method": "consumer"
    }
    payload_json = json.dumps(payload, separators=(',', ':'))
    token_str = f"go-keyring-base64:{base64.b64encode(payload_json.encode('utf-8')).decode('utf-8')}"

    try:
        res = subprocess.run(
            ["security", "add-generic-password", "-U", "-s", "gemini", "-a", "antigravity", "-w", token_str],
            capture_output=True,
            text=True
        )
        if res.returncode == 0:
            return True
        else:
            print(f"{RED}写入 Keychain 失败: {res.stderr.strip()}{RESET}", file=sys.stderr)
            return False
    except Exception as e:
        print(f"{RED}写入钥匙串调用异常: {e}{RESET}", file=sys.stderr)
        return False

def launch_agy_direct(target_profile: Optional[str], extra_args: List[str]):
    """Launch agy directly without passing through the local proxy gateway (zero TLS fingerprint drift)."""
    if target_profile:
        if target_profile not in all_profiles():
            print(f"{RED}错误: 未知 Profile '{target_profile}'。可选账号: {', '.join(all_profiles())}{RESET}", file=sys.stderr)
            sys.exit(1)
        if not write_keychain_token_for_profile(target_profile):
            sys.exit(1)
        cfg = load_config()
        email = cfg.get("profiles", {}).get(target_profile, {}).get("email", "unknown")
        print(f"{GREEN}✓ [agyp direct] 钥匙串已冷切为: {BOLD}{target_profile}{RESET} ({email})", file=sys.stderr)
    else:
        cur_name, cur_email = get_keychain_active_profile()
        if cur_name:
            print(f"{CYAN}⚡ [agyp direct] 保持当前钥匙串账号: {BOLD}{cur_name}{RESET} ({cur_email})", file=sys.stderr)
        else:
            print(f"{CYAN}⚡ [agyp direct] 未识别钥匙串归属，使用系统当前状态直连{RESET}", file=sys.stderr)

    print(f"{DIM}⚡ [agyp direct] 启动原生直连 agy (原生 Go TLS 握手，防风控模式，换号需退出重开)...{RESET}\n", file=sys.stderr)

    env = os.environ.copy()
    env["HOME"] = os.path.expanduser("~")
    env.pop("CLOUD_CODE_URL", None)

    real_agy_bin = (
        os.environ.get("AGYP_REAL_AGY_BIN")
        or shutil.which("agy")
        or os.path.expanduser("~/.local/bin/agy")
    )

    try:
        os.execvpe(real_agy_bin, [real_agy_bin] + extra_args, env)
    except FileNotFoundError:
        print(f"{RED}错误: 未在系统中找到真实 agy 可执行文件{RESET}", file=sys.stderr)
        sys.exit(1)

def _http_diag(path: str = "/_agyp/diag", timeout: float = 1.5) -> Optional[Dict[str, Any]]:
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(f"http://127.0.0.1:{DEFAULT_PORT}{path}", timeout=timeout) as resp:
            return json.loads(resp.read().decode())
    except Exception:
        return None


def _latency_tail(tail_bytes: int = 400_000) -> List[Dict[str, Any]]:
    """只读 latency.jsonl 尾部若干字节（文件已 6MB+，全量读不做）。"""
    try:
        with open(LATENCY_FILE, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            start = max(0, size - tail_bytes)
            f.seek(start)
            raw = f.read().decode("utf-8", "ignore")
    except Exception:
        return []
    lines = raw.split("\n")
    # 从文件中间开始读，第一行必然是被截断的半行，丢掉
    if start > 0 and lines:
        lines = lines[1:]
    out = []
    for ln in lines:
        ln = ln.strip()
        if not ln:
            continue
        try:
            out.append(json.loads(ln))
        except Exception:
            continue
    return out


def _window_stats(rows: List[Dict[str, Any]], sec: int) -> Dict[str, Any]:
    """最近 sec 秒的窗口聚合。"""
    now = datetime.now()
    cutoff = now - timedelta(seconds=sec)
    keep = []
    for r in rows:
        try:
            t = datetime.strptime(r.get("ts", "")[:19], "%Y-%m-%d %H:%M:%S")
        except Exception:
            continue
        if t >= cutoff:
            keep.append(r)
    n = len(keep)
    ok = sum(1 for r in keep if r.get("status") == 200)
    bad = sum(1 for r in keep if r.get("status") == 502 or r.get("err"))
    retried = sum(1 for r in keep if (r.get("retry") or 0) > 0)
    recovered = sum(1 for r in keep if (r.get("retry") or 0) > 0 and r.get("status") == 200)
    cache_hits = sum(1 for r in keep if r.get("cache") == "HIT")
    pool_hits = sum(1 for r in keep if r.get("pool") == "pool")
    pool_new = sum(1 for r in keep if r.get("pool") == "new")
    heads = sorted(r["head_ms"] for r in keep if r.get("head_ms") is not None)
    return {
        "n": n, "ok": ok, "bad": bad,
        "fail_rate": (100.0 * bad / n) if n else 0.0,
        "retried": retried, "recovered": recovered,
        "cache_hits": cache_hits, "pool_hits": pool_hits, "pool_new": pool_new,
        "head_p50": heads[len(heads) // 2] if heads else 0.0,
    }


def show_live_dashboard(seconds: int = 2, window_sec: int = 300, once: bool = False) -> None:
    """[2026-10-26] 实时看板：容灾是否真的救回了请求、连接池/缓存是否命中、谁在服务哪个会话。

    纯读 /_agyp/diag + latency.jsonl 尾部 + profiles.json，不碰转发路径。
    """
    try:
        while True:
            diag = _http_diag()
            rows = _latency_tail()
            w = _window_stats(rows, window_sec)
            cfg = load_config()
            profs = cfg.get("profiles", {})
            now = time.time()
            screen_clear = "\033[2J\033[H" if not once else ""
            out = [screen_clear]
            out.append(f"{BOLD}{CYAN}⚡ agyp 网关实时看板{RESET}  {DIM}{datetime.now().strftime('%H:%M:%S')} · 窗口 近{window_sec // 60}分钟{RESET}")

            if not diag:
                out.append(f"{RED}✗ 网关未响应 (127.0.0.1:{DEFAULT_PORT}){RESET}\n")
                print("".join(out)); return
            st = daemon_status() or {}
            code_ok, basis = code_version_verdict(st)
            code_txt = (f"{GREEN}✓ 当前代码{RESET}" if code_ok is True
                        else f"{YELLOW}⚠ 旧代码（需 daemon restart）{RESET}" if code_ok is False
                        else f"{YELLOW}? 无法验证{RESET}")
            infl = diag.get("inflight") or {}
            out.append(f"  PID {diag.get('pid')} · 代码版本 {code_txt} · 在途 {BOLD}{infl.get('now', 0)}{RESET}{DIM}(峰值 {infl.get('peak', 0)}){RESET}")
            out.append(f"  全局默认账号 {BOLD}{GREEN}{diag.get('active_profile')}{RESET}")

            out.append(f"\n{BOLD}传输容灾{RESET}")
            recovered_col = GREEN if w["recovered"] else DIM
            out.append(f"  请求 {w['n']:<5} 成功 {w['ok']:<5} 失败 {w['bad']:<5}"
                       f"({w['fail_rate']:.1f}%)  重试 {w['retried']:<4}"
                       f"{recovered_col}重试后救回 {w['recovered']}{RESET}")

            pool = diag.get("pool") or {}
            hit_rate = pool.get("hit_rate")
            out.append(f"\n{BOLD}出站连接池{RESET}")
            out.append(f"  命中 {pool.get('hit', 0)} / 新建 {pool.get('miss', 0)}"
                       f"  命中率 {BOLD}{(hit_rate * 100 if hit_rate is not None else 0):.1f}%{RESET}"
                       f"  老化重连 {pool.get('aged_out', 0)}  丢弃 {pool.get('discarded', 0)}"
                       f"  池内空闲 {sum((pool.get('idle_by_profile') or {}).values())}")
            if pool.get("idle_by_profile"):
                out.append(f"  {DIM}按账号: {pool['idle_by_profile']}{RESET}")
            out.append(f"  窗口内实际用到池连接的请求 {w['pool_hits']} / 新建 {w['pool_new']} · head_ms p50 {w['head_p50']:.0f}ms")

            cache = diag.get("cache") or {}
            saved_mb = (cache.get("bytes_saved", 0) or 0) / 1048576
            out.append(f"\n{BOLD}元数据缓存{RESET}")
            out.append(f"  命中 {cache.get('hit', 0)} / 未命中 {cache.get('miss', 0)}"
                       f" / 过期 {cache.get('expired', 0)} · 表内 {cache.get('entries', 0)} 条"
                       f" · 省下下行 {saved_mb:.1f}MB{DIM}（窗口内本地回包 {w['cache_hits']} 次）{RESET}")

            sess = diag.get("sessions") or {}
            out.append(f"\n{BOLD}会话粘性{RESET}")
            out.append(f"  已绑定会话 {sess.get('count', 0)} 个 · {sess.get('by_profile') or {}}")

            out.append(f"\n{BOLD}账号池{RESET}")
            out.append(f"  {'账号':<10}{'会员':<7}{'5h余量':>9}{'周余量':>9}{'今日Token':>13}  {'状态':<12}{'周重置':>12}")
            metrics = load_metrics()
            today = datetime.now().strftime("%Y-%m-%d")
            tp = metrics.get("by_date", {}).get(today, {}).get("profiles", {})
            for name, info in profs.items():
                q = info.get("last_quota") or {}
                g5 = q.get("gemini_5h"); gw = q.get("gemini_weekly")
                tok = tp.get(name, {}).get("total_tokens", 0)
                cool = float(info.get("cooldown_until", 0) or 0)
                if info.get("paused"):
                    state = f"{YELLOW}已暂停{RESET}"
                elif cool > now:
                    state = f"{YELLOW}cooldown {int(cool - now)}s{RESET}"
                elif name == diag.get("active_profile"):
                    state = f"{GREEN}默认{RESET}"
                else:
                    state = f"{DIM}待命{RESET}"
                bound = sum(1 for v in (sess.get("sessions") or {}).values() if v.get("profile") == name)
                if bound:
                    state += f" {DIM}+{bound}会话{RESET}"
                reset = format_countdown(q.get("reset_weekly"))
                tcol = format_tier_badge(info.get("tier"), width=7)
                f5 = progress_bar(g5) if g5 is not None else f"{DIM}n/a{RESET}"
                fw = progress_bar(gw) if gw is not None else f"{DIM}n/a{RESET}"
                out.append(f"  {name:<10}{tcol}{f5:>9}{fw:>9}{tok:>13,}  {state:<28}{reset:>12}")

            print("".join("\n".join(out) + "\n"))
            if once:
                return
            time.sleep(seconds)
    except KeyboardInterrupt:
        print(f"\n{DIM}已退出实时看板{RESET}")


def show_diag_json() -> None:
    """一次性输出网关内部状态（连接池/缓存/会话/在途），供脚本与排查使用。"""
    diag = _http_diag()
    if diag is None:
        print(f"{RED}✗ 网关未响应{RESET}", file=sys.stderr)
        sys.exit(1)
    rows = _latency_tail()
    diag["window"] = {str(s): _window_stats(rows, s) for s in (60, 300, 3600)}
    print(json.dumps(diag, ensure_ascii=False, indent=2))


def show_cache_dashboard(action: Optional[str] = None, profile: Optional[str] = None) -> None:
    if action == "clear":
        qs = urllib.parse.urlencode({"clear": "1", **({"profile": profile} if profile else {})})
        d = _http_diag(f"/_agyp/cache?{qs}")
        if d is None:
            print(f"{RED}✗ 网关未响应{RESET}")
            return
        print(f"{GREEN}✓ 已清空元数据缓存{RESET}（{d.get('cleared')} 条"
              f"{'，账号 ' + profile if profile else ''}）")
        return
    d = _http_diag("/_agyp/cache")
    if d is None:
        print(f"{RED}✗ 网关未响应{RESET}")
        return
    print(f"\n{BOLD}{CYAN}⚡ 元数据缓存{RESET}")
    for k in ("hit", "miss", "expired", "stored", "cleared", "entries"):
        print(f"  {k:<10} {d.get(k, 0)}")
    print(f"  {'bytes_saved':<10} {d.get('bytes_saved', 0) / 1048576:.1f} MB")
    print(f"  {'disable':<10} {d.get('disable')}\n")


def show_pool_dashboard(action: Optional[str] = None, profile: Optional[str] = None) -> None:
    if action == "drop":
        qs = urllib.parse.urlencode({"drop": "1", **({"profile": profile} if profile else {})})
        d = _http_diag(f"/_agyp/pool?{qs}")
        if d is None:
            print(f"{RED}✗ 网关未响应{RESET}")
            return
        print(f"{GREEN}✓ 已丢弃空闲连接{RESET}（{d.get('dropped')} 条"
              f"{'，账号 ' + profile if profile else '，全部账号'}）")
        return
    d = _http_diag("/_agyp/pool")
    if d is None:
        print(f"{RED}✗ 网关未响应{RESET}")
        return
    hr = d.get("hit_rate")
    print(f"\n{BOLD}{CYAN}⚡ 出站 TLS 连接池{RESET}")
    print(f"  命中/新建    {d.get('hit', 0)} / {d.get('miss', 0)}   命中率 {(hr * 100 if hr else 0):.1f}%")
    for k in ("returned", "aged_out", "discarded", "dropped", "overflow_closed", "dead_closed"):
        print(f"  {k:<14} {d.get(k, 0)}")
    print(f"  池内空闲      {d.get('idle_by_profile')}\n")


def show_help():
    print(f"""
{BOLD}{CYAN}agyp - Antigravity Multi-Tenant Profile Gateway & Runner{RESET}

{BOLD}一、网关热切模式 (默认推荐 · 会话中途无感热切 · 0钥匙串弹窗):{RESET}
  {GREEN}agyp{RESET}                     自动拉起网关并调度最优账号进入终端
  {GREEN}agyp work{RESET}                指定使用 work 账号通过网关启动
  {GREEN}agyp add <name>{RESET}          浏览器 OAuth 登录新增账号 (支持 --from-keychain / --refresh-token)
  {GREEN}agyp reauth <name>{RESET}       重新认证已有账号的 OAuth Token
  {GREEN}agyp rename <old> <new>{RESET}  重命名账号别名
  {GREEN}agyp remove <name>{RESET}       移除账号 (别名: rm / delete)
  {GREEN}agyp auth config{RESET}         配置 Google OAuth Client ID/Secret (写入 ~/.agyp/oauth.json)
  {GREEN}agyp switch <name>{RESET}       随时热切换活动账号 (无需重启已有终端)
  {GREEN}agyp pause <name...>{RESET}     暂停指定账号，不参与调度/容灾/后台刷新 (热生效)
  {GREEN}agyp resume <name|all>{RESET}   恢复被暂停的账号 (all 恢复全部，别名: unpause)
  {GREEN}agyp only <name>{RESET}         单账号锁定模式：只用该账号并暂停其余所有账号
  {GREEN}agyp quota{RESET}               查看全部账号的 5小时 / 每周 限额与重置倒计时 (简写: agyp q)
  {GREEN}agyp stats{RESET}               查看按天、按账号维度的 Token 消耗量与等效商业价值 (简写: agyp cost)
  {GREEN}agyp gui{RESET}                 打开现代化桌面可视化监控看板 (基于 MyGo 框架，简写: agyp app)
  {GREEN}agyp list{RESET}                查看全部账号健康评分与推荐顺位 (简写: agyp ls)
  {GREEN}agyp status{RESET}              查看网关守护进程状态与活动账号

{BOLD}二、原生直连冷切模式 (防风控 · 原生 Go TLS · 换号需退出重开):{RESET}
  {GREEN}agyp direct work{RESET}          冷切钥匙串为 work 账号，并以原生直连方式启动 agy
  {GREEN}agyp direct switch work{RESET}   仅冷切钥匙串为 work 账号，不启动 agy
  {GREEN}agyp direct whoami{RESET}        查看当前钥匙串中生效的直连账号
  {GREEN}agyp direct{RESET}               以当前钥匙串账号直连启动 agy

{BOLD}三、纯原生直连 (无包装):{RESET}
  {GREEN}agy{RESET}                       直接执行官方原生客户端 (完全零代理、零干预)

{BOLD}四、模型质量与降智检测 (参考 magpie-intelligence-check):{RESET}
  {GREEN}agyp check{RESET}               运行默认牛奶推理题 (46.24 判定)，检测当前账号模型是否降智
  {GREEN}agyp check work -t pelican -o{RESET} 检测 work 账号鹈鹕骑车 2D 动画并在浏览器自动打开
  {GREEN}agyp check -t all{RESET}          运行全项检测套件 (milk, pelican, repeat, japan)
  {GREEN}agyp check --all -t milk{RESET}   遍历全账号池进行牛奶题降智体检
  {GREEN}agyp check --list-models{RESET}   查看 Google 端当前账号支持调用的全部可用模型

{BOLD}其他命令:{RESET}
  agyp daemon status           查看网关 PID / 启动时间 / 跑的是不是当前代码
  agyp daemon restart          重启网关（校验 PID 变化 + 代码版本；有在途会话时拒绝）
  agyp daemon restart --force  跳过热保护，强制重启
  agyp daemon stop             停止后台反代网关
  agyp daemon start            启动网关
  -h, --help                   显示此帮助信息

{BOLD}五、网关内部状态 (2026-10-26 容灾/保活/缓存/会话粘性):{RESET}
  {GREEN}agyp live{RESET}                  实时看板：容灾救回率、连接池命中率、缓存命中、谁在服务哪个会话
  agyp live --once             只打一帧（适合脚本/截图）；--every 5 --window 600 可调
  {GREEN}agyp diag{RESET}                  一次性输出 JSON（含近 1/5/60 分钟窗口聚合）
  agyp cache [clear [账号]]     查看/清空静态元数据响应缓存
  agyp pool  [drop  [账号]]     查看/丢弃出站 TLS 空闲连接
  {DIM}环境变量开关: AGYP_POOL_DISABLE=1 / AGYP_CACHE_DISABLE=1 / AGYP_DROP_TELEMETRY=1{RESET}
""")

def main():
    # 0. 内部守护进程模式
    if len(sys.argv) > 1 and sys.argv[1] == "__daemon":
        port = DEFAULT_PORT
        if "--port" in sys.argv:
            idx = sys.argv.index("--port")
            if idx + 1 < len(sys.argv):
                port = int(sys.argv[idx + 1])
        run_daemon_loop(port)
        return

    # 兼容直接调用 agy-quota
    if "quota" in os.path.basename(sys.argv[0]):
        show_quota_dashboard(as_json="--json" in sys.argv)
        return

    args = sys.argv[1:]

    # 1. 无参数: 默认直接选最高评分账号，通过网关启动 agy
    #    只有"裸 agyp"会触发 startup hooks；agyp quota/stats/list/... 等子命令不走这里。
    #    hooks 是 fire-and-forget（已 setsid 脱离），不会拖慢这里的启动。
    if not args:
        _run_startup_hooks()
        launch_agy_through_gateway(None, [])
        return

    # 2. 帮助
    if args[0] in ("-h", "--help", "help"):
        show_help()
        return

    # 2.5 直连冷切模式 (agyp direct ...)
    if args[0] in ("direct", "--direct"):
        sub_args = args[1:]
        if not sub_args:
            launch_agy_direct(None, [])
            return

        cmd = sub_args[0]
        if cmd in ("status", "whoami"):
            cur_name, cur_email = get_keychain_active_profile()
            print(f"\n{BOLD}{CYAN}⚡ [agyp direct] 直连模式钥匙串状态:{RESET}")
            if cur_name:
                print(f"  - 当前生效账号:   {BOLD}{GREEN}{cur_name}{RESET} ({cur_email})")
            else:
                print(f"  - 当前生效账号:   {YELLOW}未知 / 未同步{RESET}")
            print(f"  - 可切换账号池:   {', '.join(all_profiles())}")
            print(f"  - 模式特性:       纯原生 Go TLS 直连，防封等级最高 (换号需退出终端冷切)\n")
            return

        if cmd in ("switch", "use"):
            if len(sub_args) > 1:
                pname = sub_args[1]
                if pname not in all_profiles():
                    print(f"{RED}错误: 未知 Profile '{pname}'。可选账号: {', '.join(all_profiles())}{RESET}")
                    return
                if write_keychain_token_for_profile(pname):
                    cfg = load_config()
                    email = cfg.get("profiles", {}).get(pname, {}).get("email", "unknown")
                    print(f"{GREEN}✓ [agyp direct] 钥匙串已冷切为: {BOLD}{pname}{RESET} ({email})")
                    print(f"{DIM}  后续敲 `agy` 或 `agyp direct` 将直接以此账号原生运行。{RESET}")
            else:
                print(f"{RED}用法: agyp direct switch <{'|'.join(all_profiles())}>{RESET}")
            return

        if cmd in all_profiles():
            launch_agy_direct(cmd, sub_args[1:])
            return

        # 其他透传参数直接执行直连
        launch_agy_direct(None, sub_args)
        return

    # 3. 额度监控看板 (agyp quota / agyp q)
    if args[0] in ("quota", "q"):
        show_quota_dashboard(as_json="--json" in args)
        return

    # 3.1 桌面可视化看板 (agyp gui / agyp dashboard)
    if args[0] in ("gui", "dashboard", "app"):
        app_candidates = []
        if sys.platform == "darwin":
            app_candidates = [
                "/Applications/agyp Monitor.app",
                os.path.join(AGYP_DIR, "desktop", "bin", "agyp Monitor.app"),
            ]
        app_path = next((p for p in app_candidates if os.path.isdir(p)), None)
        bin_path = os.path.join(AGYP_DIR, "desktop", "bin", "agyp-desktop")
        if not app_path and not os.path.exists(bin_path):
            print(f"{RED}✗ 桌面看板程序未找到: {bin_path}{RESET}")
            print(f"{DIM}  可从 GitHub Releases 下载 agyp Monitor.app 拖入 /Applications，或在仓库根目录执行 make app / make desktop 编译{RESET}")
            return
        if not is_daemon_running(DEFAULT_PORT):
            print(f"{DIM}[agyp] 启动网关服务 (127.0.0.1:{DEFAULT_PORT})...{RESET}")
            start_daemon_background(DEFAULT_PORT)
        print(f"{GREEN}🚀 正在启动 agyp 桌面可视化监控看板...{RESET}")
        cmd = ["open", app_path] if app_path else [bin_path]
        subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return

    # 3.5 Token 与金额统计看板 (agyp stats [1|7|15|30|all] [--json])
    if args[0] in ("stats", "cost", "usage"):
        sub = args[1:]
        days_val: Optional[int] = 1
        is_json = "--json" in sub
        clean_sub = [x for x in sub if x != "--json"]
        if clean_sub:
            if clean_sub[0] in ("-d", "--days") and len(clean_sub) > 1:
                arg_val = clean_sub[1].lower()
            else:
                arg_val = clean_sub[0].lower()

            if arg_val in ("today", "1", "1d", "day"):
                days_val = 1
            elif arg_val in ("week", "7", "7d"):
                days_val = 7
            elif arg_val in ("15", "15d"):
                days_val = 15
            elif arg_val in ("month", "30", "30d"):
                days_val = 30
            elif arg_val in ("all", "total"):
                days_val = None
            elif arg_val.isdigit():
                days_val = max(1, int(arg_val))
            else:
                print(f"{YELLOW}提示: 未知周期参数 '{arg_val}'，已默认展示今日数据。可选: 1, 7, 15, 30, all{RESET}")
        show_stats_dashboard(days=days_val, as_json=is_json)
        return

    # 3.8 模型质量与降智检测探针 (agyp check / agyp test)
    if args[0] in ("check", "test"):
        check_tool = os.path.join(AGYP_DIR, "tools", "agyp_intelligence_check.py")
        if not os.path.exists(check_tool):
            print(f"{RED}错误: 未找到检测脚本 {check_tool}{RESET}")
            return
        os.execv("/usr/bin/python3", ["/usr/bin/python3", check_tool] + args[1:])
        return

    # 4. 推荐榜单 (agyp list / agyp ls)
    if args[0] in ("list", "ls"):
        show_list()
        return

    # 5. 账号热切换 (agyp switch <name>)
    if args[0] in ("switch", "use"):
        if len(args) > 1:
            switch_active(args[1])
        else:
            print(f"{RED}用法: agyp switch <{'|'.join(all_profiles())}>{RESET}")
        return

    # 5.5 账号暂停 / 恢复 / 单账号锁定 (agyp pause / resume / only)
    if args[0] == "pause":
        pause_or_resume_profiles(args[1:], paused=True)
        return

    if args[0] in ("resume", "unpause"):
        pause_or_resume_profiles(args[1:], paused=False)
        return

    if args[0] == "only":
        if len(args) > 1:
            only_profile_cmd(args[1])
        else:
            print(f"{RED}用法: agyp only <{'|'.join(all_profiles())}>{RESET}")
        return

    # 5.6 账号增删 / 重命名 / OAuth 认证配置
    if args[0] in ("add", "login"):
        cmd_add_profile(args[1:], reauth=False)
        return

    if args[0] == "reauth":
        cmd_add_profile(args[1:], reauth=True)
        return

    if args[0] in ("remove", "rm", "delete"):
        cmd_remove_profile(args[1:])
        return

    if args[0] in ("rename", "mv"):
        cmd_rename_profile(args[1:])
        return

    if args[0] == "auth":
        cmd_auth(args[1:])
        return

    # 6. 网关状态 (agyp status)
    if args[0] == "status":
        active_p = get_active_profile_name()
        cfg = load_config()
        email = cfg.get("profiles", {}).get(active_p, {}).get("email", "unknown")
        running = is_daemon_running()
        enabled = enabled_profiles(cfg)
        paused = paused_profiles(cfg)
        print(f"\n{BOLD}{CYAN}⚡ agyp 状态信息:{RESET}")
        print(f"  - 反向代理网关:   {GREEN if running else RED}{'在线 (127.0.0.1:' + str(DEFAULT_PORT) + ')' if running else '离线'}{RESET}")
        print(f"  - 全局默认账号:   {BOLD}{GREEN}{active_p}{RESET} ({email})")
        print(f"  - 账号池状态:     启用 {len(enabled)}/{len(all_profiles())} ({', '.join(enabled) or '无'})"
              + (f"  {YELLOW}· 已暂停: {', '.join(paused)}{RESET}" if paused else ""))
        print(f"  - 凭据隔离存储:   {CONFIG_FILE}")
        if running:
            # [2026-10-26] 会话粘性下「全局默认」不等于「谁在服务」，必须一起显示
            d = _http_diag() or {}
            sess = d.get("sessions") or {}
            pool = d.get("pool") or {}
            cache = d.get("cache") or {}
            st = daemon_status() or {}
            code_ok, _basis = code_version_verdict(st)
            code_txt = {True: f"{GREEN}✓ 当前磁盘版本{RESET}",
                        False: f"{YELLOW}⚠ 旧代码 —— agyp daemon restart{RESET}",
                        None: f"{YELLOW}? 无法验证{RESET}"}[code_ok]
            print(f"  - 代码版本:     {code_txt}")
            hr = pool.get("hit_rate")
            print(f"  - 出站连接池:   命中率 {(hr * 100 if hr is not None else 0):.1f}%"
                  f"{DIM}（命中 {pool.get('hit', 0)} / 新建 {pool.get('miss', 0)}）{RESET}")
            print(f"  - 元数据缓存:   命中 {cache.get('hit', 0)} / 未命中 {cache.get('miss', 0)}"
                  f"{DIM}（省下下行 {(cache.get('bytes_saved', 0) or 0) / 1048576:.1f}MB）{RESET}")
            print(f"  - 会话绑定:     {sess.get('count', 0)} 个 {DIM}{sess.get('by_profile') or {}}{RESET}")
            w = _window_stats(_latency_tail(), 600)
            if w["n"]:
                print(f"  - 近 10 分钟:   {w['n']} 请求 · 失败 {w['bad']}"
                      f"({w['fail_rate']:.1f}%) · 重试 {w['retried']} · "
                      f"{GREEN}重试后救回 {w['recovered']}{RESET}")
            if inflight_requests() > 0:
                print(f"  - 在途请求:     {YELLOW}{d.get('inflight', {}).get('now')} 个{RESET}")
        print()
        return

    # 7. 守护进程控制 (agyp daemon ...)
    if args[0] == "daemon":
        sub = args[1] if len(args) > 1 else "status"
        if sub == "status":
            # [2026-09-23] 回答"这个常驻进程跑的是哪一版代码"——以前只能靠 ps 猜。
            st = daemon_status()
            if not st:
                print(f"{RED}✗ 网关未响应 (127.0.0.1:{DEFAULT_PORT}){RESET}")
                return
            script_mtime = os.path.getmtime(os.path.abspath(__file__))
            code_ok, basis = code_version_verdict(st)

            def _fmt(t):
                try:
                    return datetime.fromtimestamp(float(t)).strftime("%Y-%m-%d %H:%M:%S")
                except Exception:
                    return "n/a"

            print(f"{GREEN}✓ 网关在线{RESET} (127.0.0.1:{DEFAULT_PORT})")
            print(f"  PID          : {st.get('pid') or '未知'}")
            print(f"  启动时间     : {_fmt(st.get('started_at'))}")
            print(f"  活跃账号     : {st.get('active_profile')} ({st.get('email')})")
            print(f"  脚本 mtime   : {_fmt(script_mtime)}")
            if code_ok is True:
                print(f"  代码版本     : {GREEN}✓ 当前磁盘版本{RESET} {DIM}({basis}){RESET}")
            elif code_ok is False:
                print(f"  代码版本     : {YELLOW}⚠ 旧代码 —— 需 agyp daemon restart{RESET} {DIM}({basis}){RESET}")
            else:
                print(f"  代码版本     : {YELLOW}? 无法验证{RESET} {DIM}({basis}){RESET}")
            return
        if sub == "stop":
            stop_daemon()
        elif sub == "start":
            if start_daemon_background():
                print(f"{GREEN}✓ agyp 网关已成功在后台启动 (127.0.0.1:{DEFAULT_PORT}){RESET}")
            else:
                print(f"{RED}启动网关失败{RESET}")
        elif sub == "restart":
            # 拒绝/失败时返回非零，便于脚本 `agyp daemon restart && ...` 判断
            if not restart_daemon(force="--force" in args):
                sys.exit(1)
        return

    # 7.5 [2026-10-26] 实时看板 / 内部诊断 / 缓存与连接池
    if args[0] in ("live", "top"):
        sub = args[1:]
        seconds = 2
        window = 300
        once = "--once" in sub
        if "--every" in sub:
            i = sub.index("--every")
            if i + 1 < len(sub):
                try:
                    seconds = max(1, int(sub[i + 1]))
                except Exception:
                    pass
        if "--window" in sub:
            i = sub.index("--window")
            if i + 1 < len(sub):
                try:
                    window = max(60, int(sub[i + 1]))
                except Exception:
                    pass
        show_live_dashboard(seconds=seconds, window_sec=window, once=once)
        return

    if args[0] == "diag":
        show_diag_json()
        return

    if args[0] == "cache":
        sub = args[1:]
        if sub and sub[0] == "clear":
            show_cache_dashboard("clear", sub[1] if len(sub) > 1 else None)
        else:
            show_cache_dashboard()
        return

    if args[0] == "pool":
        sub = args[1:]
        if sub and sub[0] == "drop":
            show_pool_dashboard("drop", sub[1] if len(sub) > 1 else None)
        else:
            show_pool_dashboard()
        return

    # 8. 简写语法: agyp <name>（如 agyp work / agyp personal），账号名以 profiles.json 为准
    if args[0] in all_profiles() and len(args) == 1:
        launch_agy_through_gateway(args[0], [])
        return

    # 9. 参数解析 (支持 -p, -c, -- 等参数传递给 agy)
    target_profile = None
    agy_args = []
    after_ddash = False
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-p", "--profile"):
            if i + 1 < len(args):
                target_profile = args[i + 1]
                i += 2
                continue
            else:
                print(f"{RED}错误: -p/--profile 缺少参数{RESET}", file=sys.stderr)
                sys.exit(1)
        elif arg == "--":
            agy_args = args[i + 1:]
            after_ddash = True
            break
        elif arg in all_profiles() and i == 0:
            target_profile = arg
            i += 1
            continue
        else:
            agy_args = args[i:]
            break

    # [2026-10-26 R16] 兜底不得静默启动agy：未注册的子命令形态一律报错退出（exit 2）。
    # 旧行为把认不出的 args[0] 整串当作 agy 参数透传，于是 `agyp statss` 这类拼写错误会
    # 先跑一遍自动调度并 **改写线上 active_profile**，再让 agy 报 unexpected argument 退出
    # —— 一条查询命令的输入失误就能搬走在正常工作的账号绑定（§十二 陷阱 7，本轮自查踩过）。
    # 真正的 agy 参数都以 '-' 开头；要传位置参数请显式 `agyp -- <args>`。
    if agy_args and not after_ddash and not agy_args[0].startswith("-"):
        print(f"{RED}错误: 未识别的子命令或参数 '{agy_args[0]}'{RESET}", file=sys.stderr)
        print(f"  查看全部子命令: {BOLD}agyp help{RESET}", file=sys.stderr)
        print(f"  确实要把原样参数交给 agy: {BOLD}agyp -- {' '.join(agy_args)}{RESET}",
              file=sys.stderr)
        sys.exit(2)

    launch_agy_through_gateway(target_profile, agy_args)

if __name__ == "__main__":
    main()
