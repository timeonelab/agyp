#!/usr/bin/env python3
"""
agyp: Antigravity Multi-Tenant Profile Gateway & Runner (omp-style)
- 真正 OMP 架构: 本地反向代理网关 (127.0.0.1:8783) 运行时动态注入 Token
- 0 钥匙串交互: 彻底消除 macOS 钥匙串弹窗与权限争抢
- 429/403/503 智能容灾: 会话中途配额耗尽或后端无容量时毫秒级自动热切换至候补账号，免关窗口
- 全局配额监控: `agyp quota` 实时查看全部账号 5h/周 限额与倒计时
"""

import os
import sys
import time
import json
import base64
import errno
import hashlib
import re
import ssl
import signal
import socket
import threading
import urllib.request
import urllib.parse
import urllib.error
import http.server
import http.client
import subprocess
import fcntl
import tempfile
import collections
import glob
import secrets
import shutil
import webbrowser
from datetime import datetime, timezone, timedelta
from typing import Dict, Any, List, Optional, Tuple

AGYP_DIR = os.path.expanduser(os.environ.get("AGYP_HOME") or "~/.agyp")
CONFIG_FILE = os.path.join(AGYP_DIR, "profiles.json")
METRICS_FILE = os.path.join(AGYP_DIR, "metrics.json")
PID_FILE = os.path.join(AGYP_DIR, "gateway.pid")
LOG_FILE = os.path.join(AGYP_DIR, "gateway.log")
LATENCY_FILE = os.path.join(AGYP_DIR, "latency.jsonl")
DEFAULT_PORT = 8783

# OAuth Client 凭据从环境变量 (AGYP_OAUTH_CLIENT_ID / AGYP_OAUTH_CLIENT_SECRET)
# 或 ~/.agyp/oauth.json 读取；开源代码仓不硬编码任何密钥。
CLIENT_ID = ""
CLIENT_SECRET = ""


def oauth_file_path() -> str:
    return os.path.join(AGYP_DIR, "oauth.json")


def load_oauth_client() -> Tuple[str, str]:
    """按优先级加载 Google OAuth Client 凭据: 环境变量 -> 模块变量 -> oauth.json -> profiles.json。"""
    cid = (os.environ.get("AGYP_OAUTH_CLIENT_ID") or CLIENT_ID or "").strip()
    csec = (os.environ.get("AGYP_OAUTH_CLIENT_SECRET") or CLIENT_SECRET or "").strip()
    if cid and csec:
        return cid, csec

    opath = oauth_file_path()
    if os.path.exists(opath):
        try:
            with open(opath, "r", encoding="utf-8") as f:
                od = json.load(f) or {}
            ocid = str(od.get("client_id") or "").strip()
            ocsec = str(od.get("client_secret") or "").strip()
            if ocid and ocsec:
                return ocid, ocsec
        except Exception:
            pass

    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                cd = json.load(f) or {}
            od = cd.get("oauth") or {}
            ocid = str(od.get("client_id") or "").strip()
            ocsec = str(od.get("client_secret") or "").strip()
            if ocid and ocsec:
                return ocid, ocsec
        except Exception:
            pass

    return "", ""


def save_oauth_client(client_id: str, client_secret: str) -> bool:
    """将 Google OAuth Client 凭据安全写入 ~/.agyp/oauth.json (0600)。"""
    return _atomic_write_json(
        oauth_file_path(),
        {
            "client_id": client_id.strip(),
            "client_secret": client_secret.strip(),
            "updated_at": datetime.now(timezone.utc).isoformat(),
        },
        "oauth.json",
    )
UPSTREAM_BASE = "https://daily-cloudcode-pa.googleapis.com"
UPSTREAM_HOST = "daily-cloudcode-pa.googleapis.com"
UPSTREAM_PORT = int(os.environ.get("AGYP_UPSTREAM_PORT") or 443)

# [2026-09-23] 上游 socket 超时（每次 socket 操作，非总时限）。
# 45s 会在「大请求体 + 上行慢」时误报 502：实测经当前代理上行边际速率 ~45 KB/s，
# 3 MB 请求体需 ~70s ⇒ socket.timeout: The write operation timed out 抛在 ssl.sendall，
# 被通用 except 兜成 502（客户端看到 <urlopen error ...> 并重试，单步耗时从 3 分钟涨到 10+ 分钟）。
# 90s 覆盖到约 4 MB；调大只影响「失败检测更迟钝」，不影响成功路径的流式输出。
UPSTREAM_WRITE_TIMEOUT_SEC = 90

# ⚠⚠ 出站**必须**经代理 —— 这台机器没有任何直连 Google 的能力
# （实测 `nc -z 172.217.114.4/116.4/112.4 443` 全部失败，`--noproxy '*'` 的 curl 返回 000，
#   而经 127.0.0.1:7897 能拿到 Google 的 404，说明只有代理这条路走得通）。
# 旧版用 `urllib.request.urlopen`：在 macOS 上它会经 `_scproxy` 读**系统代理**
# （`scutil --proxy` → HTTPEnable=1 / HTTPSProxy=127.0.0.1 / HTTPSPort=7897），
# 所以 PROXY_ENV_KEYS 那次清污只清掉了环境变量里那份**污染源**，出网照旧成立。
# 2026-10-26 把转发层从 urlopen 换成 http.client 做连接复用时，代理能力会整个消失
# （`HTTPSConnection(host, 443)` 既不看 env 也不看系统配置）⇒ 全线卡在 SYN_SENT。
# ⇒ 换传输层必须同步把代理路径接回来，见 `_resolve_upstream_proxy()` 与 `_UpstreamConn`。
UPSTREAM_CONNECT_TIMEOUT_SEC = float(os.environ.get("AGYP_UPSTREAM_CONNECT_TIMEOUT") or 6.0)
# 显式覆盖：AGYP_UPSTREAM_PROXY=http://127.0.0.1:7897；设为 none/direct/"" 则强制直连（仅调试用）。
UPSTREAM_PROXY_DISABLE = (os.environ.get("AGYP_UPSTREAM_PROXY") or "").strip().lower() in ("none", "direct", "off")


def _resolve_upstream_proxy() -> Optional[Tuple[str, int]]:
    """解析「用哪个 HTTP 代理出网」。返回 (proxy_host, proxy_port) 或 None（直连）。

    ⚠ 必须用 `urllib.request.getproxies()`，**不能**只读 `os.environ`：
    守护进程启动时会剥掉全部代理变量（09-23 的清污逻辑），而 macOS 上 getproxies()
    还会读系统配置。只读 env 就等于宣布「本进程只能直连」，那正是 10-26 那次回归。
    优先级：AGYP_UPSTREAM_PROXY 显式覆盖 > env 代理 > 系统代理。
    """
    if UPSTREAM_PROXY_DISABLE:
        return None
    raw = (os.environ.get("AGYP_UPSTREAM_PROXY") or "").strip()
    if not raw:
        try:
            px = urllib.request.getproxies()
        except Exception:
            px = {}
        raw = px.get("https") or px.get("http") or ""
    if not raw:
        return None
    if "://" not in raw:
        raw = "http://" + raw
    if not raw.lower().startswith(("http://", "https://")):
        return None                      # socks5:// 等：http.client 的 CONNECT 走不了
    try:
        u = urllib.parse.urlsplit(raw)
        host = u.hostname
        port = u.port or (443 if u.scheme == "https" else 80)
        if not host:
            return None
        # 上游主机命中 bypass（比如测试把上游指到回环）时按直连处理
        try:
            if urllib.request.proxy_bypass(UPSTREAM_HOST):
                return None
        except Exception:
            pass
        return host, int(port)
    except Exception:
        return None


# 账号池默认为空，真实名单完全来自 profiles.json。
DEFAULT_PROFILES: List[str] = []

# [2026-09-23] 网关重启相关阈值 + 代理清污清单。
# Popen 不传 env 会整套继承调用者环境；agent 沙箱会注入 HTTP_PROXY=127.0.0.1:<dead>，
# 网关继承后会把上游请求发给那个死代理 → 上游全部 502。启动子进程前必须剥掉。
# ⚠ 这份清单与 ~/.agyp/ensure-gateway.py 的 _PROXY_KEYS 必须保持一致。
PROXY_ENV_KEYS = ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY", "FTP_PROXY",
                  "http_proxy", "https_proxy", "all_proxy", "no_proxy", "ftp_proxy")
IDLE_QUIET_SEC = 2             # diag 说没有在途之后，再静默 N 秒才动手（R19）
#   ⚠ 这里**不能**再用「最近 N 秒有没有流量」当判据。三个会话每几秒轮询一次元数据，
#   缓存命中也往 latency.jsonl 落账 ⇒ mtime 永远是新的，旧版 180s 阈值只要你在用 agy
#   就永远不满足（今天我自己撞了两次，只能 --force）。真正的判据是 diag 的
#   `inflight.now`（此刻有没有活口，包括跑了 5 分钟的 SSE）；2s 只用来吸收读 diag
#   与动手之间的抖动。这段时间里新到的请求会被拒并被 agy 重试 —— 这是可接受的代价，
#   代价换来的是「在用也能重启」。
DEFAULT_LAUNCHD_LABEL = os.environ.get("AGYP_LAUNCHD_LABEL") or "io.agyp.gateway"


def resolve_launchd_label() -> Optional[str]:
    """查找当前已加载的 LaunchAgent 标签（优先环境变量/默认标签，其次扫描 *agyp-gateway*.plist）。"""
    uid = os.getuid()
    candidates: List[str] = [DEFAULT_LAUNCHD_LABEL]
    for p in sorted(glob.glob(os.path.expanduser("~/Library/LaunchAgents/*agyp-gateway*.plist"))):
        lbl = os.path.splitext(os.path.basename(p))[0]
        if lbl and lbl not in candidates:
            candidates.append(lbl)
    for lbl in candidates:
        try:
            r = subprocess.run(["launchctl", "print", f"gui/{uid}/{lbl}"],
                               capture_output=True, text=True, timeout=5)
            if r.returncode == 0:
                return lbl
        except Exception:
            pass
    return None

# ----------------------------------------------------------------------
# [2026-10-26] 传输层容灾 / 出站连接池 / 元数据缓存 / 会话粘性 参数
#
# 决策依据 = 自己 10-23 埋点攒出的 18422 条 latency.jsonl（三天窗口）：
#   · 全局失败率 16.0%（2953/18421，10-24 当天 24.7%），生成请求 7.3%（375/5139）
#   · 失败请求的 attempt 分布 = {1: 2953} —— 一次都没有重试过
#   · 错误构成 URLError 2870 / timeout 50 / RemoteDisconnected 22 / ConnectionReset 6
#     全是传输层瞬时错误；同期 429 只有 2 条 ⇒ 原有容灾服务 0.01% 的流量
#   · 空 body 请求 head_ms p50=1488ms / p90=2542ms；手工 A/B 是 2.62s→0.27s
#     ⇒ 每请求固定建连税，三天合计 ≈7.6h 纯握手
#   · body_ms p50=0.1ms（即使 req_bytes p50=568KB）⇒ **这条推断当天是错的，已撤回**：
#     body_ms 只量到 agy→网关这段**回环收包**，量不到网关→上游的送出。10-26 实测
#     上行确实是瓶颈之一（大上下文在 ~50–140KB/s 的出口上会被发送时限掐死），
#     修法见下面 R14 与 §四 P7。10-23「该缩的是请求体」那条红线**成立**，不是被证伪。
# ----------------------------------------------------------------------

# 传输层重试：仅在「还没向客户端发出任何响应头」时重试，否则会写坏已开流的 SSE。
TRANSPORT_RETRY_LIMIT_META = 2   # 幂等元数据接口：同账号最多额外重试次数
TRANSPORT_RETRY_LIMIT_GEN = 1    # 生成接口：保守给 1 次（请求可能已到达上游并计费）
TRANSPORT_RETRY_BACKOFF_SEC = (0.3, 0.8, 1.5)

# [2026-11-22] 传输层故障（网络抖动 / 本地代理断开 / DNS 失败 / TCP RST 等）是否允许跨账号顺延。
# 默认严禁跨账号（False）：
#   1. 网络层故障是机器/代理级别的，换账号没有任何用处；
#   2. 跨账号会瞬间击穿当前账号的 Prompt Cache（服务端几十 KB 上下文缓存归零），首字延迟与 Token 消耗剧增；
#   3. 避免单次断网把全池账号轮询一遍并打乱会话粘性（Session Bind）。
# 只有明确由上游应用层返回的 HTTP 429/403/503 状态码才触发跨账号轮换。
TRANSPORT_FAILOVER_ENABLED = os.environ.get("AGYP_TRANSPORT_FAILOVER") == "1"
# 单个客户端请求在「跨账号 + 重试」上允许花的最长墙钟。上游真宕机时绝不把
# 失败拖成几分钟的挂起：超预算立即停止换账号，显式回 502 + JSON 诊断。
# 它只能约束「换账号/重试的决策」，拦不住一次正在阻塞的读。
# 幂等元数据头超时 20s，同账号最多 3 次尝试（limit=2）：
# 3×20 + backoff 0.15+0.4 = 60.55s。预算取 65s（>45s），一次超时不会把重试吃光。
# 生成与写接口的头超时仍是 90s，且请求体送出后不再重试，不用这个预算去掐它们。
TRANSPORT_BUDGET_SEC = 65.0

# [2026-11-05] 上游把账号踢出轮换的冷却时长。
# 429/403 = 配额窗口，600s（5h 桶的滑动回血比这慢，缩到更短只会反复撞 429）。
# 503 = 后端容量抖动。Google 的 "No capacity available for model X on the server"
#       是**按账号**返回的：11-04 20:26 账号 A 503 / 20:30 同一 session 同一份 711,721B
#       在账号 B 上 200（见 README 2026-11-05 条）。给 180s：足够让调度榜换人，
#       又不至于一次全局 503 把五个号一起按 10 分钟。
COOLDOWN_SEC_QUOTA = 600
COOLDOWN_SEC_CAPACITY = 180

# [2026-11-14] 单个请求跨账号容灾熔断阈值（防伪 429 钓鱼 / 毒丸特征击穿号池）。
# 正常配额轮换：当前账号 429，换到第 1 个候补账号即可恢复（failovers=1）。
# 异常毒丸/WAF：连续 2 个不同账号均返回 429/403，判定为请求体特征或上游策略级阻断，
# 立即熔断并向客户端抛出该错误，绝不继续轮询剩下的备用账号，杜绝号池连环暴露与集体瘫痪。
MAX_FAILOVER_QUOTA = 1       # 429 / 403 最多换号 1 次（单请求最多尝试 2 个账号）
MAX_FAILOVER_CAPACITY = 2    # 503 容量抖动最多换号 2 次（单请求最多尝试 3 个账号）
MAX_FAILOVER_TOTAL = 2       # 单请求跨账号容灾总上限

# 「等响应头」与「上传大请求体」必须分开设时限：http.client 一个 socket timeout
# 管住 connect+send+recv 全段，旧值 90s 是为 ~4MB 上行调大的（见上面 UPSTREAM_WRITE_TIMEOUT_SEC
# 注释），于是「上游掐而不断」这类故障也得干等 90s —— 回归测试第一次跑就撞出来了。
# 元数据成功跳 n=10874：>10s 0.147% / >15s 0.074% / >20s 0.055% / >30s 0.018% / >45s 0.009%。
# 生成有 92 条成功 head_ms≥30s 且 <90s；recordTrajectoryAnalytics 有一条 48.2s 的 200。
# ⇒ 幂等只读元数据 20s，超时后还能在预算内换连接重试
# ⇒ 生成与写接口保持 90s。压到 20s 会把本来成功的请求打成 502
UPSTREAM_HEAD_TIMEOUT_META_SEC = 20.0
UPSTREAM_HEAD_TIMEOUT_GEN_SEC = UPSTREAM_WRITE_TIMEOUT_SEC
# 生成/写入的真正闸门是 _t_sent：整段请求体已交给出站 socket。
# 置位之后超时、RST、EOF 都不再重发、不再换账号。request() 抛出之前的连接失败仍可重试。
RETRY_TIMEOUT_FOR_GENERATION = False

# ----------------------------------------------------------------------
# [2026-10-26 R14] 请求体的发送时限按「有没有进展」判，不给整段 body 一个绝对上限。
# 实测依据（回环 + 自签 TLS，Xcode Python 3.9，见 §四 P7）：`socket.settimeout(T)` 作用在
# `sendall()` 上是**整段发送的累计时限**，不是「每次 syscall 无进展 T」。对端以稳定
# 300KB/s 收取（每一秒都有进展），4MB 的 sendall 依然在正好 3.0s 抛 socket.timeout，
# 当时只过去 900KB。⇒ 旧写法 `conn.request(body=bytes)` + 90s socket 时限，在本机
# ~50–140KB/s 的出口上注定掐死 agy 的 4–6MB 大上下文：10-26 15:23–15:35 的 11 条
# streamGenerateContent 失败全是这一类（total_ms≈90002、err="timeout: The write
# operation timed out"、traceback 落在 http/client.py 的 sendall）。
# 改成按真实进展判死活（R22，见 _send_request_body 的长注释）：管道活着就一直传，
# 一个字节都进不去才 abort。
# 附带效果（对 grok 提的预算闸门的处理）：**开局即死**的失败仍是快失败（第一次 send
# 就没进展 ⇒ 45s 内报错，≪ TRANSPORT_BUDGET_SEC=65），换隧道重试与跨号容灾照常生效；
# 不必把预算放宽到 190s 去把一轮注定不成的请求拖成几分钟。
# ----------------------------------------------------------------------
UPSTREAM_SEND_STALL_SEC = float(os.environ.get("AGYP_UPSTREAM_SEND_STALL") or 45.0)
# 「一个字节都没被内核接受」的轮询粒度：只管 syscall 多久醒一次，不参与死活判定，
# 判定按上面 stall 的「进展间隔」算。2s 的代价是最坏多等 2s，换来 45s 阈值不被
# sendall 的累计语义放大成「整块送不完就判死」。
UPSTREAM_SEND_POLL_SEC = float(os.environ.get("AGYP_UPSTREAM_SEND_POLL") or 2.0)
# 每次 `send()` 最多喂一片 TLS 记录（16KB）。见 `_send_request_body` 里那段：SSLSocket
# 写不动时抛 SSLWantWriteError 且不返回已写计数，整段一喂就等于把「进展」重新变成
# 「这一整块有没有在时限内送完」。切片后每片成功都算一次真实进展。
UPSTREAM_SEND_RECORD_BYTES = 16 * 1024
# 「极慢但一直在动」也不能无限等：整段上传的绝对兜底。
UPSTREAM_SEND_TOTAL_SEC = float(os.environ.get("AGYP_UPSTREAM_SEND_TOTAL") or 420.0)
# ⚠ 45s（不是 20s）的实测依据（2026-10-26 16:22–16:35 我自己踩出来的回归，见 §四 P8）：
#   默认 20s 时，三条 agyp 会话各推 6.3MB 挤一条 ~160KB/s 的上行，某个 256KB 块被挤到
#   20s 之外是**常态**——13 次尝试 0 次送完，其中一次已经推进 124s 被切，然后 from-zero
#   重试把烧掉的带宽再烧一遍 ⇒ 活锁，表现就是「请求一直不响应」。裸 agy（Go 没有写死线）
#   磨两分钟反而能回。
#   45s = 最慢成功样本（86KB/s）下单块耗时的 15 倍余量；R22 之后它的含义变成
#   「45s 内一个字节都没被接受」，比「45s 送不完一块」弱得多，也更符合实情。
# ----------------------------------------------------------------------

# [2026-10-26 R20] 面向 agy 的那一侧也必须有 socket 时限。原来 `timeout=None`：
# 一个「发了头就不动了」的客户端（崩溃中的 agy、手滑的 curl、测试残留连接）会把
# handler 线程永久钉在 `self.rfile.read()` 上，而 `_inflight` 只在 finally 里减
# ⇒ 在途计数永久 >0 ⇒ 新的重启闸被一个早死的连接永远挡住，线程也一直不回收。
# 120s：回环上读一段 body / 写一块 SSE 都是毫秒级，卡住 120s 的对端不是慢，是没了。
# 注意这是**单次 socket 操作**的时限，不是整条请求的上限 —— 一条跑 10 分钟的 SSE，
# 只要每 120s 内有数据可写，就不受影响。
CLIENT_SOCKET_TIMEOUT_SEC = float(os.environ.get("AGYP_CLIENT_TIMEOUT") or 120.0)
# 已经送出多少比例的请求体之后，就不再整段重发（也不换账号重发）。
# 非幂等请求重发的代价是「把同一根管道的带宽再烧一遍」，而管道正是它当初没送完的原因；
# 只有几乎没送出（隧道开局就死）时，换一条新隧道才是净收益。
SEND_RETRY_MAX_PROGRESS = 0.25

# 只有这些路径可以短头超时 + 失败重发。写接口不在此列。
IDEMPOTENT_META_PATHS = frozenset({
    "/v1internal:listExperiments",
    "/v1internal:fetchAvailableModels",
    "/v1internal:loadCodeAssist",
    "/v1internal:fetchUserInfo",
    "/v1internal:fetchAdminControls",
    "/v1internal:retrieveUserQuotaSummary",
})

# 出站连接池。key=profile：一条 TLS 会话只承载一个账号身份（与 §九 风控取向一致）。
UPSTREAM_POOL_MAX_PER_KEY = 2
UPSTREAM_CONN_IDLE_SEC = 45.0    # 空闲超过即丢弃重连：Google 边缘会单方面掐 idle keep-alive
POOL_DISABLE = os.environ.get("AGYP_POOL_DISABLE") == "1"

# 静态元数据缓存 TTL（秒）。命中即本地返回，不打上游。
META_CACHE_TTL = {
    "/v1internal:listExperiments": 300,      # 三天 6460 次 / 301MB 下行
    "/v1internal:fetchAvailableModels": 300,  # 三天 1214 次 / 136MB 下行
    "/v1internal:loadCodeAssist": 30,
    # ↑ [2026-10-26 R24] 300 → 30。这条回包**不是纯静态元数据**：里面带
    #   currentProject / allowedTiers / activeTier / onboardingStatus，agy 在 onboarding
    #   和套餐变更期间就是靠轮询它感知状态变化的。缓存 5 分钟 = 状态最多滞后 5 分钟，
    #   表现成「agy 卡在旧套餐/还没开通的 project 上」。30s 仍然覆盖得住每几秒一次的
    #   热轮询（收益基本不丢），但把滞后压到用户察觉不到的量级。
    "/v1internal:fetchUserInfo": 120,
    "/v1internal:fetchAdminControls": 300,
    # 不进缓存：键只有 (path, profile)，不含请求体。
    # writeTrajectoryAcls 是写 RPC（线上 24 次里 12 次间隔 ≤600s）。
    # cascadeNuxes 语义没有证实是只读（14 次里 6 次间隔 ≤600s），一并移出。
}
META_CACHE_MAX_BYTES = 2 * 1024 * 1024
CACHE_DISABLE = os.environ.get("AGYP_CACHE_DISABLE") == "1"

# 会话粘性：自动容灾换账号时只搬走「出问题的那个会话」，不再全局改 active_profile。
# 会话键取自请求体 requestId = agent/<session-uuid>/<ts>/<uuid>/<turn>
# （实测 34 个会话跨轮稳定、turn 单调递增，可直接当键用）。
SESSION_PROFILE_TTL_SEC = 6 * 3600
SESSION_PROFILE_MAX = 512

# 可选：丢弃 agy 的轨迹遥测上传（三天 181 次 / 251MB 上行）。默认关，
# 因为「上游是否要求该写回成功」未验证过，不在生产链路上默认赌。
DROP_TELEMETRY = os.environ.get("AGYP_DROP_TELEMETRY") == "1"
TELEMETRY_PATHS = ("/v1internal:recordTrajectoryAnalytics",)

# 日志体积上限（超限轮转，保留 N 份）。gateway.log 已涨到 76MB。
LOG_MAX_BYTES = 20 * 1024 * 1024
LOG_KEEP = 3

# 由 run_daemon_loop 在启动时填入，供 /_agyp/status 自报"我加载的是哪一版代码"。
# 设计原因：判断常驻进程是否跑着旧代码，靠 `ps` 不可靠（agent 沙箱会拒 ps），
# 让守护进程自己报告启动时刻与加载时的 __file__ mtime 最直接。
_DAEMON_STARTED_AT: Optional[float] = None
_DAEMON_CODE_MTIME: Optional[float] = None


def all_profiles() -> List[str]:
    """账号池唯一真源 = profiles.json 的 profiles keys（按写入顺序）。

    不再硬编码账号名单：新增账号只需在 profiles.json 写入 `profiles.<name>`
    （email + refresh_token），即自动纳入 list / quota / stats / switch /
    简写语法 / 网关调度，无需改脚本。
    """
    try:
        names = list(load_config().get("profiles", {}).keys())
    except Exception:
        names = []
    return names or list(DEFAULT_PROFILES)


def is_profile_paused(pname: str, cfg: Optional[Dict[str, Any]] = None) -> bool:
    """该账号是否被用户显式暂停（paused=True）。"""
    if not pname:
        return False
    if cfg is None:
        cfg = load_config()
    return bool((cfg.get("profiles") or {}).get(pname, {}).get("paused", False))


def paused_profiles(cfg: Optional[Dict[str, Any]] = None) -> List[str]:
    """返回当前处于暂停状态的账号名列表。"""
    if cfg is None:
        cfg = load_config()
    profs = cfg.get("profiles") or {}
    return [p for p in profs.keys() if bool((profs.get(p) or {}).get("paused", False))]


def enabled_profiles(cfg: Optional[Dict[str, Any]] = None) -> List[str]:
    """返回当前未暂停、可参与路由与容灾的账号列表。"""
    if cfg is None:
        cfg = load_config()
    profs = cfg.get("profiles") or {}
    if not profs:
        return list(DEFAULT_PROFILES)
    return [p for p in profs.keys() if not bool((profs.get(p) or {}).get("paused", False))]


